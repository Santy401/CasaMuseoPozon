---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import SocialSidebar from "../components/SocialSidebar.astro";
import Footer from "../components/footer.astro";
import WhatsappButton from "../components/WhatsappButton.astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { 
  title, 
  description, 
  image = "https://www.casapozonmuseo.site/preview.jpg" 
} = Astro.props;

// Construimos la URL completa dinámica según la página en la que estemos
const canonicalURL = new URL(Astro.url.pathname, "https://www.casapozonmuseo.org");
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="museo el pozon, cartagena, cultura comunitaria, memoria viva, proyectos sociales, pedagogia territorial, historia del pozon, museo comunitario" />
    <meta name="author" content="Casa Museo El Pozón" />
    
    <!-- Google Search Console -->
    <meta name="google-site-verification" content="PEGAR_AQUI_EL_CODIGO_DE_GOOGLE" />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <ClientRouter />

    <!-- Datos Estructurados (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.casapozonmuseo.org/#organization",
          "name": "Casa Museo El Pozón",
          "url": "https://www.casapozonmuseo.org",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.casapozonmuseo.org/updateLogoNoBg.png"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+57-312-615-3148",
            "contactType": "customer service",
            "areaServed": "CO",
            "availableLanguage": "Spanish"
          },
          "sameAs": [
            "https://www.facebook.com/profile.php?id=61573050221655&locale=es_LA",
            "https://www.instagram.com/casapozonmuseo/",
            "https://www.youtube.com/@Casapozonmuseo",
            "https://www.tiktok.com/@casapozonmuseo"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://www.casapozonmuseo.org/#website",
          "url": "https://www.casapozonmuseo.org",
          "name": "Casa Museo El Pozón",
          "publisher": {
            "@id": "https://www.casapozonmuseo.org/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://www.casapozonmuseo.org/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Museum",
          "name": "Casa Museo El Pozón",
          "description": "Espacio de memoria viva, arqueología y pedagogía comunitaria en Cartagena.",
          "url": "https://www.casapozonmuseo.site",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Sector La Islita, Calle Las Palmas",
            "addressLocality": "Cartagena",
            "addressRegion": "Bolívar",
            "addressCountry": "CO"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": "10.405364",
            "longitude": "-75.459062"
          }
        }
      ]
    })} />
  </head>
  <body>
    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({pageLanguage: 'es', includedLanguages: 'en,es', layout: google.translate.TranslateElement.InlineLayout.SIMPLE}, 'google_translate_element');
      }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    
    <div id="google_translate_element" class="absolute top-0 right-0 z-[200] p-2 opacity-50 hover:opacity-100 transition-opacity"></div>
    <SocialSidebar />
    <Navbar />
    
    <main>
      <slot />
    </main>

    <Footer />
    <WhatsappButton />
  </body>
</html>
