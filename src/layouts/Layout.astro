---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import SocialSidebar from "../components/SocialSidebar.astro";
import Footer from "../components/footer.astro";
import WhatsappButton from "../components/WhatsappButton.astro";
import MobileDock from "../components/MobileDock.astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  bodyClass?: string;
}

const { 
  title, 
  description, 
  image = "https://www.casapozonmuseo.site/preview.jpg",
  bodyClass = "bg-museum-cream",
} = Astro.props;

// Construimos la URL completa dinámica según la página en la que estemos
const canonicalURL = new URL(Astro.url.pathname, "https://www.casapozonmuseo.org");
---
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="museo el pozon, cartagena, cultura comunitaria, memoria viva, proyectos sociales, pedagogia territorial, historia del pozon, museo comunitario" />
    <meta name="author" content="Casa Museo El Pozón" />
    
    <!-- Google Search Console -->
    <meta name="google-site-verification" content="PEGAR_AQUI_EL_CODIGO_DE_GOOGLE" />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <ClientRouter />

    <!-- Datos Estructurados (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.casapozonmuseo.org/#organization",
          "name": "Casa Museo El Pozón",
          "url": "https://www.casapozonmuseo.org",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.casapozonmuseo.org/updateLogoNoBg.png"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+57-312-615-3148",
            "contactType": "customer service",
            "areaServed": "CO",
            "availableLanguage": "Spanish"
          },
          "sameAs": [
            "https://www.facebook.com/profile.php?id=61573050221655&locale=es_LA",
            "https://www.instagram.com/casapozonmuseo/",
            "https://www.youtube.com/@Casapozonmuseo",
            "https://www.tiktok.com/@casapozonmuseo"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://www.casapozonmuseo.org/#website",
          "url": "https://www.casapozonmuseo.org",
          "name": "Casa Museo El Pozón",
          "publisher": {
            "@id": "https://www.casapozonmuseo.org/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://www.casapozonmuseo.org/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Museum",
          "name": "Casa Museo El Pozón",
          "description": "Espacio de memoria viva, arqueología y pedagogía comunitaria en Cartagena.",
          "url": "https://www.casapozonmuseo.site",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Sector La Islita, Calle Las Palmas",
            "addressLocality": "Cartagena",
            "addressRegion": "Bolívar",
            "addressCountry": "CO"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": "10.405364",
            "longitude": "-75.459062"
          }
        }
      ]
    })} />
  </head>
  <body class={`overflow-x-hidden font-sans ${bodyClass}`}>
    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({pageLanguage: 'es', includedLanguages: 'en,es', layout: google.translate.TranslateElement.InlineLayout.SIMPLE}, 'google_translate_element');
      }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    
    <div id="preloader" role="status" aria-label="Cargando Casa Museo El Pozón">
      <div class="relative z-10 flex flex-col items-center px-6 text-center">
        <img id="pl-logo" class="w-28 md:w-36 h-auto opacity-0" src="/logos/casa-museo-pozon.png" alt="" width="700" height="678" fetchpriority="high" />
        <div class="mt-10 w-44 md:w-56 h-px bg-museum-cream/15 overflow-hidden" aria-hidden="true">
          <span id="pl-bar" class="block h-full w-full bg-museum-gold origin-left scale-x-0"></span>
        </div>
        <p id="pl-caption" class="mt-6 text-[10px] font-bold tracking-[0.5em] uppercase text-museum-cream/60">Casa Museo de la Memoria del Pozón</p>
        <p class="mt-2 text-[10px] tracking-[0.3em] text-museum-gold tabular-nums"><span id="pl-count">0</span>%</p>
      </div>
    </div>
    <script is:inline>
      try {
        if (sessionStorage.getItem('pozon-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.getElementById('preloader')?.remove();
        }
      } catch (e) {}
    </script>
    <noscript><style>#preloader,#page-curtain{display:none!important}</style></noscript>
    <div id="page-curtain" aria-hidden="true" transition:persist>
      <div class="curtain-bars"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="curtain-content">
        <img id="curtain-logo" class="w-16 md:w-20 h-auto mb-6" src="/logos/casa-museo-pozon.png" alt="" width="700" height="678" />
        <span class="curtain-kicker">Casa Museo El Pozón</span>
        <span class="curtain-mask"><strong id="curtain-title" class="curtain-title">Cargando</strong></span>
        <i class="curtain-line"></i>
      </div>
    </div>
    <div id="scroll-progress" aria-hidden="true"></div>
    <SocialSidebar />
    <Navbar />
    
    <main>
      <slot />
    </main>

    <Footer />
    <WhatsappButton />
    <MobileDock />
    <script>
      import "../scripts/motion";
      import "../scripts/forms";
    </script>
  </body>
</html>
