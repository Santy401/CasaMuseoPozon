---
import { qrSvg } from "../lib/qr";
import { representante, representanteUrl } from "../data/representante";

interface Props {
  /** "sm" para el inicio (credencial compacta), "lg" para su apartado propio. */
  variant?: "sm" | "lg";
}

const { variant = "sm" } = Astro.props;

const url = representanteUrl();
const qrSize = variant === "lg" ? 200 : 128;
const qr = qrSvg(url, { size: qrSize, margin: 3 });
---

<!--
  Credencial institucional del Representante Legal.
  A diferencia de la credencial de socio (que se voltea), aquí el QR queda
  siempre visible: es la firma que respalda a la Fundación y necesita
  lectura inmediata, sin interacción.
-->
<div class="credencial group relative bg-museum-dark rounded-[2rem] overflow-hidden border border-museum-gold/25 shadow-2xl shadow-museum-dark/20 transition-all duration-700 hover:-translate-y-2 hover:border-museum-gold/50 hover:shadow-2xl hover:shadow-museum-gold/15">
  <!-- Ambiente -->
  <div class="absolute inset-0 bg-gradient-to-br from-museum-dark via-museum-dark to-museum-gold/10 pointer-events-none"></div>
  <div class="absolute -top-16 -right-16 w-56 h-56 bg-museum-gold/10 blur-3xl rounded-full pointer-events-none"></div>

  <div class:list={["relative", variant === "lg" ? "p-8 md:p-10" : "p-7 md:p-8"]}>
    <!-- Cabecera institucional -->
    <div class="flex items-center justify-between gap-4 pb-5 border-b border-museum-gold/15">
      <div class="flex items-center gap-3 min-w-0">
        <span class="w-9 h-9 rounded-lg bg-white/5 border border-museum-gold/20 flex items-center justify-center text-museum-gold flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <div class="min-w-0">
          <p class="text-[8px] font-bold text-museum-gold tracking-[0.3em] uppercase leading-tight">Fundación Casa Museo</p>
          <p class="text-[8px] font-bold text-white/45 tracking-[0.3em] uppercase leading-tight">del Pozón</p>
        </div>
      </div>
      <span class="text-[7px] font-bold uppercase tracking-[0.2em] text-museum-gold/80 bg-museum-gold/10 border border-museum-gold/20 rounded-full px-3 py-1.5 flex-shrink-0">
        {representante.estado}
      </span>
    </div>

    <!-- Cuerpo: retrato + identulación -->
    <div class="pt-6 flex items-center gap-5">
      <div class:list={["relative rounded-2xl overflow-hidden bg-museum-cream flex items-center justify-center flex-shrink-0 border border-museum-gold/20", variant === "lg" ? "w-28 h-28" : "w-20 h-20"]}>
        <img src={representante.image} alt={representante.nombre} class="w-full h-full object-cover object-left" loading="lazy" />
        <div class="absolute inset-0 ring-1 ring-inset ring-white/10"></div>
      </div>
      <div class="min-w-0">
        <p class="text-[7px] font-bold uppercase tracking-[0.3em] text-white/35 mb-2">Representante Legal</p>
        <h3 class:list={["font-display text-white leading-tight", variant === "lg" ? "text-2xl md:text-3xl" : "text-lg"]}>
          {representante.nombre}
        </h3>
        <p class="text-museum-gold/80 text-[9px] font-bold uppercase tracking-[0.15em] mt-2 leading-relaxed">
          {representante.cargo}
        </p>
      </div>
    </div>

    <!-- Pie: QR + registro -->
    <div class="mt-7 pt-6 border-t border-museum-gold/15 flex items-end gap-5">
      <a
        href={url}
        class="block p-3 bg-white rounded-xl shadow-xl shadow-black/40 transition-transform duration-500 hover:scale-[1.04] flex-shrink-0"
        aria-label={`Abrir el apartado del Representante Legal en casapozonmuseo.org`}
      >
        <div class="qr" set:html={qr}></div>
      </a>
      <div class="min-w-0 pb-1 flex-grow">
        <p class="text-[7px] font-bold uppercase tracking-[0.25em] text-white/40 mb-2">Escanea para verificar</p>
        <p class="text-[7px] font-mono text-white/30 tracking-wider break-all leading-relaxed">{url}</p>
        <p class="text-[8px] font-mono text-museum-gold/70 tracking-wider mt-3">{representante.codigo}</p>
      </div>
    </div>

    <!-- Sello inferior -->
    <div class="mt-6 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-[7px] font-bold uppercase tracking-[0.2em] text-white/35">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></span>
        <span>Representación vigente</span>
      </div>
      <span class="text-[7px] font-bold uppercase tracking-[0.2em] text-museum-gold/50 flex-shrink-0">ESAL</span>
    </div>
  </div>
</div>