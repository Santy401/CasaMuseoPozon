---
---
<footer class="py-20 px-8 md:px-16 lg:px-24 bg-white border-t border-zinc-100">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center gap-12">
            <div>
                 <img src="/Logo.webp" alt="Casa Museo Pozón" class="h-16 h-auto opacity-50 grayscale hover:grayscale-0 transition-all duration-700" />
            </div>
            
            <div class="flex flex-col items-center md:items-end gap-4">
                 <p class="text-[10px] font-bold text-museum-dark/40 uppercase tracking-[0.4em]">Fundación Casa Museo del Pozón</p>
                 <p class="text-[9px] text-museum-dark/30 font-light italic text-center md:text-right">Memoria que transforma. Comunidad que resiste. Futuro que se construye.</p>
                 
                 <div class="flex gap-8 mt-6">
                      <a href="https://www.instagram.com/casamuseopozon/" target="_blank" class="text-[10px] font-black uppercase tracking-[0.2em] text-museum-dark/60 hover:text-museum-gold transition-colors">Instagram</a>
                      <a href="https://www.facebook.com/profile.php?id=61573050221655" target="_blank" class="text-[10px] font-black uppercase tracking-[0.2em] text-museum-dark/60 hover:text-museum-gold transition-colors">Facebook</a>
                      <a href="https://www.youtube.com/@casamuseopozon" target="_blank" class="text-[10px] font-black uppercase tracking-[0.2em] text-museum-dark/60 hover:text-museum-gold transition-colors">Youtube</a>
                      <a href="/galeria" class="text-[10px] font-black uppercase tracking-[0.2em] text-museum-dark/60 hover:text-museum-gold transition-colors">Galería</a>
                 </div>
            </div>
        </div>
        
        <div class="mt-20 border-t border-zinc-100 pt-16 flex flex-col lg:flex-row gap-12 justify-between items-center bg-museum-cream/30 p-12 rounded-3xl">
            <div class="max-w-md text-center lg:text-left">
                <h3 class="text-xl font-display text-museum-dark mb-2">Boletín Informativo</h3>
                <p class="text-xs text-museum-dark/60 font-light">Suscríbete para recibir noticias, crónicas y programación de nuestros próximos eventos y actividades institucionales.</p>
            </div>
            <form class="flex w-full max-w-md gap-4">
                <input type="email" placeholder="TU CORREO ELECTRÓNICO" class="w-full bg-white border border-zinc-200 px-6 py-4 text-[10px] tracking-widest focus:border-museum-gold outline-none transition-colors uppercase font-bold rounded-full" required />
                <button type="submit" class="bg-museum-dark text-white px-8 py-4 rounded-full text-[10px] font-bold tracking-widest uppercase hover:bg-museum-gold transition-colors whitespace-nowrap">Suscribirse</button>
            </form>
        </div>
        
        <div class="mt-16 pt-10 border-t border-zinc-50 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-[8px] uppercase tracking-widest text-museum-dark/30">© 2026 Casa Museo Pozón. Todos los derechos reservados.</p>
            <div class="flex items-center gap-4">
                <a href="/politica-privacidad" class="text-[8px] uppercase tracking-widest text-museum-dark/40 hover:text-museum-gold transition-colors">Política de Privacidad</a>
                <span class="text-museum-dark/20">•</span>
                <p class="text-[8px] uppercase tracking-widest text-museum-dark/30">Cartagena de Indias - Colombia</p>
            </div>
        </div>
    </div>
</footer>
