---
import { redes } from "../data/redes";
---

<aside
    id="social-dock"
    class="fixed left-4 xl:left-6 top-1/2 -translate-y-1/2 z-[150] hidden lg:flex flex-col items-center gap-3 py-5 px-2.5 rounded-full bg-museum-dark/75 backdrop-blur-xl border border-museum-gold/30 shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6)]"
    aria-label="Redes sociales"
    transition:persist
>
    <span class="[writing-mode:vertical-rl] rotate-180 text-[10px] font-black tracking-[0.45em] uppercase text-museum-gold select-none mb-1">Síguenos</span>
    <span class="w-px h-8 bg-gradient-to-b from-museum-gold/70 to-transparent" aria-hidden="true"></span>

    {redes.map((red) => (
        <a
            href={red.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={red.name}
            class="social-dock__item group relative w-11 h-11 rounded-full flex items-center justify-center text-museum-cream/80 hover:text-museum-dark bg-museum-gold/0 hover:bg-museum-gold transition-colors duration-500"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={red.icon} />
            <span class="pointer-events-none absolute left-full ml-4 whitespace-nowrap rounded-full bg-museum-gold text-museum-dark text-[10px] font-bold tracking-[0.25em] uppercase px-4 py-2 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0 transition-all duration-300">
                {red.name}
            </span>
        </a>
    ))}

    <span class="w-px h-8 bg-gradient-to-t from-museum-gold/70 to-transparent" aria-hidden="true"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-museum-gold animate-pulse" aria-hidden="true"></span>
</aside>
