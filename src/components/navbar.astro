---
import Search from './Search.astro';

const navItems = [
    { name: "Inicio", href: "/" },
    { 
        name: "Institucional", 
        children: [
            { name: "Sala Memoria Ancestral", href: "/quienes-somos" },
            { name: "Propuesta de Valor", href: "/propuesta-valor" },
            { name: "Socios", href: "/socios" },
            { name: "Representante Legal", href: "/#representante" },
            { name: "Portafolio", href: "/#portafolio" },
            { name: "Cómo Apoyar", href: "/como-apoyar" },
        ]
    },
    { 
        name: "Experiencia", 
        children: [
            { name: "Modelo Museal", href: "/modelo-museal" },
            { name: "Nodos Museales", href: "/nodos-museales" },
            { name: "Recorrido Museal", href: "/#recorrido-museal" },
            { name: "Turismo Comunitario", href: "/turismo-comunitario" },
            { name: "Colección Arqueológica", href: "/coleccion" },
        ]
    },
    { 
        name: "Infraestructura", 
        href: "/infraestructura"
    },
    { 
        name: "Saberes", 
        children: [
            { name: "Red Académica Museológica", href: "/red-museologica" },
            { name: "Pedagogía Territorial", href: "/pedagogia-territorial" },
            { name: "Modelo A.C.O.", href: "/pedagogia-territorial#modelo-aco" },
            { name: "Cátedra de Identidad", href: "/catedra-identidad" },
            { name: "Escuela Museológica", href: "/escuela-museologica" },
        ]
    },
    { 
        name: "Comunidad", 
        children: [
            { name: "Proyectos Sociales", href: "/proyectos-sociales" },
            { name: "Eventos", href: "/eventos" },
            { name: "Noticias", href: "/noticias" },
            { name: "Galería", href: "/galeria" },
            { name: "Revista El Pozón", href: "/revista" },
        ]
    },
    { name: "Contacto", href: "/#contacto" },
];
---

<nav class="flex flex-row justify-between items-center px-6 md:px-12 py-4 md:py-6 bg-museum-cream/95 backdrop-blur-md sticky top-0 z-[100] border-b border-museum-gold/10">
    <!-- Mobile Side Drawer Trigger -->
    <button id="menu-open" class="md:hidden p-2 text-museum-dark overflow-hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
    </button>

    <div class="logo">
        <img class="w-40 md:w-56 hover:opacity-80 transition-all cursor-pointer scale-[1.3] md:scale-[1.8]" src="/logos/casa-museo-pozon.png" alt="Logo">
    </div>
    
    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center gap-10">
        {navItems.map(item => (
            <li class="relative group">
                {item.children ? (
                    <button class="flex items-center gap-1 text-[11px] font-bold tracking-[0.15em] uppercase text-museum-dark/70 group-hover:text-museum-gold transition-all cursor-pointer py-2">
                        {item.name}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                    <ul class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 min-w-[220px]">
                        <div class="bg-white shadow-xl border border-museum-gold/5 p-4 rounded-sm flex flex-col gap-3">
                            {item.children.map(child => (
                                <li class="relative">
                                    {child.children ? (
                                        <div class="group/nested">
                                            <button class="flex items-center justify-between w-full text-[10px] font-semibold tracking-wider uppercase text-museum-dark/60 hover:text-museum-gold transition-colors py-1">
                                                {child.name}
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-2 h-2 transition-transform group-hover/nested:rotate-90" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                                </svg>
                                            </button>
                                            <ul class="absolute left-full top-0 ml-2 opacity-0 invisible translate-x-2 group-hover/nested:opacity-100 group-hover/nested:visible group-hover/nested:translate-x-0 transition-all duration-300 min-w-[200px]">
                                                <div class="bg-white shadow-xl border border-museum-gold/5 p-4 rounded-sm flex flex-col gap-3">
                                                    {child.children.map(subchild => (
                                                        <li>
                                                            <a 
                                                                href={subchild.href} 
                                                                class="text-[10px] font-semibold tracking-wider uppercase text-museum-dark/60 hover:text-museum-gold transition-colors block py-1"
                                                            >
                                                                {subchild.name}
                                                            </a>
                                                        </li>
                                                    ))}
                                                </div>
                                            </ul>
                                        </div>
                                    ) : (
                                        <a 
                                            href={child.href} 
                                            class="text-[10px] font-semibold tracking-wider uppercase text-museum-dark/60 hover:text-museum-gold transition-colors block py-1"
                                        >
                                            {child.name}
                                        </a>
                                    )}
                                </li>
                            ))}
                        </div>
                    </ul>
                ) : (
                    <a 
                        href={item.href} 
                        class="text-[11px] font-bold tracking-[0.15em] uppercase text-museum-dark/70 hover:text-museum-gold transition-all py-2 border-b-2 border-transparent hover:border-museum-gold/30"
                    >
                        {item.name}
                    </a>
                )}
            </li>
        ))}
    </ul>
    
    <div class="flex items-center gap-4">
        <!-- Search Trigger Desktop -->
        <button class="search-trigger p-2 text-museum-dark/70 hover:text-museum-gold transition-colors flex items-center gap-2 group hidden md:flex" aria-label="Buscar">
            <span class="text-[10px] font-bold tracking-widest uppercase opacity-0 group-hover:opacity-100 transition-opacity">Buscar</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </button>

        <a href="/#contacto" class="bg-museum-gold text-museum-cream px-5 md:px-8 py-2 md:py-3 rounded-sm text-[10px] md:text-[11px] font-bold tracking-[0.15em] md:tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 shadow-lg shadow-museum-gold/10">
            Visítanos
        </a>
    </div>
</nav>

<Search />
<!-- Mobile Sidebar Drawer -->
<div id="mobile-menu" class="fixed inset-0 bg-museum-dark/40 backdrop-blur-sm z-[110] opacity-0 invisible transition-all duration-300 md:hidden">
    <div class="bg-museum-cream w-[80%] max-w-sm h-full shadow-2xl -translate-x-full transition-transform duration-300 flex flex-col p-8 overflow-y-auto relative z-[120]" id="mobile-drawer">
        <div class="flex justify-between items-center mb-10">
            <img class="w-40 scale-[1.3]" src="/logos/casa-museo-pozon.png" alt="Logo">
            <div class="flex items-center gap-2">
                <button class="search-trigger p-2 text-museum-dark hover:text-museum-gold transition-colors" aria-label="Buscar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </button>
                <button id="menu-close" class="p-2 text-museum-dark">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <ul class="flex flex-col gap-6">
            {navItems.map(item => (
                <li class="border-b border-museum-gold/10 pb-4">
                    {item.children ? (
                        <div class="flex flex-col gap-4">
                            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-museum-gold/60">{item.name}</span>
                            <div class="flex flex-col gap-3 pl-4">
                                {item.children.map(child => (
                                    <div class="flex flex-col gap-2">
                                        {child.children ? (
                                            <>
                                                <span class="text-xs font-semibold text-museum-dark/80">{child.name}</span>
                                                <div class="flex flex-col gap-2 pl-3">
                                                    {child.children.map(subchild => (
                                                        <a href={subchild.href} class="text-sm font-medium text-museum-dark/70 mobile-link">{subchild.name}</a>
                                                    ))}
                                                </div>
                                            </>
                                        ) : (
                                            <a href={child.href} class="text-sm font-medium text-museum-dark mobile-link">{child.name}</a>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <a href={item.href} class="text-sm font-bold tracking-[0.1em] uppercase text-museum-dark mobile-link">{item.name}</a>
                    )}
                </li>
            ))}
        </ul>

        <!-- Mobile Social Links -->
        <div class="mt-12 pt-8 border-t border-museum-gold/10">
            <span class="text-[11px] font-black tracking-[0.4em] uppercase text-museum-gold block mb-8">SÍGUENOS</span>
            <div class="flex gap-6">
                <a href="https://www.facebook.com/profile.php?id=61573050221655&locale=es_LA" target="_blank" aria-label="Facebook" class="w-12 h-12 rounded-full border border-museum-gold/20 flex items-center justify-center text-museum-dark/60 hover:text-museum-gold hover:border-museum-gold transition-all duration-300 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
                <a href="https://www.instagram.com/casapozonmuseo/" target="_blank" aria-label="Instagram" class="w-12 h-12 rounded-full border border-museum-gold/20 flex items-center justify-center text-museum-dark/60 hover:text-museum-gold hover:border-museum-gold transition-all duration-300 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </a>
                <a href="https://www.youtube.com/@Casapozonmuseo" target="_blank" aria-label="YouTube" class="w-12 h-12 rounded-full border border-museum-gold/20 flex items-center justify-center text-museum-dark/60 hover:text-museum-gold hover:border-museum-gold transition-all duration-300 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-youtube"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2C1 8.11 1 12 1 12s0 3.89.46 5.58a2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2C23 15.89 23 12 23 12s0-3.89-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
                </a>
                <a href="https://www.tiktok.com/@casapozonmuseo" target="_blank" aria-label="TikTok" class="w-12 h-12 rounded-full border border-museum-gold/20 flex items-center justify-center text-museum-dark/60 hover:text-museum-gold hover:border-museum-gold transition-all duration-300 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" /></svg>
                </a>
            </div>
        </div>

        <a href="#contacto" class="mt-auto bg-museum-gold text-museum-cream py-4 rounded-sm text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-300 text-center mobile-link">
            Visítanos
        </a>
    </div>

<script>
    function initNavbar() {
        const menuOpen = document.getElementById('menu-open');
        const menuClose = document.getElementById('menu-close');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileDrawer = document.getElementById('mobile-drawer');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        function toggleMenu(isOpen: boolean) {
            if (isOpen) {
                mobileMenu?.classList.remove('invisible', 'opacity-0');
                mobileDrawer?.classList.remove('-translate-x-full');
                document.body.style.overflow = 'hidden';
            } else {
                mobileMenu?.classList.add('invisible', 'opacity-0');
                mobileDrawer?.classList.add('-translate-x-full');
                document.body.style.overflow = '';
            }
        }

        menuOpen?.addEventListener('click', () => toggleMenu(true));
        menuClose?.addEventListener('click', () => toggleMenu(false));
        mobileMenu?.addEventListener('click', (e) => {
            if (e.target === mobileMenu) toggleMenu(false);
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => toggleMenu(false));
        });
    }

    // Inicializar en la carga inicial
    initNavbar();

    // Reinicializar después de transiciones de página ( ViewTransitions )
    document.addEventListener('astro:after-swap', initNavbar);
</script>