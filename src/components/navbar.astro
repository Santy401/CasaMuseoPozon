---
import Search from './Search.astro';
import { redes } from '../data/redes';

const navItems = [
    { name: "Inicio", href: "/" },
    { 
        name: "Institucional", 
        children: [
            { name: "Sala Memoria Ancestral", href: "/quienes-somos" },
            { name: "Propuesta de Valor", href: "/propuesta-valor" },
            { name: "Socios", href: "/socios" },
            { name: "Representante Legal", href: "/representante-legal" },
            { name: "Portafolio", href: "/#portafolio" },
            { name: "Documentos", href: "/#documentos" },
            { name: "Cómo Apoyar", href: "/como-apoyar" },
        ]
    },
    { 
        name: "Experiencia", 
        children: [
            { name: "Modelo Museal", href: "/modelo-museal" },
            { name: "Nodos Museales", href: "/nodos-museales" },
            { name: "Recorrido Museal", href: "/#recorrido-museal" },
            { name: "Turismo Comunitario", href: "/turismo-comunitario" },
            { name: "Colección Arqueológica", href: "/coleccion" },
        ]
    },
    { 
        name: "Infraestructura", 
        href: "/infraestructura",
        hideOnMobile: true,
        hideOnDesktop: true
    },
    { 
        name: "Saberes", 
        children: [
            { name: "Red Académica Museológica", href: "/red-museologica" },
            { name: "Pedagogía Territorial", href: "/pedagogia-territorial" },
            { name: "Modelo A.C.O.", href: "/pedagogia-territorial#modelo-aco" },
            { name: "Cátedra de Identidad", href: "/catedra-identidad" },
            { name: "Escuela Museológica", href: "/escuela-museologica" },
        ]
    },
    { 
        name: "Comunidad", 
        children: [
            { name: "Proyectos Sociales", href: "/proyectos-sociales" },
            { name: "Eventos", href: "/eventos" },
            { name: "Noticias", href: "/noticias" },
            { name: "Galería", href: "/galeria" },
            { name: "Revista El Pozón", href: "/revista" },
        ]
    },
    { name: "Contacto", href: "/#contacto" },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const overlay = path === '/';
const isActive = (href?: string) => !!href && href.split('#')[0].replace(/\/$/, '') === path && !href.includes('#');
const groupActive = (item: any) => item.children?.some((c: any) => isActive(c.href));
---

<nav id="site-nav" class:list={["site-nav z-[100] border-b", overlay ? "nav-overlay fixed inset-x-0 top-0 border-transparent" : "is-solid sticky top-0 bg-museum-cream/80 backdrop-blur-xl border-museum-gold/15"]} aria-label="Principal">
    <div class="flex items-center justify-between gap-6 px-5 md:px-10 lg:px-12 h-[80px] md:h-[100px]">
        <!-- Menú móvil -->
        <button id="menu-open" class="md:hidden relative w-11 h-11 -ml-2 flex items-center justify-center text-museum-dark" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
            <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>

        <a href="/" class="nav-logo flex items-center gap-3 shrink-0 group" aria-label="Casa Museo Pozón — Inicio">
            <img class="h-[3.75rem] md:h-[4.75rem] w-auto" src="/logos/casa-museo-pozon.webp" alt="" width="77" height="75">
            <span class="hidden xl:flex flex-col leading-none">
                <span class="nav-brand font-display text-xl text-museum-dark">Casa Museo</span>
                <span class="text-[10px] font-bold tracking-[0.45em] uppercase text-museum-gold mt-1">El Pozón</span>
            </span>
        </a>

        <!-- Navegación desktop -->
        <ul class="hidden md:flex items-center gap-1 lg:gap-3">
            {navItems.filter(item => !item.hideOnDesktop).map(item => (
                <li class="relative nav-item">
                    {item.children ? (
                        <>
                            <button class="nav-link flex items-center gap-1.5 px-3 py-3 text-[11px] font-bold tracking-[0.16em] uppercase text-museum-dark/75 hover:text-museum-dark" data-active={groupActive(item) ? 'true' : undefined} aria-haspopup="true" aria-expanded="false">
                                {item.name}
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 nav-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                            </button>
                            <div class="nav-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 min-w-[260px]">
                                <ul class="bg-white/95 backdrop-blur-xl rounded-2xl border border-museum-gold/15 shadow-[0_30px_60px_-25px_rgba(26,26,26,0.4)] p-3">
                                    {item.children.map(child => (
                                        <li>
                                            <a href={child.href} class="nav-sub flex items-center justify-between gap-6 rounded-xl px-4 py-3 text-[11px] font-semibold tracking-[0.12em] uppercase text-museum-dark/70" aria-current={isActive(child.href) ? 'page' : undefined}>
                                                {child.name}
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-sub-arrow"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </>
                    ) : (
                        <a href={item.href} class="nav-link block px-3 py-3 text-[11px] font-bold tracking-[0.16em] uppercase text-museum-dark/75 hover:text-museum-dark" data-active={isActive(item.href) ? 'true' : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>
                            {item.name}
                        </a>
                    )}
                </li>
            ))}
        </ul>

        <div class="flex items-center gap-2 md:gap-3">
            <button class="search-trigger hidden md:flex items-center justify-center w-11 h-11 rounded-full text-museum-dark/70 hover:text-museum-dark hover:bg-museum-gold/15 transition-colors" aria-label="Buscar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </button>
            <a href="/#contacto" class="btn-magnetic group relative overflow-hidden bg-museum-dark text-museum-cream px-5 md:px-7 py-3 rounded-full text-[10px] md:text-[11px] font-bold tracking-[0.18em] uppercase">
                <span class="relative z-10 transition-colors duration-500 group-hover:text-museum-dark">Visítanos</span>
                <span class="absolute inset-0 bg-museum-gold translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out" aria-hidden="true"></span>
            </a>
        </div>
    </div>
</nav>

<Search />

<!-- Menú móvil a pantalla completa -->
<div id="mobile-menu" class="fixed inset-0 z-[160] md:hidden invisible" aria-hidden="true" data-lenis-prevent>
    <div id="mobile-bg" class="absolute inset-0 bg-museum-dark"></div>
    <div id="mobile-panel" class="relative h-full overflow-y-auto px-7 pt-6 pb-10 flex flex-col text-museum-cream">
        <div class="flex items-center justify-between mb-10">
            <img class="h-14 w-auto" src="/logos/casa-museo-pozon.webp" alt="Casa Museo Pozón" width="58" height="56">
            <div class="flex items-center gap-1">
                <button class="search-trigger w-11 h-11 flex items-center justify-center text-museum-cream/80" aria-label="Buscar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </button>
                <button id="menu-close" class="w-11 h-11 flex items-center justify-center text-museum-cream" aria-label="Cerrar menú">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
        </div>

        <ul class="flex flex-col gap-8">
            {navItems.filter(item => !item.hideOnMobile).map(item => (
                <li class="m-item">
                    {item.children ? (
                        <>
                            <span class="block text-[10px] font-bold tracking-[0.4em] uppercase text-museum-gold mb-3">{item.name}</span>
                            <ul class="flex flex-col gap-1 border-l border-museum-gold/25 pl-5">
                                {item.children.map(child => (
                                    <li><a href={child.href} class="mobile-link block py-1.5 font-display text-[1.65rem] leading-tight text-museum-cream/90 active:text-museum-gold">{child.name}</a></li>
                                ))}
                            </ul>
                        </>
                    ) : (
                        <a href={item.href} class="mobile-link block font-display text-4xl text-museum-cream active:text-museum-gold">{item.name}</a>
                    )}
                </li>
            ))}
        </ul>

        <div class="m-item mt-12 pt-8 border-t border-museum-gold/20">
            <span class="text-[10px] font-black tracking-[0.4em] uppercase text-museum-gold block mb-5">Síguenos</span>
            <div class="flex gap-4">
                {redes.map(red => (
                    <a href={red.href} target="_blank" rel="noopener noreferrer" aria-label={red.name} class="w-12 h-12 rounded-full border border-museum-gold/30 flex items-center justify-center text-museum-cream/80 active:bg-museum-gold active:text-museum-dark transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={red.icon} />
                    </a>
                ))}
            </div>
        </div>

        <a href="/#contacto" class="m-item mobile-link mt-10 bg-museum-gold text-museum-dark py-5 rounded-full text-[11px] font-bold tracking-[0.25em] uppercase text-center">Visítanos</a>
    </div>
</div>

<script>
    import gsap from 'gsap';

    function initNavbar() {
        const menu = document.getElementById('mobile-menu');
        const bg = document.getElementById('mobile-bg');
        const panel = document.getElementById('mobile-panel');
        const openBtn = document.getElementById('menu-open');
        const closeBtn = document.getElementById('menu-close');
        if (!menu || !bg || !panel) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = menu.querySelectorAll('.m-item');
        let isOpen = false;

        function setOpen(next: boolean) {
            if (next === isOpen) return;
            isOpen = next;
            openBtn?.setAttribute('aria-expanded', String(next));
            menu!.setAttribute('aria-hidden', String(!next));
            document.documentElement.classList.toggle('menu-open', next);
            document.body.style.overflow = next ? 'hidden' : '';
            gsap.killTweensOf([bg, items]);
            if (next) {
                menu!.classList.remove('invisible');
                if (reduce) return;
                gsap.fromTo(bg, { clipPath: 'circle(0% at 8% 4%)' }, { clipPath: 'circle(150% at 8% 4%)', duration: 0.9, ease: 'power3.inOut' });
                gsap.fromTo(items, { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out', stagger: 0.06, delay: 0.3 });
            } else if (reduce) {
                menu!.classList.add('invisible');
            } else {
                gsap.to(items, { opacity: 0, y: -16, duration: 0.25, stagger: 0.02 });
                gsap.to(bg, { clipPath: 'circle(0% at 8% 4%)', duration: 0.6, ease: 'power3.inOut', delay: 0.1, onComplete: () => menu!.classList.add('invisible') });
            }
        }

        openBtn?.addEventListener('click', () => setOpen(true));
        closeBtn?.addEventListener('click', () => setOpen(false));
        menu.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', () => setOpen(false)));
        menu.querySelectorAll('.search-trigger').forEach((l) => l.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

        // Accesibilidad de los desplegables de escritorio (teclado)
        document.querySelectorAll<HTMLElement>('.nav-item').forEach((li) => {
            const btn = li.querySelector('button.nav-link');
            if (!btn) return;
            li.addEventListener('focusin', () => btn.setAttribute('aria-expanded', 'true'));
            li.addEventListener('focusout', () => btn.setAttribute('aria-expanded', 'false'));
        });
    }

    initNavbar();
    document.addEventListener('astro:after-swap', initNavbar);
</script>
