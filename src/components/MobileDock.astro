---
import { contacto } from "../data/redes";
const acciones = [
    { label: "Llamar", href: `tel:+${contacto.whatsapp}`, icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>' },
    { label: "WhatsApp", href: `https://wa.me/${contacto.whatsapp}`, external: true, icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>' },
    { label: "Mapa", href: "https://www.google.com/maps/place/FUNDACI%C3%93N+CASA+MUSEO+POZ%C3%93N/@10.4047289,-75.4588276,16.93z", external: true, icon: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>' },
    { label: "Horarios", href: "/#contacto", icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
];
---
<nav id="mobile-dock" class="mobile-dock md:hidden fixed inset-x-3 z-[140] flex items-stretch justify-between rounded-full bg-museum-dark/90 backdrop-blur-xl border border-museum-gold/25 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.6)] px-2 py-1.5" aria-label="Acciones rápidas" transition:persist>
    {acciones.map((a) => (
        <a href={a.href} target={a.external ? "_blank" : undefined} rel={a.external ? "noopener noreferrer" : undefined} class="flex-1 flex flex-col items-center justify-center gap-1 min-h-[3.25rem] rounded-full text-museum-cream/85 active:bg-museum-gold active:text-museum-dark transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={a.icon} />
            <span class="text-[10px] font-bold tracking-[0.12em] uppercase whitespace-nowrap">{a.label}</span>
        </a>
    ))}
</nav>
