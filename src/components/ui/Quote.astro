---
export interface Props { author?: string; role?: string; dark?: boolean; }
const { author, role, dark = true } = Astro.props;
---
<figure class:list={["relative max-w-5xl mx-auto text-center py-6", dark ? "text-museum-cream" : "text-museum-dark"]}>
    <span class="block font-display text-museum-gold text-7xl md:text-9xl leading-none mb-2" aria-hidden="true">“</span>
    <blockquote data-scrub-words class="font-display text-2xl md:text-5xl leading-[1.2] text-balance"><slot /></blockquote>
    {(author || role) && (
        <figcaption class="mt-10 flex flex-col items-center gap-1">
            <span class="w-12 h-px bg-museum-gold mb-3"></span>
            {author && <span class="font-bold text-[11px] tracking-[0.3em] uppercase">{author}</span>}
            {role && <span class="text-[10px] tracking-[0.25em] uppercase text-museum-gold">{role}</span>}
        </figcaption>
    )}
</figure>
