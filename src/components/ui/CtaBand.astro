---
export interface Props { tone?: "dark" | "gold"; }
const { tone = "dark" } = Astro.props;
---
<section class:list={["relative overflow-hidden py-24 md:py-36 px-6 md:px-16 lg:px-24", tone === "dark" ? "bg-museum-dark text-museum-cream" : "bg-museum-gold text-museum-dark"]}>
    <div class="absolute -right-32 top-1/2 -translate-y-1/2 w-[34rem] h-[34rem] rounded-full border border-current opacity-10" aria-hidden="true"></div>
    <div class="absolute -right-10 top-1/2 -translate-y-1/2 w-[20rem] h-[20rem] rounded-full border border-current opacity-10" aria-hidden="true"></div>
    <div class="relative max-w-5xl mx-auto text-center">
        <h2 class="font-display text-4xl md:text-7xl leading-[1.05] mb-8 text-balance"><slot name="title" /></h2>
        <p class="font-light text-base md:text-xl opacity-80 max-w-2xl mx-auto mb-12 leading-relaxed"><slot /></p>
        <div class="flex flex-wrap justify-center gap-4"><slot name="actions" /></div>
    </div>
</section>
