---
export interface Step { title: string; text: string; tag?: string; kicker?: string; }
export interface Props { steps: Step[]; image?: string; imageAlt?: string; dark?: boolean; }
const { steps, image, imageAlt = "", dark = false } = Astro.props;
---
<div class="sticky-split grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-10 lg:gap-24" data-timeline>
    <div class="lg:sticky lg:top-28 self-start">
        <slot />
        {image && (
            <div class="relative mt-10 aspect-[4/3] rounded-3xl overflow-hidden hidden lg:block shadow-[0_40px_80px_-40px_rgba(26,26,26,0.5)]">
                <img src={encodeURI(image)} alt={imageAlt} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            </div>
        )}
    </div>
    <ol class="relative ml-3 md:ml-6" data-timeline-list>
        <span class="absolute left-0 top-0 bottom-0 w-px bg-museum-gold/20" aria-hidden="true"></span>
        <span data-timeline-line class="absolute left-0 top-0 bottom-0 w-px bg-museum-gold origin-top" aria-hidden="true"></span>
        <span data-timeline-head class="absolute -left-[6px] top-0 w-3 h-3 rounded-full bg-museum-gold shadow-[0_0_0_6px_rgba(196,160,82,0.25)] tl-head" aria-hidden="true"></span>
        {steps.map((st, i) => (
            <li data-timeline-item data-year={st.tag ?? String(i + 1).padStart(2, "0")} data-index={i + 1} class="timeline-item relative pl-8 md:pl-12 pb-12 md:pb-20 last:pb-0">
                <span class="timeline-dot absolute -left-[7px] top-3 w-[15px] h-[15px] rounded-full border-2 border-museum-gold transition-all duration-500" style={`background:${dark ? "#1a1a1a" : "#f5f0e8"}`} aria-hidden="true"></span>
                <div class="tl-body">
                    <span class="font-display text-museum-gold text-3xl md:text-5xl block mb-3 tabular-nums">{st.tag ?? String(i + 1).padStart(2, "0")}</span>
                    {st.kicker && <span class="block text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold mb-2">{st.kicker}</span>}
                    <h3 class="font-display text-xl md:text-3xl mb-3 leading-tight">{st.title}</h3>
                    <p class="font-light text-sm md:text-base leading-relaxed max-w-xl opacity-75">{st.text}</p>
                </div>
            </li>
        ))}
    </ol>
</div>
