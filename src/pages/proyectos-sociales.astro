---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Btn from "../components/ui/Btn.astro";

const proyectos = [
    {
        tag: "Plataforma Comunitaria de Difusión e Identidad", titulo: "Revista El Pozón: Memoria Viva",
        texto: "Un medio comunitario de comunicación cultural que fortalece la identidad, dinamiza la participación ciudadana y promueve el desarrollo económico del territorio pozonero.",
        listas: [{ t: "Impacto", items: ["Democratización de la información", "Visibilización de talentos locales", "Atractivo turístico cultural"] }],
        ods: ["ODS 4", "ODS 11", "ODS 16"], href: "/revista", cta: "Leer la Revista", tono: "bg-museum-dark text-museum-cream", oscuro: true,
    },
    {
        tag: "Cartagena Popular", titulo: "Ruta Turística Comunitaria", cita: "Destapa la historia de un barrio con ritmo y sabor sin igual.",
        texto: "Una estrategia integral de turismo social y comunitario que dignifica nuestro patrimonio biocultural y arqueológico a través de recorridos guiados por mediadores locales.",
        imagen: "/logos/modelo-turistico.jpeg", href: "/turismo-comunitario", cta: "Ver Planes y Detalles", tono: "bg-white text-museum-dark",
    },
    {
        tag: "Biblioteca Fundación Casa Museo Pozón", titulo: "Programa de Narrativas Territoriales", sub: "“EL POZÓN QUE SE CUENTA”",
        texto: "Un espacio dedicado a la recopilación, preservación y difusión de las historias que construyen la identidad de nuestro territorio, fomentando la lectura y la escritura como herramientas de transformación social.",
        listas: [{ t: "Objetivos", items: ["Rescate de la memoria oral", "Fomento a la lecto-escritura", "Archivo histórico comunitario"] }, { t: "Impacto", texto: "Fortalecimiento del tejido social a través de la palabra y el encuentro intergeneracional." }],
        tono: "bg-museum-gold text-museum-dark",
    },
    {
        tag: "Consultoría en Gestión Cultural Integral", titulo: "GCI Lab A.C.O.",
        texto: "Transferencia de conocimientos y metodología probada en territorio. Tras años de trayectoria en la gestión cultural y museológica, ponemos nuestra experiencia al servicio de instituciones, colectivos y creadores.",
        href: "/gci-lab", cta: "Ver Servicios", tono: "bg-museum-cream text-museum-dark border border-museum-gold/30",
    },
    {
        tag: "Sala del Aliento Ancestral – Santuario Sensorial", titulo: "Programa de Bienestar Territorial",
        texto: "Sanación comunitaria desde el cuerpo, la espiritualidad y la tierra viva. Un santuario sensorial guiado por mayoras y sabedoras del territorio.",
        href: "/bienestar-territorial", cta: "Ver Programa", tono: "bg-museum-dark text-museum-cream", oscuro: true,
    },
];
---

<Layout
  title="Proyectos Sociales | Casa Museo Pozón"
  description="Proyectos Sociales — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-white font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/JUEGOS GRETOS 2.webp" group="Comunidad" current="Proyectos sociales">
      <Fragment slot="eyebrow">Misión y Transformación Social</Fragment>
      Proyectos <span class="text-museum-gold italic">Sociales</span>
    </PageHero>

    <section id="proyectos" class="ui-section relative bg-museum-cream px-6 md:px-16 lg:px-24 pt-20 md:pt-32 pb-24">
        <div class="max-w-7xl mx-auto">
            <header class="mb-12 md:mb-20 max-w-3xl">
                <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Misión en acción</span>
                <h2 class="font-display text-4xl md:text-6xl leading-[1.05]">Cinco proyectos, <span class="text-museum-gold">una sola comunidad</span></h2>
            </header>

            <div data-stack class="relative">
                {proyectos.map((pr, i) => (
                    <article data-stack-card class:list={["stack-card sticky rounded-[2rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_70px_-35px_rgba(26,26,26,0.5)] mb-6 md:mb-10", pr.tono]} style={`top: calc(6rem + ${i * 1.25}rem)`}>
                        <div class="grid md:grid-cols-[1.25fr_0.75fr] min-h-[24rem] md:min-h-[30rem]">
                            <div class="p-7 md:p-14 flex flex-col">
                                <span class:list={["text-[10px] font-bold tracking-[0.3em] uppercase mb-4", pr.tono.includes("bg-museum-gold") ? "text-museum-dark/70" : "text-museum-gold"]}>{String(i + 1).padStart(2, "0")} · {pr.tag}</span>
                                <h3 class="font-display text-3xl md:text-5xl leading-tight mb-3 text-balance">{pr.titulo}</h3>
                                {pr.sub && <p class:list={["font-display text-xl md:text-2xl mb-4", pr.tono.includes("bg-museum-gold") ? "text-museum-dark" : "text-museum-gold"]}>{pr.sub}</p>}
                                {pr.cita && <p class="font-display italic text-lg md:text-xl opacity-80 mb-4">“{pr.cita}”</p>}
                                <p class="font-light leading-relaxed opacity-80 max-w-xl mb-6">{pr.texto}</p>
                                {pr.listas && (
                                    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4 mb-6">
                                        {pr.listas.map((l) => (
                                            <div>
                                                <h4 class:list={["text-[10px] font-bold tracking-[0.3em] uppercase mb-2", pr.tono.includes("bg-museum-gold") ? "text-museum-dark" : "text-museum-gold"]}>{l.t}</h4>
                                                {l.items ? <ul class="space-y-1.5 text-sm font-light opacity-85">{l.items.map((it) => <li class="flex gap-2"><span>•</span>{it}</li>)}</ul> : <p class="text-sm font-light opacity-85">{l.texto}</p>}
                                            </div>
                                        ))}
                                    </div>
                                )}
                                <div class="mt-auto pt-4 flex flex-wrap items-center gap-3">
                                    {pr.href && <Btn href={pr.href} variant={pr.oscuro ? "gold" : "dark"}>{pr.cta}</Btn>}
                                    {pr.ods && <ul class="flex flex-wrap gap-2" aria-label="ODS vinculados">{pr.ods.map((o) => <li class="text-[10px] font-bold tracking-[0.2em] rounded-full border border-current/30 px-3 py-1.5">{o}</li>)}</ul>}
                                </div>
                            </div>
                            <span class="absolute top-4 right-5 md:hidden font-display text-6xl leading-none text-transparent [-webkit-text-stroke:1.2px_currentColor] opacity-30 tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                            <div class="relative hidden md:flex items-center justify-center overflow-hidden">
                                {pr.imagen
                                    ? <img src={pr.imagen} alt={pr.titulo} loading="lazy" class="max-w-[78%] max-h-[78%] object-contain rounded-2xl" />
                                    : <span class="font-display text-[12rem] leading-none text-transparent [-webkit-text-stroke:1.5px_currentColor] opacity-25 tabular-nums">{String(i + 1).padStart(2, "0")}</span>}
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <div class="mt-14 text-center"><Btn href="/" variant="outline">Volver al Inicio</Btn></div>
        </div>
    </section>
</Layout>
