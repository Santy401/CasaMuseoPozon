---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Proyectos Sociales | Casa Museo Pozón</title>
        <ClientRouter />
	</head>
	<body class="bg-white font-sans overflow-x-hidden">
        <SocialSidebar />
		<Navbar />
        
        <main>
            <!-- Hero Header -->
            <section class="relative min-h-[60vh] flex items-center justify-center bg-museum-cream pt-20">
                <div class="relative z-20 text-center px-8" transition:animate="fade">
                    <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs mb-8 uppercase block">Misión y Transformación Social</span>
                    <h1 class="text-6xl md:text-[6rem] lg:text-[8rem] font-display text-museum-dark mb-10 leading-none">
                        Proyectos <br/> <span class="text-museum-gold italic">Sociales</span>
                    </h1>
                    <div class="w-24 h-1 bg-museum-gold mx-auto"></div>
                </div>
            </section>

            <!-- 1. Revista El Pozón: Memoria Viva -->
            <section class="py-32 px-8 md:px-16 lg:px-24">
                <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-20 items-start">
                    <div class="w-full lg:w-1/2">
                         <div class="flex items-center gap-4 mb-8">
                                <div class="w-12 h-12 bg-museum-gold/10 rounded-xl flex items-center justify-center text-museum-gold">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-newspaper"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
                              </div>
                             <h2 class="text-4xl font-display text-museum-dark">Revista El Pozón: Memoria Viva</h2>
                         </div>
                         <h3 class="text-museum-gold font-bold text-sm tracking-widest uppercase mb-8">Plataforma Comunitaria de Difusión e Identidad</h3>
                         
                         <p class="text-museum-dark/70 text-lg font-light leading-relaxed mb-10">
                            Un medio comunitario de comunicación cultural que fortalece la identidad, dinamiza la participación ciudadana y promueve el desarrollo económico del territorio pozonero.
                         </p>

                         <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                             <div class="border-l-2 border-museum-gold/20 pl-6">
                                 <h4 class="font-bold text-xs uppercase tracking-widest mb-3 opacity-60">Impacto</h4>
                                 <ul class="text-sm font-light text-museum-dark/60 space-y-2">
                                     <li>• Democratización de la información</li>
                                     <li>• Visibilización de talentos locales</li>
                                     <li>• Atractivo turístico cultural</li>
                                 </ul>
                             </div>
                             <div class="border-l-2 border-museum-gold/20 pl-6">
                                 <h4 class="font-bold text-xs uppercase tracking-widest mb-3 opacity-60">ODS Vinculados</h4>
                                 <div class="flex gap-4 opacity-40">
                                     <span class="font-bold text-[10px]">ODS 4</span>
                                     <span class="font-bold text-[10px]">ODS 11</span>
                                     <span class="font-bold text-[10px]">ODS 16</span>
                                 </div>
                             </div>
                         </div>
                    </div>
                    <div class="w-full lg:w-1/2 aspect-square bg-museum-dark rounded-[3rem] p-12 flex items-center justify-center relative overflow-hidden group">
                        <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/natural-paper.png')]"></div>
                        <div class="text-center relative z-10">
                            <span class="text-white/20 font-display text-6xl block mb-6">EDICIÓN</span>
                            <div class="w-24 h-1 bg-museum-gold mx-auto group-hover:w-full transition-all duration-700"></div>
                        </div>
                    </div>
                </div>
                 <!-- 3. Ruta Turística Comunitaria (Summary View) -->
            <section class="py-32 px-8 md:px-16 lg:px-24 bg-zinc-50 border-y border-zinc-100">
                <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                    <!-- Left: Graphic Card showing the new logo -->
                    <div class="relative order-2 lg:order-1 flex justify-center">
                         <div class="w-full max-w-[440px] aspect-[4/3] rounded-[2.5rem] overflow-hidden shadow-2xl relative group bg-white border border-museum-gold/15 p-4">
                              <img 
                                src="/ModeloTuristicoLogo.jpeg" 
                                alt="Ruta Turística Logo" 
                                class="w-full h-full object-cover rounded-[1.8rem] group-hover:scale-105 transition-transform duration-700" 
                              />
                         </div>
                    </div>
                    <!-- Right: Info -->
                    <div class="order-1 lg:order-2 space-y-6">
                        <div class="flex items-center gap-4">
                             <div class="w-12 h-12 bg-museum-gold/10 rounded-xl flex items-center justify-center text-museum-gold">
                                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l-4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
                             </div>
                             <h2 class="text-4xl font-display text-museum-dark">Ruta Turística Comunitaria</h2>
                        </div>
                        <p class="text-museum-gold font-bold tracking-widest text-[10px] uppercase">Cartagena Popular</p>
                        <p class="text-museum-dark/70 text-lg font-light leading-relaxed italic">"Destapa la historia de un barrio con ritmo y sabor sin igual."</p>
                        <p class="text-museum-dark/60 font-light leading-relaxed">
                            Una estrategia integral de turismo social y comunitario que dignifica nuestro patrimonio biocultural y arqueológico a través de recorridos guiados por mediadores locales.
                        </p>
                        <div class="pt-4">
                            <a href="/turismo-comunitario" class="inline-flex items-center gap-4 bg-museum-gold text-museum-cream px-10 py-5 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 shadow-md">
                                Ver Planes y Detalles
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. Programa de Narrativas Territoriales -->
            <section class="py-32 px-8 bg-white">
                <div class="max-w-7xl mx-auto flex flex-col lg:flex-row-reverse gap-20 items-start">
                    <div class="w-full lg:w-1/2">
                         <div class="flex items-center gap-4 mb-8">
                                <div class="w-12 h-12 bg-museum-gold/10 rounded-xl flex items-center justify-center text-museum-gold">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                              </div>
                             <h2 class="text-4xl font-display text-museum-dark uppercase">Programa de Narrativas Territoriales</h2>
                         </div>
                         <h3 class="text-museum-gold font-bold text-xl tracking-widest uppercase mb-8">“EL POZÓN QUE SE CUENTA”</h3>
                         <p class="text-xs font-bold text-museum-dark/40 uppercase tracking-[0.2em] mb-8">Biblioteca Fundación Casa Museo Pozón</p>
                         
                         <p class="text-museum-dark/70 text-lg font-light leading-relaxed mb-10">
                            Un espacio dedicado a la recopilación, preservación y difusión de las historias que construyen la identidad de nuestro territorio, fomentando la lectura y la escritura como herramientas de transformation social.
                         </p>

                         <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                             <div class="border-l-2 border-museum-gold/20 pl-6">
                                 <h4 class="font-bold text-xs uppercase tracking-widest mb-3 opacity-60">Objetivos</h4>
                                 <ul class="text-sm font-light text-museum-dark/60 space-y-2">
                                     <li>• Rescate de la memoria oral</li>
                                     <li>• Fomento a la lecto-escritura</li>
                                     <li>• Archivo histórico comunitario</li>
                                 </ul>
                             </div>
                             <div class="border-l-2 border-museum-gold/20 pl-6">
                                 <h4 class="font-bold text-xs uppercase tracking-widest mb-3 opacity-60">Impacto</h4>
                                 <p class="text-sm font-light text-museum-dark/60">
                                    Fortalecimiento del tejido social a través de la palabra y el encuentro intergeneracional.
                                 </p>
                             </div>
                         </div>
                    </div>
                    <div class="w-full lg:w-1/2 aspect-square bg-museum-cream/30 rounded-[3rem] p-12 flex items-center justify-center relative overflow-hidden group">
                         <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/natural-paper.png')] opacity-40"></div>
                         <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold/20 group-hover:scale-110 transition-transform duration-1000"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    </div>
                </div>
            </section>




            <!-- 5. GCI Lab A.C.O. + Bienestar Territorial (Summary) -->
            <section id="volver-inicio" class="py-32 px-8 bg-white">
                <div class="max-w-7xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                        <!-- GCI Lab Summary -->
                        <div class="p-12 bg-white rounded-[3rem] shadow-xl hover:-translate-y-2 transition-all duration-500 group border border-museum-gold/10">
                            <div class="w-16 h-16 bg-museum-cream rounded-2xl flex items-center justify-center text-museum-gold mb-8 group-hover:scale-110 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                            </div>
                            <h3 class="text-2xl font-display text-museum-dark mb-2">GCI Lab A.C.O.</h3>
                            <p class="text-xs font-bold uppercase tracking-widest text-museum-gold mb-6">Consultoría en Gestión Cultural Integral</p>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-8">
                                Transferencia de conocimientos y metodología probada en territorio. Tras años de trayectoria en la gestión cultural y museológica, ponemos nuestra experiencia al servicio de instituciones, colectivos y creadores.
                            </p>
                            <a href="#gci-lab-full" class="inline-flex items-center gap-3 bg-museum-gold text-museum-cream px-8 py-4 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 shadow-md">
                                Ver Servicios
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>

                        <!-- Bienestar Territorial Summary -->
                        <div class="p-12 bg-white rounded-[3rem] shadow-xl hover:-translate-y-2 transition-all duration-500 group border border-museum-gold/10">
                            <div class="w-16 h-16 bg-museum-cream rounded-2xl flex items-center justify-center text-museum-gold mb-8 group-hover:scale-110 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="m12 3 1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                            </div>
                            <h3 class="text-2xl font-display text-museum-dark mb-2">Programa de Bienestar Territorial</h3>
                            <p class="text-xs font-bold uppercase tracking-widest text-museum-gold mb-6">Sala del Aliento Ancestral – Santuario Sensorial</p>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-8">
                                Sanación comunitaria desde el cuerpo, la espiritualidad y la tierra viva. Un santuario sensorial guiado por mayoras y sabedoras del territorio.
                            </p>
                            <a href="#bienestar-full" class="inline-flex items-center gap-3 bg-museum-gold text-museum-cream px-8 py-4 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 shadow-md">
                                Ver Programa
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 6. GCI Lab A.C.O. — Full Section -->
            <section id="gci-lab-full" class="py-32 px-8 bg-museum-cream/30">
                <div class="max-w-7xl mx-auto">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 bg-museum-gold/10 rounded-xl flex items-center justify-center text-museum-gold">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                        </div>
                        <h2 class="text-4xl font-display text-museum-dark">GCI Lab A.C.O.</h2>
                    </div>
                    <h3 class="text-museum-gold font-bold text-sm tracking-widest uppercase mb-8">Consultoría en Gestión Cultural Integral</h3>
                    <p class="text-museum-dark/70 text-lg font-light leading-relaxed mb-10">
                        Transferencia de conocimientos y metodología probada en territorio. Tras años de trayectoria en la gestión cultural y museológica, ponemos nuestra experiencia al servicio de instituciones, colectivos y creadores que buscan transformar sus entornos a través del patrimonio, la educación y la tecnología.
                    </p>
                    <div class="bg-white p-8 rounded-[2rem] mb-12 shadow-sm">
                        <p class="text-sm font-light text-museum-dark/70 leading-relaxed">
                            <span class="font-bold text-museum-gold">Metodología de transparencia:</span> Nuestra consultoría no entrega documentos estáticos, utilizamos el <span class="font-semibold">Modelo de Aprendizaje Comunitario Orgánico A.C.O.</span> para asegurar que cada proyecto, estatuto o plan de marketing esté enraizado en la identidad y el contexto específico de quien lo solicita.
                        </p>
                    </div>
                    <h4 class="text-xl font-display text-museum-dark mb-8 tracking-wide">PORTAFOLIO DE SOLUCIONES</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                        <div class="p-8 bg-white border border-museum-gold/10 rounded-[2rem] shadow-md">
                            <h5 class="font-bold text-museum-dark mb-3">1. Gestión y Formulación de Proyectos</h5>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-4">Ayudamos a organizaciones, colectivos y artistas a transformar ideas en proyectos viables y susceptibles de financiación.</p>
                            <ul class="text-xs font-light text-museum-dark/60 space-y-1.5">
                                <li>• Diagnóstico Territorial</li>
                                <li>• Formulación Técnica (marco lógico)</li>
                                <li>• Gestión de Recursos y convocatorias</li>
                                <li>• Acompañamiento en SIMCO</li>
                            </ul>
                        </div>
                        <div class="p-8 bg-white border border-museum-gold/10 rounded-[2rem] shadow-md">
                            <h5 class="font-bold text-museum-dark mb-3">2. Estructuración Legal y Administrativa</h5>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-4">La base de la sostenibilidad institucional es una gobernanza clara.</p>
                            <ul class="text-xs font-light text-museum-dark/60 space-y-1.5">
                                <li>• Redacción de Estatutos</li>
                                <li>• Reglamentos Internos</li>
                                <li>• Asesoría Legal para ESAL</li>
                                <li>• Trámites Cámara de Comercio y DIAN</li>
                            </ul>
                        </div>
                        <div class="p-8 bg-white border border-museum-gold/10 rounded-[2rem] shadow-md">
                            <h5 class="font-bold text-museum-dark mb-3">3. Marketing Digital y Redes Sociales</h5>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-4">Estrategias culturales con identidad y narrativas de resistencia.</p>
                            <ul class="text-xs font-light text-museum-dark/60 space-y-1.5">
                                <li>• Identidad Digital y Rebranding</li>
                                <li>• Gestión de Comunidades</li>
                                <li>• Publicidad Segmentada</li>
                                <li>• Content Marketing</li>
                            </ul>
                        </div>
                        <div class="p-8 bg-white border border-museum-gold/10 rounded-[2rem] shadow-md">
                            <h5 class="font-bold text-museum-dark mb-3">4. Soluciones Tecnológicas y Programación</h5>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-4">Apoyo técnico para procesos culturales con herramientas digitales.</p>
                            <ul class="text-xs font-light text-museum-dark/60 space-y-1.5">
                                <li>• Desarrollo Web autogestionable</li>
                                <li>• Automatización (Google Workspace, CRM)</li>
                                <li>• Digitalización de Colecciones</li>
                                <li>• Catálogos digitales patrimoniales</li>
                            </ul>
                        </div>
                    </div>
                    <div class="border-l-4 border-museum-gold pl-6 mb-10">
                        <p class="text-sm font-bold text-museum-dark uppercase tracking-widest mb-2">Diferencial Competitivo</p>
                        <p class="text-sm font-light text-museum-dark/60 leading-relaxed">
                            Lo que distingue este servicio es la integración del <span class="font-semibold">Modelo A.C.O.</span> — consultoría situada, no aplicamos fórmulas genéricas. Cada proyecto se diseña a partir de la identidad y el contexto del cliente, con un enfoque de resiliencia y sostenibilidad a largo plazo.
                        </p>
                    </div>
                    <div class="flex justify-center gap-6">
                        <a href="#volver-inicio" class="inline-flex items-center gap-3 border border-museum-gold text-museum-gold px-8 py-4 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-gold hover:text-museum-cream transition-all duration-500">
                            Volver a Resumen
                        </a>
                        <a href="/contacto" class="inline-flex items-center gap-3 bg-museum-gold text-museum-cream px-8 py-4 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 shadow-md">
                            Solicita un Diagnóstico Inicial
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                    </div>
                </div>
            </section>

            <!-- 7. Programa de Bienestar Territorial — Full Section -->
            <section id="bienestar-full" class="py-32 px-8 bg-white">
                <div class="max-w-7xl mx-auto">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 bg-museum-gold/10 rounded-xl flex items-center justify-center text-museum-gold">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="m12 3 1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                        </div>
                        <h2 class="text-4xl font-display text-museum-dark">Programa de Bienestar Territorial y Sanación Comunitaria</h2>
                    </div>
                    <h3 class="text-museum-gold font-bold text-sm tracking-widest uppercase mb-8">Sala del Aliento Ancestral – Santuario Sensorial</h3>
                    <p class="text-museum-dark/70 text-lg font-light leading-relaxed mb-10">
                        Sanación comunitaria desde el cuerpo, la espiritualidad y la tierra viva.
                    </p>
                    <p class="text-museum-dark/60 font-light leading-relaxed mb-12">
                        La Sala del Aliento Ancestral es un santuario sensorial donde el cuerpo, la memoria y el territorio se encuentran para activar procesos de sanación comunitaria, bienestar emocional y continuidad espiritual. Es un espacio íntimo guiado por mayoras, sabedoras y cuidadoras del territorio, donde el santiguado, los aromas medicinales y los rituales de bienestar se entrelazan con la fuerza viva de la Huerta de la Memoria. Aquí, la espiritualidad no es un adorno: es una práctica cotidiana que sostiene la vida.
                    </p>

