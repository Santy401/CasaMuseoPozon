---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Modelo Museal Turístico Territorial | Casa Museo Pozón</title>
        <ClientRouter />
	</head>
	<body class="bg-white font-sans overflow-x-hidden">
        <SocialSidebar />
		<Navbar />
        
        <main>
            <!-- Hero Header -->
            <section class="relative min-h-[80vh] flex items-center justify-center bg-museum-dark pt-20 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-museum-dark/60 via-museum-dark to-museum-dark z-10"></div>
                <!-- Background image with heavy overlay -->
                <div class="absolute inset-0 opacity-20 bg-[url('/Secsion1.png')] bg-cover bg-center mix-blend-luminosity"></div>
                
                <div class="relative z-20 text-center px-8 max-w-5xl" transition:animate="fade">
                    <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs mb-8 uppercase block">Cartagena Popular: El Pozón como Museo Vivo</span>
                    <h1 class="text-5xl md:text-7xl lg:text-8xl font-display text-white mb-10 leading-tight">
                        Modelo Museal <br/> <span class="text-museum-gold">Turístico Territorial</span>
                    </h1>
                    <div class="w-24 h-1 bg-museum-gold mx-auto mb-10"></div>
                    <p class="max-w-3xl mx-auto text-museum-cream/70 text-lg md:text-xl font-light leading-relaxed">
                        Una estrategia integral de innovación social, cultural y educativa que posiciona al barrio El Pozón como un ecosistema de memoria viva.
                    </p>
                </div>

                <!-- Scroll indicator decorative -->
                <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 text-white/30 animate-bounce">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
                </div>
            </section>

            <!-- Enfoque Estratégico (Componentes) -->
            <section class="py-32 px-8 md:px-16 lg:px-24 bg-white relative">
                <div class="max-w-7xl mx-auto">
                    <div class="text-center mb-24">
                        <h2 class="text-3xl md:text-5xl font-display text-museum-dark mb-6">Enfoque Estratégico</h2>
                        <p class="text-museum-dark/60 max-w-2xl mx-auto font-light leading-relaxed">
                            El modelo se fundamenta en cinco componentes que operan de manera articulada para fortalecer capacidades locales.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                        <!-- 1. Memoria Viva -->
                        <div class="group border-b border-zinc-100 pb-12 transition-all">
                             <span class="text-museum-gold font-display text-6xl opacity-10 mb-6 block group-hover:opacity-100 transition-opacity">01</span>
                             <h3 class="text-2xl font-display text-museum-dark mb-4">Memoria Viva</h3>
                             <p class="text-museum-dark/60 font-light leading-relaxed">
                                Sistematización de relatos, archivos comunitarios, cartografías simbólicas y dispositivos de resignificación territorial.
                             </p>
                        </div>
                        <!-- 2. Educación Territorial -->
                        <div class="group border-b border-zinc-100 pb-12 transition-all">
                             <span class="text-museum-gold font-display text-6xl opacity-10 mb-6 block group-hover:opacity-100 transition-opacity">02</span>
                             <h3 class="text-2xl font-display text-museum-dark mb-4">Educación Territorial</h3>
                             <p class="text-museum-dark/60 font-light leading-relaxed">
                                Cátedra de Identidad Barrial, metodologías sentipensantes, aulas vivas y formación de facilitadores comunitarios.
                             </p>
                        </div>
                        <!-- 3. Turismo Cultural Popular -->
                        <div class="group border-b border-zinc-100 pb-12 transition-all">
                             <span class="text-museum-gold font-display text-6xl opacity-10 mb-6 block group-hover:opacity-100 transition-opacity">03</span>
                             <h3 class="text-2xl font-display text-museum-dark mb-4">Turismo Cultural</h3>
                             <p class="text-museum-dark/60 font-light leading-relaxed">
                                Rutas simbólicas, mediadores turísticos comunitarios y experiencias inmersivas con enfoque ético y de dignidad.
                             </p>
                        </div>
                        <!-- 4. Economía Solidaria -->
                        <div class="group border-b border-zinc-100 pb-12 transition-all">
                             <span class="text-museum-gold font-display text-6xl opacity-10 mb-6 block group-hover:opacity-100 transition-opacity">04</span>
                             <h3 class="text-2xl font-display text-museum-dark mb-4">Economía Solidaria</h3>
                             <p class="text-museum-dark/60 font-light leading-relaxed">
                                Emprendimientos creativos, productos identitarios y circuitos de comercialización cultural para el barrio.
                             </p>
                        </div>
                        <!-- 5. Articulación Institucional -->
                        <div class="group border-b border-zinc-100 pb-12 transition-all">
                             <span class="text-museum-gold font-display text-6xl opacity-10 mb-6 block group-hover:opacity-100 transition-opacity">05</span>
                             <h3 class="text-2xl font-display text-museum-dark mb-4">Articulación</h3>
                             <p class="text-museum-dark/60 font-light leading-relaxed">
                                Alianzas intersectoriales, incidencia en políticas públicas y alineación con marcos legales y agendas de cooperación.
                             </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Programa Operativo -->
            <section class="py-32 bg-museum-cream px-8 md:px-16 lg:px-24 relative overflow-hidden">
                <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                    <div>
                        <span class="text-museum-gold font-bold tracking-widest text-[10px] uppercase mb-4 block">Programa Operativo</span>
                        <h2 class="text-3xl md:text-5xl font-display text-museum-dark mb-8">Activación del Museo Vivo</h2>
                        <ul class="space-y-6">
                            <li class="flex gap-6 items-start">
                                <div class="w-10 h-10 rounded-lg bg-museum-gold/10 flex items-center justify-center flex-shrink-0 text-museum-gold">1</div>
                                <p class="text-museum-dark/70 font-light">Diseño y ejecución de recorridos museales barriales.</p>
                            </li>
                            <li class="flex gap-6 items-start">
                                <div class="w-10 h-10 rounded-lg bg-museum-gold/10 flex items-center justify-center flex-shrink-0 text-museum-gold">2</div>
                                <p class="text-museum-dark/70 font-light">Producción de contenidos digitales y narrativas comunitarias.</p>
                            </li>
                            <li class="flex gap-6 items-start">
                                <div class="w-10 h-10 rounded-lg bg-museum-gold/10 flex items-center justify-center flex-shrink-0 text-museum-gold">3</div>
                                <p class="text-museum-dark/70 font-light">Formación de líderes como mediadores culturales y turísticos.</p>
                            </li>
                            <li class="flex gap-6 items-start">
                                <div class="w-10 h-10 rounded-lg bg-museum-gold/10 flex items-center justify-center flex-shrink-0 text-museum-gold">4</div>
                                <p class="text-museum-dark/70 font-light">Activación de espacios públicos como aulas vivas.</p>
                            </li>
                            <li class="flex gap-6 items-start">
                                <div class="w-10 h-10 rounded-lg bg-museum-gold/10 flex items-center justify-center flex-shrink-0 text-museum-gold">5</div>
                                <p class="text-museum-dark/70 font-light">Gestión de alianzas, convocatorias y cooperación técnica.</p>
                            </li>
                        </ul>
                    </div>
                    <div class="aspect-square bg-museum-dark rounded-[3rem] p-12 flex flex-col justify-center relative overflow-hidden group shadow-2xl">
                         <div class="absolute inset-0 opacity-20 bg-[url('/Secsion1.png')] bg-cover bg-center transition-transform duration-1000 group-hover:scale-110"></div>
                         <div class="relative z-10">
                            <h3 class="text-white text-3xl font-display mb-6">Laboratorio de Innovación Cultural</h3>
                            <p class="text-white/60 font-light leading-relaxed mb-8">Convertimos el territorio en un espacio dinámico de aprendizaje y resignificación simbólica.</p>
                            <div class="h-1 w-20 bg-museum-gold group-hover:w-full transition-all duration-700"></div>
                         </div>
                    </div>
                </div>
            </section>

            <!-- Objetivos Institucionales -->
            <section class="py-32 px-8 md:px-16 lg:px-24 bg-white">
                <div class="max-w-7xl mx-auto">
                    <h2 class="text-4xl md:text-5xl font-display text-center text-museum-dark mb-20 leading-tight">
                        Objetivos del <span class="text-museum-gold italic">Impacto Institucional</span>
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                        <div class="flex items-start gap-4 p-6 rounded-2xl hover:bg-museum-cream/30 transition-colors">
                            <span class="text-museum-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            <p class="text-museum-dark/80 font-light">Resignificar el territorio como archivo vivo y sujeto pedagógico.</p>
                        </div>
                        <div class="flex items-start gap-4 p-6 rounded-2xl hover:bg-museum-cream/30 transition-colors">
                            <span class="text-museum-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            <p class="text-museum-dark/80 font-light">Consolidar una pedagogía comunitaria crítica e intergeneracional.</p>
                        </div>
                        <div class="flex items-start gap-4 p-6 rounded-2xl hover:bg-museum-cream/30 transition-colors">
                            <span class="text-museum-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            <p class="text-museum-dark/80 font-light">Impulsar un turismo cultural ético, participativo y transformador.</p>
                        </div>
                        <div class="flex items-start gap-4 p-6 rounded-2xl hover:bg-museum-cream/30 transition-colors">
                            <span class="text-museum-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            <p class="text-museum-dark/80 font-light">Fortalecer la economía simbólica y creativa del barrio.</p>
                        </div>
                        <div class="flex items-start gap-4 p-6 rounded-2xl hover:bg-museum-cream/30 transition-colors">
                            <span class="text-museum-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            <p class="text-museum-dark/80 font-light">Institucionalizar la Cátedra de Identidad Barrial como herramienta curricular.</p>
                        </div>
                        <div class="flex items-start gap-4 p-6 rounded-2xl hover:bg-museum-cream/30 transition-colors">
                            <span class="text-museum-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            <p class="text-museum-dark/80 font-light">Escalar el modelo a nivel nacional mediante transferencia metodológica.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Indicadores de Impacto (Stats) -->
            <section class="py-24 bg-museum-dark text-white relative overflow-hidden">
                <!-- Particle background abstraction -->
                <div class="absolute inset-0 opacity-5 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
                <div class="max-w-7xl mx-auto px-8 relative z-10">
                    <div id="stats-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 text-center">
                        <div class="stat-card opacity-0 translate-y-10 transition-all duration-1000 ease-out">
                            <p class="text-5xl md:text-6xl font-display text-museum-gold mb-2 transition-all hover:scale-110 duration-500">
                                <span class="counter" data-target="150">0</span>+
                            </p>
                            <p class="text-xs tracking-[0.2em] font-bold uppercase opacity-50">Relatos Sistematizados</p>
                        </div>
                        <div class="stat-card opacity-0 translate-y-10 transition-all duration-1000 ease-out">
                            <p class="text-5xl md:text-6xl font-display text-museum-gold mb-2 transition-all hover:scale-110 duration-500">
                                <span class="counter" data-target="15">0</span>
                            </p>
                            <p class="text-xs tracking-[0.2em] font-bold uppercase opacity-50">I. Educativas Vinculadas</p>
                        </div>
                        <div class="stat-card opacity-0 translate-y-10 transition-all duration-1000 ease-out">
                            <p class="text-5xl md:text-6xl font-display text-museum-gold mb-2 transition-all hover:scale-110 duration-500">
                                <span class="counter" data-target="800">0</span>
                            </p>
                            <p class="text-xs tracking-[0.2em] font-bold uppercase opacity-50">Visitantes Anuales</p>
                        </div>
                        <div class="stat-card opacity-0 translate-y-10 transition-all duration-1000 ease-out">
                            <p class="text-5xl md:text-6xl font-display text-museum-gold mb-2 transition-all hover:scale-110 duration-500">
                                <span class="counter" data-target="250">0</span>K
                            </p>
                            <p class="text-xs tracking-[0.2em] font-bold uppercase opacity-50">Visualizaciones Digitales</p>
                        </div>
                    </div>
                </div>
            </section>

            <script>
                function initStatsAnimation() {
                    const statsContainer = document.querySelector('#stats-container');
                    if (!statsContainer) return;

                    const countUp = (el) => {
                        const target = parseInt(el.getAttribute('data-target'));
                        const duration = 2000; // 2 seconds
                        const start = 0;
                        const startTime = performance.now();

                        const animate = (currentTime) => {
                            const elapsedTime = currentTime - startTime;
                            const progress = Math.min(elapsedTime / duration, 1);
                            
                            // Easing function for smoother finish
                            const easeOutExpo = 1 - Math.pow(2, -10 * progress);
                            const currentValue = Math.floor(easeOutExpo * target);
                            
                            el.textContent = currentValue;

                            if (progress < 1) {
                                requestAnimationFrame(animate);
                            } else {
                                el.textContent = target;
                            }
                        };

                        requestAnimationFrame(animate);
                    };

                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const cards = entry.target.querySelectorAll('.stat-card');
                                cards.forEach((card, index) => {
                                    setTimeout(() => {
                                        card.classList.remove('opacity-0', 'translate-y-10');
                                        card.classList.add('opacity-100', 'translate-y-0');
                                        
                                        // Trigger count up for the span inside this card
                                        const counter = card.querySelector('.counter');
                                        if (counter) countUp(counter);
                                    }, index * 200);
                                });
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.3 });

                    observer.observe(statsContainer);
                }

                // Initialize correctly
                initStatsAnimation();
                document.addEventListener('astro:after-swap', initStatsAnimation);
            </script>

            <!-- Proyección Final -->
            <section class="py-32 px-8 bg-museum-cream">
                <div class="max-w-4xl mx-auto text-center">
                    <h2 class="text-3xl md:text-4xl font-display text-museum-dark mb-10 tracking-tight">Proyección y Escalabilidad</h2>
                    <p class="text-lg font-light leading-relaxed text-museum-dark/70 mb-16 italic">
                        "El modelo se consolida como una metodología replicable para territorios populares de Colombia y América Latina, fortaleciendo la participación ciudadana y la justicia cultural."
                    </p>
                    <a href="/" class="inline-block border border-museum-dark/30 text-museum-dark px-12 py-5 rounded-sm text-xs font-bold tracking-[0.3em] uppercase hover:bg-museum-dark hover:text-white transition-all duration-700 shadow-sm">
                        Volver a la Página Principal
                    </a>
                </div>
            </section>
        </main>
	</body>
</html>
