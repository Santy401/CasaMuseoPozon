---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import YouTube from "../components/YouTube.astro";
import Section from "../components/ui/Section.astro";
import StickySplit from "../components/ui/StickySplit.astro";
import Checklist from "../components/ui/Checklist.astro";
import Stats from "../components/ui/Stats.astro";
import Quote from "../components/ui/Quote.astro";
import Btn from "../components/ui/Btn.astro";

const componentes = [
    { title: "Memoria Viva", text: "Sistematización de relatos, archivos comunitarios, cartografías simbólicas y dispositivos de resignificación territorial." },
    { title: "Educación Territorial", text: "Cátedra de Identidad Barrial, metodologías sentipensantes, aulas vivas y formación de facilitadores comunitarios." },
    { title: "Turismo Popular", text: "Rutas simbólicas, mediadores turísticos comunitarios y experiencias inmersivas con enfoque ético y de dignidad." },
    { title: "Economía Creativa Comunitaria", text: "Emprendimientos creativos, productos identitarios y circuitos de comercialización cultural para el barrio." },
    { title: "Articulación", text: "Alianzas intersectoriales, incidencia en políticas públicas y alineación con marcos legales y agendas de cooperación." },
];
const programa = [
    { title: "Recorridos museales barriales", text: "Diseño y ejecución de recorridos museales barriales." },
    { title: "Contenidos y narrativas", text: "Producción de contenidos digitales y narrativas comunitarias." },
    { title: "Líderes mediadores", text: "Formación de líderes como mediadores culturales y turísticos." },
    { title: "Aulas vivas", text: "Activación de espacios públicos como aulas vivas." },
    { title: "Alianzas y cooperación", text: "Gestión de alianzas, convocatorias y cooperación técnica." },
];
const objetivos = [
    { text: "Resignificar el territorio como archivo vivo y sujeto pedagógico." },
    { text: "Consolidar una pedagogía comunitaria crítica e intergeneracional." },
    { text: "Impulsar un turismo cultural ético, participativo y transformador." },
    { text: "Fortalecer la economía simbólica y creativa del barrio." },
    { text: "Institucionalizar la Cátedra de Identidad Barrial como herramienta curricular." },
    { text: "Escalar el modelo a nivel nacional mediante transferencia metodológica." },
];
const stats = [
    { value: 150, suffix: "+", label: "Relatos Sistematizados" },
    { value: 15, label: "I. Educativas Vinculadas" },
    { value: 800, label: "Visitantes Anuales" },
    { value: 250, suffix: "K", label: "Visualizaciones Digitales" },
];
---

<Layout
  title="Modelo Museal Turístico Territorial | Casa Museo Pozón"
  description="Modelo Museal Turístico Territorial — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-white font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/67e9a4a5-7c33-467c-9baa-58dd8a510c3c.webp" group="Experiencia" current="Modelo museal">
      <Fragment slot="eyebrow">Cartagena Popular: El Pozón como Museo Vivo</Fragment>
      Modelo Museal <span class="text-museum-gold">Turístico Territorial</span>
      <Fragment slot="lead">Una estrategia integral de innovación social, cultural y educativa que posiciona al barrio El Pozón como un ecosistema de memoria viva.</Fragment>
      <Fragment slot="actions">
        <a href="/pdfs/Modelo Museal Turístico Territorial.pdf" target="_blank" class="inline-flex items-center gap-4 bg-museum-gold text-museum-dark px-10 py-5 rounded-full text-[10px] font-bold tracking-widest uppercase hover:bg-white transition-all shadow-xl"> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Descargar Modelo Completo (PDF) </a>
      </Fragment>
    </PageHero>

    <!-- 01 Enfoque: cinco componentes en un recorrido horizontal -->
    <section id="enfoque" class="ui-section relative bg-museum-cream text-museum-dark" data-tone="cream">
        <div data-hscroll class="relative lg:min-h-svh flex flex-col justify-center py-20 lg:py-0 overflow-hidden">
            <header class="w-full max-w-7xl mx-auto px-6 md:px-16 lg:px-24 mb-10 lg:mb-14">
                <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Cinco componentes articulados</span>
                <h2 class="font-display text-4xl md:text-6xl leading-[1.05] max-w-3xl">Enfoque <span class="text-museum-gold">Estratégico</span></h2>
                <p class="mt-5 max-w-2xl font-light text-base md:text-lg opacity-75 leading-relaxed">El modelo se fundamenta en cinco componentes que operan de manera articulada para fortalecer capacidades locales.</p>
            </header>
            <div data-hscroll-track class="hs-track">
                {componentes.map((c, i) => (
                    <article data-spotlight class:list={["pillar relative overflow-hidden rounded-[2rem] p-8 md:p-10 min-h-[22rem] lg:min-h-[26rem] flex flex-col justify-between border", i % 2 ? "bg-museum-dark text-museum-cream border-museum-dark" : "bg-white text-museum-dark border-museum-dark/10"]}>
                        <span class="pillar-glow" aria-hidden="true"></span>
                        <span class="relative font-display text-[5.5rem] md:text-[7rem] leading-none text-transparent [-webkit-text-stroke:1.5px_rgb(196_160_82)] tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                        <div class="relative">
                            <h3 class="font-display text-2xl md:text-3xl mb-4 leading-tight">{c.title}</h3>
                            <p class="font-light text-sm md:text-base leading-relaxed opacity-75">{c.text}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- 02 Programa operativo -->
    <Section id="activacion" tone="dark" eyebrow="Programa Operativo">
        <Fragment slot="title">Activación del <span class="text-museum-gold">Museo Vivo</span></Fragment>
        <StickySplit steps={programa} dark>
            <p class="font-light text-museum-cream/70 leading-relaxed max-w-sm">Cinco acciones que convierten al barrio en un museo vivo: recorridos, contenidos, formación, aulas al aire libre y alianzas.</p>
        </StickySplit>
        <div class="mt-16 md:mt-24 rounded-[2rem] overflow-hidden border border-museum-cream/10">
            <YouTube id="https://youtu.be/WYitZwv2XzA?si=Q7k7gCahqEyeTC8l" />
        </div>
    </Section>

    <!-- 03 Objetivos -->
    <Section id="objetivos" tone="white" eyebrow="Lo que buscamos">
        <Fragment slot="title">Objetivos del <span class="text-museum-gold italic">Impacto Institucional</span></Fragment>
        <Checklist items={objetivos} />
    </Section>

    <!-- 04 Indicadores -->
    <Section id="indicadores" tone="cream" eyebrow="Indicadores de impacto" align="center">
        <Fragment slot="title">Lo que ya <span class="text-museum-gold">logramos</span></Fragment>
        <Stats stats={stats} />
    </Section>

    <!-- 05 Proyección -->
    <Section id="proyeccion" tone="dark" eyebrow="Proyección y Escalabilidad" align="center" narrow>
        <Quote dark>El modelo se consolida como una metodología replicable para territorios populares de Colombia y América Latina, fortaleciendo la participación ciudadana y la justicia cultural.</Quote>
        <div class="mt-14 flex justify-center"><Btn href="/" variant="outline">Volver a la Página Principal</Btn></div>
    </Section>
</Layout>
