---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Pillars from "../components/ui/Pillars.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";

const planes = [
    {
        name: "Experiencia Segmentada",
        price: "$35.000",
        desc: "Ideal para visitas puntuales. Un viaje interactivo a la historia y cultura directamente en nuestras instalaciones (1h 30m).",
        features: [
            "Exposición fotográfica y documental",
            "Inmersión en el sitio arqueológico",
            "Contextualización histórica con guía",
            "Conexión creativa y degustaciones",
            "Espacio de reflexión barrial"
        ],
        highlight: false
    },
    {
        name: "Plan Integral (Todo el Día)",
        price: "$290.000",
        desc: "Experiencia completa e inmersiva recorriendo la memoria del territorio. Transporte, fotografía y atenciones incluidas.",
        features: [
            "Punto de encuentro: Las Letras (Sesión fotográfica)",
            "Transporte panorámico (Chiva o Bici-coches)",
            "Recorrido guiado Casa Museo Pozón y Gastronomía",
            "Kit Turístico (Hidratación, escarapela, almuerzo)",
            "Intercambio de saberes y acompañamiento local"
        ],
        highlight: true
    }
];
const pilares = [
    { title: "Inclusión Social", text: "Generamos oportunidades de empleo y formación para jóvenes del barrio.", icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
    { title: "Arte Mural", text: "Las calles narran la epopeya popular mediante el color y el activismo gráfico.", icon: '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>' },
    { title: "Cocina Tradicional", text: "Rescate de recetas tradicionales elaboradas por matronas del territorio.", icon: '<path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/>' },
    { title: "Señalética Interactiva", text: "Navegación inteligente que vincula puntos físicos con testimonios orales.", icon: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>' },
];
---

<Layout 
  title="Ruta Turística Comunitaria | Casa Museo El Pozón"
  description="Destapa la historia de un barrio con ritmo y sabor sin igual. Conoce nuestros planes turísticos comunitarios y apoya nuestra sostenibilidad."
>
    <PageHero image="/galeria/ddd1573f-81af-4f70-9e07-bb5dc4666bc8.webp" group="Experiencia" current="Turismo comunitario">
      <Fragment slot="eyebrow">Turismo con Raíz Popular</Fragment>
      Ruta Turística <span class="text-museum-gold italic">Comunitaria</span>
      <Fragment slot="lead">"Destapa la historia de un barrio con ritmo y sabor sin igual."</Fragment>
    </PageHero>

    <Section id="modelo" tone="cream" eyebrow="El Modelo de Turismo Social">
        <Fragment slot="title">Una Experiencia <span class="text-museum-gold">Sentipensante</span></Fragment>
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-24 items-center mb-16 md:mb-24">
            <div class="relative max-w-sm mx-auto w-full">
                <div class="aspect-square rounded-[2rem] bg-white shadow-[0_50px_90px_-45px_rgba(26,26,26,0.5)] p-8 flex items-center justify-center">
                    <img src="/logos/modelo-turistico.jpeg" alt="Sello colectivo de la Red de Turismo Popular de El Pozón" loading="lazy" class="max-w-full max-h-full object-contain" />
                </div>
                <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 bg-museum-dark text-museum-cream rounded-2xl px-5 py-3 text-center w-[88%] shadow-xl">
                    <span class="block text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold">Sello Colectivo</span>
                    <span class="block text-[11px] opacity-80 leading-snug mt-1">Marca Registrada de la Red de Turismo Popular de El Pozón</span>
                </div>
            </div>
            <div class="space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-dark/80">
                <p>Nuestra Ruta Turística Comunitaria no es un recorrido convencional. Es una estrategia de museología social orientada a dignificar el patrimonio biocultural, arqueológico e histórico de El Pozón, liderado y operado por jóvenes locales formados como mediadores.</p>
                <p class="text-base md:text-lg text-museum-dark/70">A través de bici-coches, recorridos gastronómicos, visitas al santuario del humedal y apreciación del vibrante muralismo local, los visitantes conectan directamente con la memoria popular y apoyan el desarrollo económico de las familias del territorio.</p>
            </div>
        </div>
        <Pillars items={pilares} cols={4} numbered={false} />
    </Section>

    <Section id="precios" tone="dark" eyebrow="Cartagena Popular" align="center">
        <Fragment slot="title">Planes <span class="text-museum-gold">Turísticos</span></Fragment>
        <Fragment slot="lead">“Destapa la historia de un barrio con ritmo y sabor sin igual”. Tu aporte garantiza la sostenibilidad de nuestra misión comunitaria.</Fragment>
        <div class="grid lg:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto text-left">
            {planes.map((plan) => (
                <article data-spotlight class:list={["pillar relative overflow-hidden rounded-[2rem] p-8 md:p-12 flex flex-col border", plan.highlight ? "bg-museum-gold text-museum-dark border-museum-gold" : "bg-museum-cream/5 text-museum-cream border-museum-cream/15"]}>
                    <span class="pillar-glow" aria-hidden="true"></span>
                    {plan.highlight && <span class="absolute top-6 right-6 rounded-full bg-museum-dark text-museum-gold text-[10px] font-bold tracking-[0.25em] uppercase px-4 py-1.5">Recomendado</span>}
                    <h3 class="relative font-display text-2xl md:text-3xl mb-6 max-w-[16rem] leading-tight">{plan.name}</h3>
                    <p class="relative flex items-baseline gap-3 mb-6"><span class="font-display text-6xl md:text-7xl tabular-nums leading-none">{plan.price}</span><span class="text-[11px] font-bold tracking-[0.2em] uppercase opacity-70">COP / pers.</span></p>
                    <p class="relative font-light leading-relaxed opacity-85 mb-8">{plan.desc}</p>
                    <ul class="relative space-y-3 mb-10">
                        {plan.features.map((f) => (
                            <li class="flex gap-3 text-sm md:text-base font-light"><span class:list={["mt-1 shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-[10px]", plan.highlight ? "bg-museum-dark text-museum-gold" : "bg-museum-gold text-museum-dark"]} aria-hidden="true">✓</span>{f}</li>
                        ))}
                    </ul>
                    <div class="relative mt-auto"><Btn href="/#contacto" variant={plan.highlight ? "dark" : "gold"}>Reservar Ahora</Btn></div>
                </article>
            ))}
        </div>
    </Section>

    <CtaBand>
        <Fragment slot="title">¿Deseas personalizar <span class="text-museum-gold">tu visita</span>?</Fragment>
        Ofrecemos tarifas especiales para colegios, grupos académicos e investigadores. Consúltanos para diseñar una experiencia a tu medida.
        <Fragment slot="actions"><Btn href="/#contacto">Cotizar Visita Personalizada</Btn></Fragment>
    </CtaBand>
</Layout>
