---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Pillars from "../components/ui/Pillars.astro";
import StickySplit from "../components/ui/StickySplit.astro";
import Quote from "../components/ui/Quote.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";

const principios = [
    { title: "Saber Orgánico", text: "Conocimiento que crece desde las raíces culturales del barrio y sus prácticas cotidianas." },
    { title: "Vínculo Comunitario", text: "El aprendizaje como un acto de co-creación donde todos somos maestros y aprendices." },
];
const experiencias = [
    { title: "Recorridos", text: "Caminatas históricas por las calles del barrio, reconociendo hitos de resistencia y vida." },
    { title: "Juegos", text: "Dinámicas lúdicas que enseñan la historia de forma participativa para niños y jóvenes." },
    { title: "Inmersión", text: "Experiencias sensoriales dentro del territorio para conectar con su alma biocultural." },
    { title: "Muralismo", text: "El arte como lenguaje público que narra nuestras luchas y esperanzas en las paredes." },
];
const modulos = [
    { title: "Raíces y Arqueología", text: "Exploración del origen del conchero ancestral a los asentamientos populares." },
    { title: "Cartografía de las Memorias", text: "Descolonización de la geografía urbana mediante mapas colectivos del afecto." },
    { title: "Gobernanza y Paz", text: "Liderazgo ético de base y herramientas para la convivencia pacífica." },
    { title: "Futuros Bioculturales", text: "Sostenibilidad y escalabilidad global de la ciencia comunitaria." },
];
---

<Layout 
  title="Pedagogía Territorial | Saberes del Pozón"
  description="Donde el territorio se convierte en aula y la memoria en la principal herramienta de aprendizaje en Casa Museo El Pozón."
>
    <PageHero image="/galeria/ESTUDIANTES TRES-9.webp" group="Saberes" current="Pedagogía territorial">
      <Fragment slot="eyebrow">Ecosistema de Saberes Colectivos</Fragment>
      Pedagogía <span class="text-museum-gold">Territorial</span>
      <Fragment slot="lead">"Donde el territorio se convierte en aula y la memoria en la principal herramienta de aprendizaje."</Fragment>
    </PageHero>

    <Section id="modelo-aco" tone="dark" eyebrow="Fundamentación Ética">
        <Fragment slot="title">Modelo de Aprendizaje <span class="text-museum-gold">Comunitario Orgánico (A.C.O.)</span></Fragment>
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-24 items-center mb-14">
            <p class="font-display text-2xl md:text-4xl leading-snug text-balance">El Modelo A.C.O. es el corazón pedagógico de nuestra fundación. Propone una educación que nace de la tierra, se nutre de la memoria oral y se organiza de forma horizontal para transformar la realidad local.</p>
            <div class="flex justify-center"><img src="/logos/casa-museo-pozon.webp" alt="Casa Museo Pozón" loading="lazy" class="w-48 md:w-64 h-auto" /></div>
        </div>
        <Pillars items={principios} cols={2} dark />
        <div class="mt-12"><Btn href="/pdfs/MODELO DE APRENDIZAJE COMUNITARIO ORGÁNICO.pdf" external>Descargar Modelo A.C.O.</Btn></div>
    </Section>

    <Section id="experiencias" tone="cream" eyebrow="Inmersión y Vivencia">
        <Fragment slot="title">Experiencias <span class="text-museum-gold">Museales</span></Fragment>
        <Pillars items={experiencias} cols={4} />
    </Section>

    <Section id="catedra" tone="white" eyebrow="Formación Ciudadana">
        <Fragment slot="title">Cátedra de la <span class="text-museum-gold">Identidad Barrial Pozonera</span></Fragment>
        <StickySplit steps={modulos}>
            <div class="space-y-5 font-light leading-relaxed text-museum-dark/75 max-w-md">
                <p class="font-display text-xl md:text-2xl text-museum-dark">“Un viaje transformador hacia el autorreconocimiento del ser pozonero.”</p>
                <p>La Cátedra de la Identidad Barrial Pozonera es nuestro programa pedagógico insignia para la juventud, diseñado para desactivar estigmas y despertar el orgullo territorial a través de la <strong class="font-bold text-museum-dark">Arqueología de la Autoestima</strong>.</p>
                <p>Basada en la metodología del Modelo A.C.O., esta cátedra se estructura en cuatro módulos formativos que guían a los estudiantes a través de las raíces milenarias, los mapas comunitarios, los acuerdos de gobernanza y la proyección de futuros bioculturales.</p>
                <div class="pt-3"><Btn href="/catedra-identidad" variant="dark">Explorar la Cátedra Completa</Btn></div>
            </div>
        </StickySplit>
    </Section>

    <CtaBand tone="gold">
        <Fragment slot="title">Escuela de <span class="italic">Museología</span></Fragment>
        Conoce nuestro programa dedicado a la formación técnica para la gestión del patrimonio barrial.
        <Fragment slot="actions"><Btn href="/escuela-museologica" variant="dark">Ver Detalles de la Escuela</Btn></Fragment>
    </CtaBand>

    <Section id="aula-viva" tone="dark" eyebrow="Transformando realidades" align="center" narrow>
        <Quote dark>La pedagogía territorial es el puente que une nuestro pasado ancestral con las aspiraciones de justicia social y dignidad de nuestro presente.</Quote>
        <div class="mt-14 flex justify-center"><Btn href="/" variant="outline">Volver al Inicio</Btn></div>
    </Section>
</Layout>
