---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Pillars from "../components/ui/Pillars.astro";
import Checklist from "../components/ui/Checklist.astro";
import StickySplit from "../components/ui/StickySplit.astro";
import Quote from "../components/ui/Quote.astro";
import Btn from "../components/ui/Btn.astro";

const aco = [
    { title: "Aprendizaje Situado", text: "El barrio y el museo se convierten en extensiones del aula, donde el conocimiento surge de la observación directa del territorio y su historia." },
    { title: "Pedagogía de la Memoria", text: "El uso de la historia local como eje transversal para el desarrollo de competencias en ciencias sociales, artes y ética." },
    { title: "Investigación-Acción", text: "Los estudiantes participan activamente en la documentación de la memoria viva de su entorno, no solo como receptores de información." },
];
const objetivos = [
    { text: "Establecer procesos de laboratorios creativos conforme a las focalizaciones establecidas sobre pedagogías museologicas territoriales, ante Secretaria de Educación Distrital, IPCC y la Red de Museos de Cartagena y Bolívar" },
    { text: "Proveer recursos digitales y museográficos para planes de área educativos." },
    { text: "Crear una plataforma oficial para la difusión de hallazgos comunitarios." },
];
const ejes = [
    { title: "Investigación Territorial", text: "Espacio técnico dedicado a documentar la historia de los concheros y las ancestralidades presentes en el ADN del Pozón." },
    { title: "Innovación Educativa", text: "Las instituciones aliadas adoptan el marco pedagógico A.C.O. para transformar el currículo tradicional en uno orgánico y contextualizado." },
    { title: "Gestión de Memoria", text: "Sistema de préstamo y rotación de materiales museográficos para que la historia “viva” circule por cada institución." },
];
const catedra = [
    { title: "Integración Curricular", text: "Módulos pedagógicos basados en la arqueología local e historia del asentamiento." },
    { title: "Talleres de Co-creación", text: "Docentes y estudiantes producen sus propias micro-exhibiciones comunitarias." },
    { title: "Circulación de Contenidos", text: "Herramientas digitales para que el conocimiento del Centro de Investigación llegue de forma dinámica a todos." },
];
const niveles = [
    { tag: "Nivel 1", kicker: "La Estrategia", title: "“El Museo Expandido y Sentipensante”", text: "El objetivo es romper las paredes físicas del museo. La estrategia consiste en consolidar El Pozón como un Ecosistema de Memoria Viva donde las calles, las casas, las huertas y los concheros arqueológicos forman parte de un solo circuito cultural. Enfoque único: posicionarse no solo como un lugar para visitar, sino como un centro de investigación comunitaria y de innovación social desde el Caribe." },
    { tag: "Nivel 2", kicker: "El Programa", title: "“Escuela de Mediadores y Saberes Ancestrales”", text: "Un programa permanente enfocado en la transferencia de conocimiento y el relevo generacional. ¿En qué consiste? Crear una escuela técnica o comunitaria (articulada con la Secretaría de Educación y el IPCC) que certifique a jóvenes del barrio como Mediadores Patrimoniales y Cuidadores de la Memoria. Impacto: los mismos jóvenes guían a los turistas e investigadores, aplicando el Modelo A.C.O. (Aprendizaje Comunitario Orgánico) en el territorio." },
    { tag: "Nivel 3", kicker: "El Proyecto Piloto", title: "“El Laboratorio de Bio-Arqueología Comunitaria”", text: "Un proyecto concreto, medible y de alto impacto que capte la atención nacional e internacional. La acción: crear un espacio de co-creación donde la comunidad (ancianos, jóvenes y científicos aliados) investigue los hallazgos arqueológicos del sector (como los concheros) y los conecte con la soberanía alimentaria actual (en la Huerta de Memoria). Resultado: una exposición viva y digital (Memoteca) que muestre cómo los saberes indígenas y africanos de hace siglos responden a los desafíos ambientales de hoy." },
];
const aliados = [
    { src: "/imagenes/distrito-cartagena.jpeg", alt: "Distrito de Cartagena" },
    { src: "/imagenes/ipcc.jpeg", alt: "IPCC" },
    { src: "/imagenes/red-museos.jpeg", alt: "Red de Museos de Cartagena y Bolívar" },
];
---

<Layout
  title="Red Académica Museológica | Centro de Investigación y Memoria del Pozón"
  description="Red Académica Museológica — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-white font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/SEMINARIO ESCLAVIZACIONES 1-8.webp" group="Saberes" current="Red museológica">
      <Fragment slot="eyebrow">Ecosistema de Activación Patrimonial</Fragment>
      Red Académica <span class="text-museum-gold">Museológica</span>
      <Fragment slot="lead">Centro de Investigación y Memoria del Pozón: Una alianza estratégica para consolidar la identidad y resiliencia territorial.</Fragment>
    </PageHero>

    <Section id="presentacion" tone="cream" eyebrow="01. Alianza Estratégica">
        <Fragment slot="title">Presentación y <span class="text-museum-gold">Justificación</span></Fragment>
        <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-24 items-start">
            <div class="space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-dark/80">
                <p>Este proyecto surge como una alianza estratégica de colaboraciones entre el <strong class="font-bold text-museum-dark">Distrito</strong>, el <strong class="font-bold text-museum-dark">IPCC</strong>, la <strong class="font-bold text-museum-dark">Red de Museos</strong> y las instituciones educativas públicas y privadas.</p>
                <p class="text-base md:text-lg text-museum-dark/70">En el caso del territorio pozonero, la <strong class="font-bold text-museum-dark">Fundación Casa Museo Pozón</strong> tiene como propósito consolidar un Ecosistema de Activación Patrimonial donde la investigación científica, la memoria histórica y la educación formal converjan para fortalecer el tejido social y la resiliencia territorial de las comunidades.</p>
            </div>
            <ul class="space-y-3">
                {[["Ancestral", "Tecnologías"], ["Concheros", "Depósitos Arqueológicos"], ["Identidad", "Herramientas de Progreso"]].map(([t, d], i) => (
                    <li class="flex items-center justify-between gap-6 rounded-2xl bg-white border border-museum-dark/10 p-5 md:p-6">
                        <span class="font-display text-museum-gold/60 text-2xl tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                        <span class="flex-1"><span class="block font-display text-xl">{t}</span><span class="block text-[10px] font-bold tracking-[0.25em] uppercase text-museum-dark/50 mt-1">{d}</span></span>
                    </li>
                ))}
            </ul>
        </div>
        <div class="mt-14 md:mt-20 rounded-[2rem] bg-museum-dark text-museum-cream p-8 md:p-14">
            <p class="font-display text-2xl md:text-4xl leading-snug text-balance">“La red no es solo una estructura administrativa; es un organismo vivo que busca rescatar el conocimiento de las tecnologías ancestrales.”</p>
        </div>
    </Section>

    <Section id="aco" tone="white" eyebrow="02. Educación Orgánica">
        <Fragment slot="title">Marco Pedagógico: <span class="text-museum-gold">Modelo A.C.O.</span></Fragment>
        <Fragment slot="lead">Aprendizaje Comunitario Orgánico: El sustento pedagógico de nuestra Red Museológica.</Fragment>
        <Pillars items={aco} cols={3} />
    </Section>

    <Section id="objetivos" tone="dark" eyebrow="03. Metas Clave">
        <Fragment slot="title">Objetivos <span class="text-museum-gold">Estratégicos</span></Fragment>
        <div class="mb-12 md:mb-16 rounded-[2rem] border border-museum-gold/40 p-8 md:p-12">
            <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-museum-gold mb-4">Objetivo General</span>
            <p class="font-display text-2xl md:text-4xl leading-snug text-balance">Establecer una red colaborativa que funcione como epicentro para el intercambio de conocimientos ancestrales y la implementación del Modelo A.C.O.</p>
        </div>
        <Checklist items={objetivos} dark cols={1} />
    </Section>

    <Section id="ejes" tone="cream" eyebrow="04. Operatividad">
        <Fragment slot="title">Ejes de <span class="text-museum-gold">Acción</span></Fragment>
        <Fragment slot="lead">La red opera bajo tres pilares fundamentales que garantizan su impacto territorial.</Fragment>
        <Pillars items={ejes} cols={3} />
    </Section>

    <Section id="catedra" tone="white" eyebrow="05. Brazo Operativo">
        <Fragment slot="title">Cátedra de la <span class="text-museum-gold">Identidad Barrial</span></Fragment>
        <Fragment slot="lead">La Red servirá como el brazo operativo para implementar la Cátedra, integrando la arqueología local en el ADN educativo.</Fragment>
        <Pillars items={catedra} cols={3} />
    </Section>

    <Section id="niveles" tone="dark" eyebrow="06. Visión de Futuro">
        <Fragment slot="title">Niveles de <span class="text-museum-gold">Acción Estratégica</span></Fragment>
        <StickySplit steps={niveles} dark>
            <p class="font-light text-museum-cream/70 leading-relaxed max-w-sm">Una hoja de ruta diseñada para escalar el impacto territorial, estructurada como ecosistema de cooperación nacional e internacional.</p>
        </StickySplit>
    </Section>

    <Section id="identidad" tone="cream" eyebrow="07. Imagen institucional">
        <Fragment slot="title">Identidad <span class="text-museum-gold">Institucional</span></Fragment>
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-24 items-center">
            <div class="aspect-square max-w-sm mx-auto w-full rounded-[2rem] bg-white shadow-[0_50px_90px_-45px_rgba(26,26,26,0.5)] p-10 flex items-center justify-center"><img src="/logos/red-museologica.png" alt="Sello de la Red Académica Museológica" loading="lazy" class="max-w-full max-h-full object-contain" /></div>
            <div>
                <blockquote class="font-display text-2xl md:text-3xl leading-snug mb-10 text-balance">“El sello de la Red Académica Museológica representa la unión de manos, instituciones y saberes en torno al espiral de la vida, símbolo de nuestra memoria ancestral compartida.”</blockquote>
                <div class="grid sm:grid-cols-2 gap-6 mb-10">
                    <div class="rounded-2xl bg-white border border-museum-dark/10 p-6">
                        <h3 class="text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold mb-3">Liderado por</h3>
                        <p class="font-display text-xl mb-2">Fundación Casa Museo Pozón</p>
                        <p class="text-sm font-light text-museum-dark/70 leading-relaxed">En alianza estratégica con la Secretaría de Educación Distrital, el IPCC y la Red de Museos de Cartagena y Bolívar.</p>
                        <p class="text-xs font-bold tracking-[0.15em] mt-3">NIT 901939559-4</p>
                    </div>
                    <div class="rounded-2xl bg-white border border-museum-dark/10 p-6">
                        <h3 class="text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold mb-3">Ubicación</h3>
                        <p class="font-display text-xl mb-2">Sector Islita, Cartagena</p>
                        <p class="text-sm font-light text-museum-dark/70">Trasv. 57 81-12, El Pozón</p>
                    </div>
                </div>
                <ul class="flex flex-wrap items-center gap-4">
                    {aliados.map((a) => <li class="h-20 md:h-24 rounded-2xl bg-white border border-museum-dark/10 px-5 flex items-center"><img src={a.src} alt={a.alt} loading="lazy" class="max-h-14 md:max-h-16 w-auto object-contain" /></li>)}
                </ul>
                <p class="mt-8 font-display text-lg text-museum-gold">Hacia una pedagogía de la memoria y la identidad.</p>
            </div>
        </div>
    </Section>
</Layout>
