---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import SocioCard from "../components/SocioCard.astro";
import { socios } from "../data/socios";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Socios | Casa Museo Pozón</title>
        <ClientRouter />
	</head>
	<body class="bg-white font-sans overflow-x-hidden">
        <SocialSidebar />
		<Navbar />
        
        <main>
            <!-- Hero Header -->
            <section class="relative min-h-[60vh] flex items-center justify-center bg-museum-dark pt-20 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-museum-dark/80 to-museum-dark z-10"></div>
                <div class="absolute inset-0 opacity-20 bg-[url('/imagenes/creator.png')] bg-cover bg-center mix-blend-overlay"></div>
                
                <div class="relative z-20 text-center px-8" transition:animate="fade">
                    <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs mb-8 uppercase block">Legitimidad y Compromiso</span>
                    <h1 class="text-6xl md:text-[8rem] lg:text-[10rem] font-display text-white mb-10 leading-none">
                        Nuestros <br/> <span class="text-museum-gold italic">Socios</span>
                    </h1>
                    <div class="w-24 h-1 bg-museum-gold mx-auto"></div>
                </div>
            </section>

            <!-- Members Grid -->
            <section class="py-32 px-8">
                <div class="max-w-7xl mx-auto">
                    <div class="text-center mb-24">
                        <h2 class="text-4xl md:text-5xl font-display text-museum-dark mb-6">Cuerpo Colegiado</h2>
                        <div class="w-20 h-1 bg-museum-gold mx-auto mb-10"></div>
                        <p class="text-museum-dark/60 font-light max-w-2xl mx-auto">Custodios de la legitimidad institucional y arquitectos estratégicos de la transformación comunitaria.</p>

                        <div class="mt-10 inline-flex items-center gap-4 px-8 py-4 border border-museum-gold/20 rounded-full bg-museum-cream/60">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold flex-shrink-0"><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3M21 21v.01M12 7v3a2 2 0 0 1-2 2H7M3 12h.01M12 3h.01M12 16v.01M16 12h1M21 12v.01M12 21v-1"></path></svg>
                            <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-[0.25em] text-museum-dark/50">Pulsa cualquier credencial para voltearla y ver su código QR</span>
                        </div>
                    </div>

                    <div id="socios-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                        {socios.map((socio, index) => (
                            <SocioCard socio={socio} index={index} />
                        ))}
                    </div>
                </div>
            </section>

            <!-- Final Footer Return -->
            <section class="py-24 text-center border-t border-museum-gold/5">
                <a href="/" class="group inline-flex items-center gap-6 px-12 py-6 border border-museum-dark/10 rounded-full hover:bg-museum-dark hover:text-white transition-all duration-700 shadow-xl shadow-museum-gold/5">
                   <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-2 transition-transform"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"/></svg>
                   <span class="text-xs font-bold uppercase tracking-[0.3em]">Volver al Inicio</span>
               </a>
           </section>
        </main>

        <Footer />

        <!-- Modal Perfil Socio -->
        <div id="modal-socio" class="fixed inset-0 z-[9999] hidden overflow-y-auto">
            <div id="modal-overlay" class="fixed inset-0 bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
            <div class="relative z-10 flex items-start justify-center min-h-screen p-4 pt-8 pb-8 md:items-center md:p-8">
                <div id="modal-content" class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full transform scale-95 opacity-0 transition-all duration-300 my-auto">
                    <!-- Header con foto -->
                    <div class="relative bg-museum-dark p-6 md:p-8 text-center rounded-t-3xl">
                        <button id="modal-close" class="absolute top-3 right-3 md:top-4 md:right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                        <div id="modal-image" class="w-28 h-28 md:w-40 md:h-40 rounded-full mx-auto mb-4 md:mb-6 border-4 border-museum-gold/30 overflow-hidden bg-museum-cream flex items-center justify-center">
                        </div>
                        <div id="modal-badge" class="inline-block text-[10px] font-bold text-museum-gold tracking-[0.2em] uppercase bg-museum-gold/10 px-4 py-2 rounded-full border border-museum-gold/20 mb-3 md:mb-4"></div>
                        <h2 id="modal-nombre" class="text-xl md:text-3xl font-display text-white mb-2"></h2>
                        <p id="modal-rol" class="text-[10px] md:text-xs font-bold text-museum-gold/70 uppercase tracking-widest"></p>
                    </div>

                    <!-- Contenido scrolleable -->
                    <div class="p-5 md:p-8" style="-webkit-overflow-scrolling: touch;">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-5 md:mb-6 gap-1 text-[10px] text-museum-dark/40">
                            <span id="modal-codigo" class="font-mono"></span>
                            <span id="modal-ingreso" class="italic"></span>
                        </div>

                        <div class="mb-5 md:mb-6">
                            <p class="text-[10px] font-bold text-museum-gold uppercase tracking-widest mb-3">Reconocimiento Simbólico</p>
                            <p id="modal-reconocimiento" class="text-xs md:text-sm font-light text-museum-dark/70 leading-relaxed italic"></p>
                        </div>

                        <div id="modal-descripcion-container" class="pt-5 md:pt-6 border-t border-museum-gold/10">
                            <p class="text-[10px] font-bold text-museum-gold uppercase tracking-widest mb-3">Impacto Institucional</p>
                            <p id="modal-descripcion" class="text-xs md:text-sm font-light text-museum-dark/60 leading-relaxed"></p>
                        </div>

                        <div class="mt-6 md:mt-8 pt-5 md:pt-6 border-t border-museum-gold/10 flex justify-center pb-2">
                            <div class="flex items-center gap-2 text-[10px] font-medium text-museum-dark/40">
                                <div class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></div>
                                <span id="modal-estado" class="uppercase tracking-widest"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script define:vars={{ sociosData: socios }}>
            function openModal(socio) {
                const modal = document.getElementById('modal-socio');
                const overlay = document.getElementById('modal-overlay');
                const content = document.getElementById('modal-content');
                const imageContainer = document.getElementById('modal-image');
                const badge = document.getElementById('modal-badge');
                const nombre = document.getElementById('modal-nombre');
                const rol = document.getElementById('modal-rol');
                const codigo = document.getElementById('modal-codigo');
                const ingreso = document.getElementById('modal-ingreso');
                const reconocimiento = document.getElementById('modal-reconocimiento');
                const descripcion = document.getElementById('modal-descripcion');
                const descContainer = document.getElementById('modal-descripcion-container');
                const estado = document.getElementById('modal-estado');

                if (socio.image) {
                    imageContainer.innerHTML = `<img src="${socio.image}" alt="${socio.nombre}" class="w-full h-full object-cover" />`;
                } else {
                    imageContainer.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold/30"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>`;
                }

                badge.textContent = `Socio ${socio.estado}`;
                nombre.textContent = socio.nombre;
                rol.textContent = socio.rol;
                codigo.textContent = socio.codigo;
                ingreso.textContent = `Ingreso: ${socio.ingreso}`;
                reconocimiento.textContent = `"${socio.reconocimiento}"`;
                estado.textContent = socio.estado;

                if (socio.descripcion) {
                    descContainer.classList.remove('hidden');
                    descripcion.textContent = socio.descripcion;
                } else {
                    descContainer.classList.add('hidden');
                }

                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                document.documentElement.style.overflow = 'hidden';

                requestAnimationFrame(() => {
                    overlay.classList.remove('opacity-0');
                    overlay.classList.add('opacity-100');
                    content.classList.remove('scale-95', 'opacity-0');
                    content.classList.add('scale-100', 'opacity-100');
                });
            }

            function closeModal() {
                const modal = document.getElementById('modal-socio');
                const overlay = document.getElementById('modal-overlay');
                const content = document.getElementById('modal-content');

                overlay.classList.remove('opacity-100');
                overlay.classList.add('opacity-0');
                content.classList.remove('scale-100', 'opacity-100');
                content.classList.add('scale-95', 'opacity-0');

                setTimeout(() => {
                    modal.classList.add('hidden');
                    modal.scrollTop = 0;
                    document.body.style.overflow = '';
                    document.documentElement.style.overflow = '';
                }, 300);
            }

            function initSocios() {
                const grid = document.getElementById('socios-grid');
                if (!grid || grid.dataset.ready === 'true') return;
                grid.dataset.ready = 'true';

                // Volteo de la credencial (click / teclado)
                grid.querySelectorAll('[data-socio-index]').forEach(card => {
                    const toggle = () => {
                        const flipped = card.dataset.flipped === 'true';
                        card.dataset.flipped = flipped ? 'false' : 'true';
                        card.setAttribute('aria-pressed', flipped ? 'false' : 'true');
                    };

                    card.addEventListener('click', toggle);

                    // Enter / Espacio también voltean (la tarjeta es un role="button")
                    card.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            toggle();
                        }
                    });
                });

                // "Ver perfil" abre el modal legacy y NO debe voltear la tarjeta
                grid.querySelectorAll('[data-socio-profile]').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const card = btn.closest('[data-socio-index]');
                        const index = parseInt(card.getAttribute('data-socio-index'), 10);
                        openModal(sociosData[index]);
                    });
                });

                document.getElementById('modal-close').addEventListener('click', closeModal);
                document.getElementById('modal-overlay').addEventListener('click', closeModal);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initSocios, { once: true });
            } else {
                initSocios();
            }

            // ClientRouter: vuelve a inicializar en cada navegación
            document.addEventListener('astro:page-load', initSocios);

            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
        </script>
	</body>
</html>
