---

<Layout 
    title="Galería de Memoria | Casa Museo Pozón"
    description="Explora el archivo visual de la Casa Museo Pozón. Momentos de comunidad, cultura, arqueología y transformación social en el barrio El Pozón."
>
    <section class="pt-32 pb-24 px-8 md:px-16 lg:px-24 bg-museum-cream">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-20">
                <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs mb-4 uppercase block">Archivo Visual</span>
                <h1 class="text-4xl md:text-6xl font-display text-museum-dark mb-6">Galería de Memoria</h1>
                <div class="w-24 h-1 bg-museum-gold mx-auto mb-8"></div>
                <p class="text-museum-dark/60 max-w-2xl mx-auto font-light leading-relaxed">
                    Un testimonio gráfico de nuestra labor territorial, hallazgos arqueológicos y la fuerza de la organización comunitaria en El Pozón.
                </p>
            </div>

            <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-6 space-y-6">
                {galleryImages.map(image => (
                    <div class="break-inside-avoid group relative overflow-hidden rounded-xl cursor-pointer">
                        <img 
                            src={image.src} 
                            alt={image.title} 
                            loading="lazy"
                            class="w-full h-auto grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-museum-dark/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6">
                            <span class="text-[10px] font-bold text-museum-gold uppercase tracking-widest mb-1">Archivo Museal</span>
                            <h3 class="text-white text-sm font-display leading-snug">{image.title}</h3>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Modal Placeholder (Could be enhanced with JS for full lightbox) -->
    <div id="image-modal" class="fixed inset-0 z-[200] bg-museum-dark/95 backdrop-blur-md opacity-0 invisible transition-all duration-500 flex items-center justify-center p-8">
        <button id="close-modal" class="absolute top-10 right-10 text-white/50 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="max-w-5xl w-full h-full flex flex-col items-center justify-center gap-8">
            <img id="modal-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl" />
            <h2 id="modal-title" class="text-white text-2xl font-display text-center"></h2>
        </div>
    </div>

    <script>
        function initGallery() {
            const items = document.querySelectorAll('.break-inside-avoid');
            const modal = document.getElementById('image-modal');
            const modalImg = document.getElementById('modal-img') as HTMLImageElement;
            const modalTitle = document.getElementById('modal-title');
            const closeModal = document.getElementById('close-modal');

            items.forEach(item => {
                item.addEventListener('click', () => {
                    const img = item.querySelector('img');
                    const title = item.querySelector('h3');
                    
                    if (img && modalImg && modalTitle) {
                        modalImg.src = img.src;
                        modalImg.alt = img.alt;
                        modalTitle.textContent = title?.textContent || '';
                        
                        modal?.classList.remove('invisible', 'opacity-0');
                        document.body.style.overflow = 'hidden';
                    }
                });
            });

            closeModal?.addEventListener('click', () => {
                modal?.classList.add('invisible', 'opacity-0');
                document.body.style.overflow = '';
            });

            modal?.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal?.classList.add('invisible', 'opacity-0');
                    document.body.style.overflow = '';
                }
            });
        }

        initGallery();
        document.addEventListener('astro:after-swap', initGallery);
    </script>
</Layout>
