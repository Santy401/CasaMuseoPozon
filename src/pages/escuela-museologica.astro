---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Pillars from "../components/ui/Pillars.astro";
import StickySplit from "../components/ui/StickySplit.astro";
import Quote from "../components/ui/Quote.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";

const lineas = [
    { title: "Curaduría Comunitaria", text: "Selección y organización participativa de objetos y relatos territoriales." },
    { title: "Conservación Preventiva", text: "Técnicas básicas para la preservación de archivos y piezas arqueológicas locales." },
    { title: "Mediación Cultural", text: "Formación de guías y mediadores que narren la historia con dignidad y ética." },
];
const metodologia = [
    { tag: "A", title: "Aulas Vivas", text: "Aprendizaje en las calles, plazas y patios del barrio El Pozón." },
    { tag: "C", title: "Co-creación", text: "Estudiantes y docentes construyen juntos los contenidos museográficos." },
    { tag: "O", title: "Orgánico", text: "Respeto por los ritmos y procesos culturales de la comunidad." },
    { tag: "!", title: "Impacto", text: "Resultados tangibles que benefician la resiliencia del territorio." },
];
---

<Layout
  title="Escuela de Museología | Casa Museo Pozón"
  description="Escuela de Museología — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-white font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/ASOCIATIVIDAD Y GOBERNANZA1.webp" group="Saberes" current="Escuela de museología">
      <Fragment slot="eyebrow">Formación y Ciudadanía</Fragment>
      Escuela de <span class="text-museum-gold italic">Museología</span>
      <Fragment slot="lead">Formación para la Gestión del Patrimonio Barrial: Empoderando a la comunidad como guardiana de su propia historia.</Fragment>
    </PageHero>

    <!-- 01 Propósito -->
    <Section id="proposito" tone="cream" eyebrow="Propósito Educativo">
        <Fragment slot="title">Empoderar a los <span class="text-museum-gold">Líderes y Jóvenes</span></Fragment>
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-24 items-center mb-16 md:mb-24">
            <div class="space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-dark/80">
                <p>Un espacio de formación técnica y ciudadana diseñado para empoderar a los líderes locales y jóvenes en la protección, curaduría y difusión de la memoria histórica y cultural de sus territorios.</p>
                <p class="text-base md:text-lg text-museum-dark/70">Creemos que el patrimonio no es algo estático guardado en vitrinas, sino un organismo vivo que requiere de mediadores comprometidos con la identidad de su barrio.</p>
            </div>
            <div class="relative aspect-square max-w-md mx-auto w-full rounded-[2rem] bg-white shadow-[0_40px_80px_-40px_rgba(26,26,26,0.4)] flex items-center justify-center p-8 overflow-hidden">
                <img src="/logos/escuela-museologica.jpeg" alt="Escuela de Museología" loading="lazy" class="max-w-full max-h-full object-contain" />
            </div>
        </div>
        <div class="rounded-[2rem] bg-museum-dark text-museum-cream p-8 md:p-14 mb-16 md:mb-24">
            <span class="block text-[10px] font-bold tracking-[0.4em] uppercase text-museum-gold mb-4">Nuestra Visión</span>
            <p class="font-display text-2xl md:text-4xl leading-snug text-balance">“Convertir a los habitantes en los propios guardianes y narradores de su patrimonio vivo.”</p>
        </div>
        <h3 class="text-[11px] font-bold tracking-[0.4em] uppercase text-museum-gold mb-8">Líneas de Trabajo</h3>
        <Pillars items={lineas} cols={3} />
    </Section>

    <!-- 02 Metodología -->
    <Section id="metodologia" tone="dark" eyebrow="Modelo A.C.O.">
        <Fragment slot="title">Metodología de <span class="text-museum-gold">Formación</span></Fragment>
        <StickySplit steps={metodologia} dark>
            <p class="font-light text-museum-cream/70 leading-relaxed max-w-sm">Basada en el Modelo A.C.O., nuestra escuela combina la teoría técnica con la práctica territorial directa.</p>
        </StickySplit>
    </Section>

    <CtaBand>
        <Fragment slot="title">¿Quieres ser parte de la <span class="text-museum-gold">próxima cohorte</span>?</Fragment>
        Estamos formando a la nueva generación de guardianes del patrimonio del Pozón. Inscríbete para recibir información sobre nuestros próximos talleres.
        <Fragment slot="actions">
            <Btn href="/#contacto">Quiero Participar</Btn>
            <Btn href="/pedagogia-territorial" variant="outline">Ver Pedagogía</Btn>
        </Fragment>
    </CtaBand>
</Layout>
