---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";
import YouTube from "../components/YouTube.astro";

const initialEvents = [
    {
        title: "Participación en “El Caribe Llega”",
        tag: "Institucional",
        date: "Septiembre 2025",
        text: "La Fundación participó activamente compartiendo su experiencia en gobernanza cultural para la paz y la vida digna, posicionando al Pozón como referente vivo de resistencia.",
        image: "/imagenes/participacion-caribe-1.webp"
    },
    {
        title: "Presente en Aniversario No. 57 El Pozón",
        tag: "Comunidad",
        date: "Agosto 2025",
        text: "Fiesta de identidad, tradición y alegría comunitaria donde la Fundación reafirma su compromiso con el desarrollo del territorio.",
        video: "https://youtu.be/6rW7Eq1epUA?si=T65yc7AXfTHV-TpY"
    },
    {
        title: "EL POZÓN: Un Museo Vivo",
        tag: "Encuentro Cultural",
        date: "06 Septiembre 2025",
        text: "Encuentro con el Programa Trenzando Territorio. Una jornada de sancocho ancestral, caminatas históricas y diálogos sobre liderazgo comunitario.",
        video: "https://youtu.be/WYitZwv2XzA?si=Q7k7gCahqEyeTC8l"
    },
    {
        title: "Mentoría sobre Asociatividad y Gobernanza",
        tag: "Formación",
        date: "08 Mayo 2025",
        text: "Fortalecimiento de la legitimidad institucional en el taller convocado por la Cámara de Comercio de Cartagena. Liderado por el maestro Jairo Chaparro Valderrama.",
        image: "/imagenes/mentoria-asociatividad.webp"
    },
    {
        title: "Cuando el Museo llega a tu casa",
        tag: "Patrimonio",
        date: "Abril 2025",
        text: "Visita técnica de la doctora Lucy Gómez (Museo del Oro Zenú) al Conchero de la Islita del Pozón. Puentes entre la memoria profunda y la dignidad cotidiana.",
        video: "https://youtu.be/M7NWv4rI_Ic?si=aqNZ63fXrznK4aX1"
    },
    {
        title: "1° Encuentro de Turismo Cultural Comunitario",
        tag: "Turismo",
        date: "26 Julio 2025",
        text: "Hito en la articulación de saberes que apuestan por un turismo con enfoque pedagógico. Presentación del modelo 'Cartagena Popular: El Pozón como Museo Vivo'.",
        video: "https://youtu.be/B__W-1FfCQc?si=GduzZKp3ptci07ms"
    },
    {
        title: "El Mural como puente entre ciencia y comunidad",
        tag: "Cultura & Ciencia",
        date: "Julio 2025",
        text: "Elaboración de un mural científico con el apoyo del Museo del Oro Zenú, sensibilizando sobre la preservación de especies nativas.",
        image: "/imagenes/mural-como-puente.webp"
    },
    {
        title: "Diseño hacia la Justicia Social (Bellas Artes)",
        tag: "Academia",
        date: "Junio 2025",
        text: "Estudiantes de Diseño Industrial de Bellas Artes descubren el alma de El Pozón en una experiencia transformadora.",
        video: "https://youtu.be/VexpAldtV-k?si=_Oc_WpPAwIpnvQxs"
    }
];

const secondaryEvents = [
    { title: "Encuentro Trenzando Territorio", date: "06 Sept 2025" },
    { title: "Taller de Asociatividad - Cámara de Comercio", date: "08 Mayo 2025" },
    { title: "Visita Técnica Museo del Oro Zenú", date: "Abril 2025" },
    { title: "1° Encuentro de Turismo Cultural Comunitario", date: "26 Julio 2025" },
    { title: "3° Encuentro Industrias Creativas", date: "24 Junio 2025" }
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Eventos y Noticias | Casa Museo Pozón</title>
        <ClientRouter />
	</head>
	<body class="bg-zinc-50 font-sans overflow-x-hidden">
        <SocialSidebar />
		<Navbar />
        
        <main>
            <!-- Hero Header -->
            <section class="relative min-h-[40vh] flex items-center justify-center bg-museum-dark pt-20">
                <div class="relative z-20 text-center px-8" transition:animate="fade">
                    <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs mb-8 uppercase block">Crónicas del Territorio</span>
                    <h1 class="text-6xl md:text-8xl font-display text-white mb-10 leading-none">
                        Eventos <br/> <span class="text-museum-gold italic">& Noticias</span>
                    </h1>
                </div>
            </section>

            <div class="max-w-4xl mx-auto px-8 py-20">
                <!-- Filtros Horizontal -->
                <div class="mb-20">
                    <h4 class="text-[10px] font-bold uppercase tracking-[0.3em] text-museum-dark/30 mb-8 border-b border-zinc-200 pb-4 text-center">Filtrar por Categoría</h4>
                    <nav class="flex flex-wrap justify-center gap-x-10 gap-y-4 filter-nav">
                        <button data-filter="all" class="text-xs font-bold text-museum-gold transition-all">00. Todos</button>
                        <button data-filter="Institucional" class="text-xs font-bold text-museum-dark/60 hover:text-museum-gold transition-all">01. Institucional</button>
                        <button data-filter="Comunidad" class="text-xs font-bold text-museum-dark/60 hover:text-museum-gold transition-all">02. Comunidad</button>
                        <button data-filter="Turismo" class="text-xs font-bold text-museum-dark/60 hover:text-museum-gold transition-all">03. Turismo</button>
                        <button data-filter="Patrimonio" class="text-xs font-bold text-museum-dark/60 hover:text-museum-gold transition-all">04. Patrimonio</button>
                        <button data-filter="Academia" class="text-xs font-bold text-museum-dark/60 hover:text-museum-gold transition-all">05. Academia</button>
                    </nav>
                </div>

                <div class="space-y-32">
                        {initialEvents.map(event => (
                            <article class="group event-card" data-tag={event.tag}>
                                <div class="flex flex-col md:flex-row gap-12 items-start">
                                    <div class="w-full md:w-1/2 aspect-video bg-zinc-200 rounded-[2rem] overflow-hidden shadow-2xl relative group">
                                        {event.video ? (
                                            <YouTube id={event.video} title={event.title} className="h-full w-full rounded-none shadow-none" />
                                        ) : (
                                            <img src={event.image || "https://images.unsplash.com/photo-1540575467063-178a50c2df87"} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000" />
                                        )}
                                    </div>
                                    <div class="w-full md:w-1/2">
                                        <div class="flex items-center gap-6 mb-6">
                                            <span class="text-museum-gold font-bold text-[10px] uppercase tracking-widest">{event.tag}</span>
                                            <span class="text-zinc-400 text-[10px] uppercase tracking-widest">{event.date}</span>
                                        </div>
                                        <h2 class="text-3xl font-display text-museum-dark mb-6 group-hover:text-museum-gold transition-colors">{event.title}</h2>
                                        <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-8">{event.text}</p>
                                        <a href={event.video || event.image || "/pdfs/PORTAFOLIO INSTITUCIONAL.pdf"} target="_blank" rel="noopener noreferrer" class="text-[10px] font-bold uppercase tracking-widest border-b border-museum-gold pb-1 hover:border-museum-dark transition-all">Ver Crónica / Material</a>
                                    </div>
                                </div>
                            </article>
                        ))}

                        <!-- PDF Download -->
                        <div class="bg-museum-cream/50 p-12 rounded-[3rem] border border-museum-gold/10 flex flex-col md:flex-row justify-between items-center gap-8">
                             <div>
                                 <h3 class="text-2xl font-display text-museum-dark mb-2">Información Institucional 2026</h3>
                                 <p class="text-xs text-museum-dark/50 uppercase tracking-widest">Descargar dossier de eventos y prensa</p>
                             </div>
                             <a href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" target="_blank" class="bg-museum-dark text-white px-10 py-5 rounded-sm text-[10px] font-bold tracking-widest uppercase hover:bg-museum-gold transition-all">Descargar Portafolio</a>
                        </div>
                    </div>

                </div>
            </div>

            <script>
                function initFilters() {
                    const buttons = document.querySelectorAll('.filter-nav button');
                    const cards = document.querySelectorAll('.event-card');

                    buttons.forEach(btn => {
                        btn.addEventListener('click', () => {
                            const filter = btn.getAttribute('data-filter');
                            
                            // Update active state
                            buttons.forEach(b => b.classList.replace('text-museum-gold', 'text-museum-dark/60'));
                            btn.classList.replace('text-museum-dark/60', 'text-museum-gold');

                            cards.forEach(card => {
                                const tag = card.getAttribute('data-tag');
                                if (filter === 'all' || tag.includes(filter)) {
                                    card.style.display = 'block';
                                    card.style.opacity = '0';
                                    setTimeout(() => {
                                        card.style.opacity = '1';
                                        card.style.transition = 'opacity 0.5s ease-in-out';
                                    }, 10);
                                } else {
                                    card.style.display = 'none';
                                }
                            });
                        });
                    });
                }

                initFilters();
                document.addEventListener('astro:after-swap', initFilters);
            </script>

        </main>
        
        <!-- Descriptive Footer Links Section (13 pieces) -->
        <section class="py-32 px-8 bg-zinc-50 border-t border-zinc-200">
            <div class="max-w-5xl mx-auto">
                <h2 class="text-3xl font-display text-center mb-24 uppercase tracking-widest text-museum-dark">Otras Secciones y <span class="text-museum-gold">Publicaciones</span></h2>
                
                <div class="space-y-20">
                    {[
                        { 
                            t: "MODELO DE APRENDIZAJE COMUNITARIO ORGANICO A.C.O.", 
                            d: "11.09.2025", 
                            s: "Pedagogía Decolonial como Arte Vivo, Memoria Encarnada y Dignidad Educativa desde los Saberes Afrocaribeños y Afroindígenas.",
                            path: "/pdfs/MODELO DE APRENDIZAJE COMUNITARIO ORGÁNICO.pdf"
                        },
                        { 
                            t: "PLAN ESTRATÉGICO INSTITUCIONAL", 
                            d: "12.08.2025", 
                            s: "Diagnóstico profundo del Barrio El Pozón, Cartagena de Indias. Localización, demografía y marco estratégico institucional.",
                            path: "/pdfs/PLAN ESTRATÉGICO 2026-2028.pdf"
                        },
                        { 
                            t: "POLÍTICAS PATRIMONIALES Y MUSEOLÓGICAS", 
                            d: "10.08.2025", 
                            s: "Retos y proyección cultural de una entidad que surge de un proceso comunitario de más de dos décadas.",
                            path: "/pdfs/POLITICA PATRIMONIAL.pdf"
                        },
                        { 
                            t: "RECONOCIMIENTO DEL CONCHERO", 
                            d: "06.08.2025", 
                            s: "El IPCC y la Alcaldía Mayor impulsan el reconocimiento oficial del Conchero del sector Islita.",
                            path: "/pdfs/Mariscadores_en_las_costas_del_Caribe_co.pdf"
                        },
                        { 
                            t: "PORTAFOLIO INSTITUCIONAL", 
                            d: "24.06.2025", 
                            s: "Participación estratégica de la Fundación en el Encuentro de Cartagena y Bolívar.",
                            path: "/pdfs/PORTAFOLIO INSTITUCIONAL.pdf"
                        },
                        { 
                            t: "GUÍA PEDAGÓGICA INTEGRAL", 
                            d: "22.04.2025", 
                            s: "Iniciativa que convierte el barrio en un escenario de dignificación patrimonial.",
                            path: "/pdfs/GUÍA PEDAGÓGICA INTEGRAL.pdf"
                        },
                        { 
                            t: "MUSEO COMUNITARIO QUE ASCIENDE", 
                            d: "10.09.2025", 
                            s: "Un estudio sobre la dignidad educativa desde los saberes ancestrales y la herencia afroindígena del Caribe.",
                            path: "/pdfs/MUSEO COMUNITARIO QUE ASCIENDE.pdf"
                        }
                    ].map(item => (
                        <div class="group border-l-4 border-transparent hover:border-museum-gold pl-8 transition-all duration-500">
                            <p class="text-[9px] text-zinc-400 font-bold uppercase tracking-[0.2em] mb-4">{item.d}</p>
                            <h3 class="text-2xl font-display text-museum-dark mb-6 group-hover:text-museum-gold transition-colors leading-tight uppercase">{item.t}</h3>
                            <p class="text-md font-light text-museum-dark/60 leading-relaxed mb-8 max-w-3xl">
                                {item.s}
                            </p>
                            <a href={item.path} target="_blank" class="text-[10px] font-bold uppercase tracking-[0.3em] text-museum-gold hover:text-museum-dark transition-colors inline-flex items-center gap-4">
                                Descargar PDF
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                            </a>
                        </div>
                    ))}
                    
                    <div class="pt-20 text-center">
                         <a href="/" class="group inline-flex items-center gap-6 px-12 py-6 border border-museum-dark/20 rounded-full hover:bg-museum-dark hover:text-white transition-all duration-700">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-2 transition-transform"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"/></svg>
                            <span class="text-xs font-bold uppercase tracking-[0.3em]">Volver al Inicio</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
	</body>
</html>
