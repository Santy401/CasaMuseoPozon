    },
    {
        title: "Presente en Aniversario No. 57 El Pozón",
        tag: "Comunidad",
        date: "Agosto 2025",
        text: "Fiesta de identidad, tradición y alegría comunitaria donde la Fundación reafirma su compromiso con el desarrollo del territorio.",
        video: "https://youtu.be/6rW7Eq1epUA?si=T65yc7AXfTHV-TpY"
    },
    {
        title: "EL POZÓN: Un Museo Vivo",
        tag: "Encuentro Cultural",
        date: "06 Septiembre 2025",
        text: "Encuentro con el Programa Trenzando Territorio. Una jornada de sancocho ancestral, caminatas históricas y diálogos sobre liderazgo comunitario.",
        video: "https://youtu.be/WYitZwv2XzA?si=Q7k7gCahqEyeTC8l"
    },
    {
        title: "Mentoría sobre Asociatividad y Gobernanza",
        tag: "Formación",
        date: "08 Mayo 2025",
        text: "Fortalecimiento de la legitimidad institucional en el taller convocado por la Cámara de Comercio de Cartagena. Liderado por el maestro Jairo Chaparro Valderrama.",
        image: "/imagenes/mentoria-asociatividad.webp"
    },
    {
        title: "Cuando el Museo llega a tu casa",
        tag: "Patrimonio",
        date: "Abril 2025",
        text: "Visita técnica de la doctora Lucy Gómez (Museo del Oro Zenú) al Conchero de la Islita del Pozón. Puentes entre la memoria profunda y la dignidad cotidiana.",
        video: "https://youtu.be/M7NWv4rI_Ic?si=aqNZ63fXrznK4aX1"
    },
    {
        title: "1° Encuentro de Turismo Cultural Comunitario",
        tag: "Turismo",
        date: "26 Julio 2025",
        text: "Hito en la articulación de saberes que apuestan por un turismo con enfoque pedagógico. Presentación del modelo 'Cartagena Popular: El Pozón como Museo Vivo'.",
        video: "https://youtu.be/B__W-1FfCQc?si=GduzZKp3ptci07ms"
    },
    {
        title: "El Mural como puente entre ciencia y comunidad",
        tag: "Cultura & Ciencia",
        date: "Julio 2025",
        text: "Elaboración de un mural científico con el apoyo del Museo del Oro Zenú, sensibilizando sobre la preservación de especies nativas.",
        image: "/imagenes/mural-como-puente.webp"
    },
    {
        title: "Diseño hacia la Justicia Social (Bellas Artes)",
        tag: "Academia",
        date: "Junio 2025",
        text: "Estudiantes de Diseño Industrial de Bellas Artes descubren el alma de El Pozón en una experiencia transformadora.",
        video: "https://youtu.be/VexpAldtV-k?si=_Oc_WpPAwIpnvQxs"
    }
];

const secondaryEvents = [
    { title: "Encuentro Trenzando Territorio", date: "06 Sept 2025" },
    { title: "Taller de Asociatividad - Cámara de Comercio", date: "08 Mayo 2025" },
    { title: "Visita Técnica Museo del Oro Zenú", date: "Abril 2025" },
    { title: "1° Encuentro de Turismo Cultural Comunitario", date: "26 Julio 2025" },
    { title: "3° Encuentro Industrias Creativas", date: "24 Junio 2025" }
];

const etiquetas = Array.from(new Set(initialEvents.map((e) => e.tag)));
const publicaciones = [
                        { 
                            t: "MODELO DE APRENDIZAJE COMUNITARIO ORGANICO A.C.O.", 
                            d: "11.09.2025", 
                            s: "Pedagogía Decolonial como Arte Vivo, Memoria Encarnada y Dignidad Educativa desde los Saberes Afrocaribeños y Afroindígenas.",
                            path: "/pdfs/MODELO DE APRENDIZAJE COMUNITARIO ORGÁNICO.pdf"
                        },
                        { 
                            t: "PLAN ESTRATÉGICO INSTITUCIONAL", 
                            d: "12.08.2025", 
                            s: "Diagnóstico profundo del Barrio El Pozón, Cartagena de Indias. Localización, demografía y marco estratégico institucional.",
                            path: "/pdfs/PLAN ESTRATÉGICO 2026-2028.pdf"
                        },
                        { 
                            t: "POLÍTICAS PATRIMONIALES Y MUSEOLÓGICAS", 
                            d: "10.08.2025", 
                            s: "Retos y proyección cultural de una entidad que surge de un proceso comunitario de más de dos décadas.",
                            path: "/pdfs/POLITICA PATRIMONIAL.pdf"
                        },
                        { 
                            t: "RECONOCIMIENTO DEL CONCHERO", 
                            d: "06.08.2025", 
                            s: "El IPCC y la Alcaldía Mayor impulsan el reconocimiento oficial del Conchero del sector Islita.",
                            path: "/pdfs/Mariscadores_en_las_costas_del_Caribe_co.pdf"
                        },
                        { 
                            t: "PORTAFOLIO INSTITUCIONAL", 
                            d: "24.06.2025", 
                            s: "Participación estratégica de la Fundación en el Encuentro de Cartagena y Bolívar.",
                            path: "/pdfs/PORTAFOLIO INSTITUCIONAL.pdf"
                        },
                        { 
                            t: "GUÍA PEDAGÓGICA INTEGRAL", 
                            d: "22.04.2025", 
                            s: "Iniciativa que convierte el barrio en un escenario de dignificación patrimonial.",
                            path: "/pdfs/GUÍA PEDAGÓGICA INTEGRAL.pdf"
                        },
                        { 
                            t: "MUSEO COMUNITARIO QUE ASCIENDE", 
                            d: "10.09.2025", 
                            s: "Un estudio sobre la dignidad educativa desde los saberes ancestrales y la herencia afroindígena del Caribe.",
                            path: "/pdfs/MUSEO COMUNITARIO QUE ASCIENDE.pdf"
                        }
                    ];
---

<Layout
  title="Eventos y Noticias | Casa Museo Pozón"
  description="Eventos y Noticias — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-zinc-50 font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/INDUSTRIAS CREATIVAS.webp" group="Comunidad" current="Eventos">
      <Fragment slot="eyebrow">Crónicas del Territorio</Fragment>
      Eventos <span class="text-museum-gold italic">& Noticias</span>
    </PageHero>

    <section id="cronicas" class="ui-section relative bg-museum-cream px-6 md:px-16 lg:px-24 pt-16 md:pt-24 pb-24 md:pb-32">
        <div class="max-w-7xl mx-auto">
            <header class="mb-10 md:mb-14 flex flex-wrap items-end justify-between gap-8">
                <div>
                    <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Crónicas del territorio</span>
                    <h2 class="font-display text-4xl md:text-6xl leading-[1.05]">Lo que hemos <span class="text-museum-gold">vivido</span></h2>
                </div>
                <p class="text-[10px] md:text-xs font-bold tracking-[0.3em] uppercase text-museum-dark/50"><span id="ev-count">{initialEvents.length}</span> encuentros</p>
            </header>

            <div class="ev-filters flex gap-2 overflow-x-auto pb-4 mb-10 md:mb-14 -mx-6 px-6 md:mx-0 md:px-0 md:flex-wrap" role="group" aria-label="Filtrar por categoría">
                <button type="button" data-filter="all" aria-pressed="true" class="ev-chip shrink-0 rounded-full border border-museum-dark bg-museum-dark text-museum-cream px-5 py-2.5 text-[10px] font-bold tracking-[0.2em] uppercase transition-colors">Todos</button>
                {etiquetas.map((t) => <button type="button" data-filter={t} aria-pressed="false" class="ev-chip shrink-0 rounded-full border border-museum-dark/20 text-museum-dark/70 px-5 py-2.5 text-[10px] font-bold tracking-[0.2em] uppercase hover:border-museum-gold transition-colors">{t}</button>)}
            </div>

            <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" id="ev-grid">
                {initialEvents.map((event) => (
                    <li class="event-card flex [&>*]:flex-1 [&>*]:min-w-0" data-tag={event.tag}>
                        <article data-spotlight class="pillar group relative flex flex-col overflow-hidden rounded-[1.75rem] bg-white border border-museum-dark/10 shadow-[0_25px_50px_-35px_rgba(26,26,26,0.4)] h-full">
                            <span class="pillar-glow" aria-hidden="true"></span>
                            <div class="relative aspect-video overflow-hidden bg-museum-dark">
                                {event.video
                                    ? <YouTube id={event.video} title={event.title} className="h-full w-full rounded-none shadow-none" />
                                    : <img src={event.image || "/imagenes/participacion-caribe-1.webp"} alt={event.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms]" />}
                                <span class="absolute top-4 left-4 rounded-full bg-museum-dark/85 backdrop-blur text-museum-gold px-3.5 py-1.5 text-[9px] font-bold tracking-[0.25em] uppercase">{event.tag}</span>
                            </div>
                            <div class="relative p-6 md:p-7 flex flex-col flex-1">
                                <time class="text-museum-gold font-bold text-[10px] uppercase tracking-[0.25em] mb-3">{event.date}</time>
                                <h3 class="font-display text-xl md:text-2xl leading-snug mb-3">{event.title}</h3>
                                <p class="text-sm font-light text-museum-dark/65 leading-relaxed mb-6">{event.text}</p>
                                <a href={event.video || event.image || "/pdfs/PORTAFOLIO INSTITUCIONAL.pdf"} target="_blank" rel="noopener noreferrer" class="mt-auto self-start text-[10px] font-bold uppercase tracking-[0.25em] text-museum-dark border-b border-museum-gold pb-1 hover:text-museum-gold transition-colors">Ver crónica / material →</a>
                            </div>
                        </article>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section id="dossier" class="relative overflow-hidden bg-museum-dark text-museum-cream px-6 md:px-16 lg:px-24 py-20 md:py-28">
        <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div>
                <span class="block font-bold tracking-[0.4em] text-[10px] uppercase mb-4 text-museum-gold">Prensa y eventos</span>
                <h2 class="font-display text-3xl md:text-5xl leading-tight">Información Institucional <span class="text-museum-gold">2026</span></h2>
                <p class="mt-3 font-light text-museum-cream/70">Descargar dossier de eventos y prensa</p>
            </div>
            <Btn href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" external>Descargar Portafolio</Btn>
        </div>
    </section>

    <section id="publicaciones" class="ui-section relative bg-white px-6 md:px-16 lg:px-24 py-20 md:py-32">
        <div class="max-w-7xl mx-auto">
            <header class="mb-12 md:mb-16 max-w-3xl">
                <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Biblioteca institucional</span>
                <h2 class="font-display text-4xl md:text-6xl leading-[1.05]">Otras secciones y <span class="text-museum-gold">publicaciones</span></h2>
            </header>
            <ul class="divide-y divide-museum-dark/10 border-y border-museum-dark/10">
                {publicaciones.map((item, i) => (
                    <li>
                        <a href={item.path} target="_blank" rel="noopener noreferrer" class="doc-row group grid md:grid-cols-[8rem_1fr_auto] gap-3 md:gap-10 items-center py-7 md:py-9">
                            <span class="font-display text-museum-gold/70 text-xl tabular-nums">{item.d}</span>
                            <span>
                                <span class="block font-display text-xl md:text-3xl leading-snug mb-2 group-hover:text-museum-gold transition-colors">{item.t}</span>
                                <span class="block text-sm font-light text-museum-dark/65 leading-relaxed max-w-3xl">{item.s}</span>
                            </span>
                            <span class="inline-flex items-center gap-3 text-[10px] font-bold tracking-[0.25em] uppercase text-museum-dark group-hover:text-museum-gold transition-colors">Descargar PDF <span class="w-9 h-9 rounded-full border border-current flex items-center justify-center group-hover:translate-x-1 transition-transform" aria-hidden="true">↓</span></span>
                        </a>
                    </li>
                ))}
            </ul>
            <div class="mt-14 text-center"><Btn href="/" variant="outline">Volver al Inicio</Btn></div>
        </div>
    </section>

    <script>
        function initEventFilters() {
            const chips = document.querySelectorAll<HTMLButtonElement>('.ev-chip');
            const cards = document.querySelectorAll<HTMLElement>('.event-card');
            const counter = document.getElementById('ev-count');
            chips.forEach((chip) => chip.addEventListener('click', () => {
                const f = chip.dataset.filter;
                chips.forEach((c) => {
                    const on = c === chip;
                    c.setAttribute('aria-pressed', String(on));
                    c.classList.toggle('bg-museum-dark', on);
                    c.classList.toggle('text-museum-cream', on);
                    c.classList.toggle('border-museum-dark', on);
                });
                let n = 0;
                cards.forEach((card) => {
                    const show = f === 'all' || card.dataset.tag === f;
                    card.style.display = show ? 'flex' : 'none';
                    if (show) n++;
                });
                if (counter) counter.textContent = String(n);
            }));
        }
        initEventFilters();
        document.addEventListener('astro:after-swap', initEventFilters);
    </script>
</Layout>
