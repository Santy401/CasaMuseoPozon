---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import YouTube from "../components/YouTube.astro";
import Section from "../components/ui/Section.astro";
import Checklist from "../components/ui/Checklist.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";

const narrativa = "Desde las huellas más antiguas inscritas en la tierra hasta la memoria viva que sostiene nuestra identidad actual.";
const salas = [
    {
        n: "1", etiqueta: "Sala 1 • La Tierra como Archivo Profundo", titulo: "Orígenes Arqueológicos", href: "/sala-origenes-arqueologicos",
        foto: "/galeria/61a7a181-6ce8-473f-ae36-51c755821812.webp", tono: "bg-museum-dark text-museum-cream", oscuro: true,
        eje: "El suelo como el primer documento histórico, el conchero como biblioteca material y las tecnologías ancestrales de adaptación biocultural como cimientos de la soberanía y la autoestima comunitaria.",
        ejes: [
            { title: "El Suelo Ancestral y Muestrario Técnico", text: "Sistematización, estudio y montaje interactivo de los asentamientos precolombinos en la zona estuarina." },
            { title: "Biotecnologías Prehispánicas", text: "Espacio de experimentación sobre las ciencias y artes de los primeros nativos americanos para habitar el ecosistema." },
            { title: "Un Territorio que Asciende", text: "Construcción material y visual del continuo histórico que conecta los vestigios con el poblamiento popular actual." },
        ],
        recursos: ["Explorar Catálogo", "Mapa de Hitos", "Descargar Cartilla", "Conocer Infraestructura"],
    },
    {
        n: "2", etiqueta: "Sala 2 • Fuerza Viva del Territorio", titulo: "Cultura Zenú y Memoria Ancestral", href: "/sala-cultura-zenu",
        foto: "/galeria/SALA MUSEO.webp", tono: "bg-museum-cream text-museum-dark", oscuro: false,
        eje: "La continuidad cultural como trinchera, la hibridación afroindígena como matriz de identidad y las tecnologías ancestrales del cuerpo, el tejido y el pensamiento hidráulico como guías de resistencia contemporánea.",
        ejes: [
            { title: "El Tejido Intercultural", text: "Estudio crítico e interactivo de los procesos de hibridación cultural y cimarronaje en el Caribe colombiano." },
            { title: "Tecnologías del Pensamiento Hidráulico", text: "Análisis y apropiación de los sistemas ancestrales de manejo de aguas de la cultura Zenú." },
            { title: "El Arte del Trenzado", text: "Laboratorios de investigación sobre las estéticas del tejido y los saberes corporales tradicionales." },
        ],
        recursos: ["Galería Virtual", "Herbario Digital", "Descargar Cartilla", "Conocer Infraestructura"],
    },
    {
        n: "3", etiqueta: "Sala 3 • Patrimonio y Resistencia", titulo: "Vida Cotidiana", href: "/sala-vida-cotidiana",
        foto: "/galeria/411164de-a96d-4cc9-aacc-317b66d21fbc.webp", tono: "bg-white text-museum-dark", oscuro: false,
        eje: "La microhistoria doméstica como gran narrativa, la cultura material del hogar como documento de dignidad y los oficios tradicionales como saberes de resistencia y soberanía popular.",
        ejes: [
            { title: "Arqueología Doméstica", text: "Catalogación, conservación y montaje interactivo de los objetos cotidianos que acompañaron el poblamiento." },
            { title: "Cocina Tradicional y Fogones", text: "Resguardo y experimentación de la herencia culinaria que garantizó la subsistencia en el humedal." },
            { title: "Oficios Populares y Relleno", text: "Reconstrucción interactiva de las memorias laborales de los fundadores y la épica del relleno solidario." },
        ],
        recursos: ["Galería Virtual", "Mapa de Hitos", "Recetario Transmedia", "Escuchar Fonoteca"],
    },
];
const capsulas = [
    { id: "https://youtu.be/zXxT9PXuueA?si=0teQJeEuLAwByKk4", t: "Historia Arqueológica" },
    { id: "https://youtu.be/R_joFMP_aLA?si=BZEdxPWedz1mdRw5", t: "El Legado Zenú" },
    { id: "https://youtu.be/jjuJYV3YBIQ", t: "Rostros del Pozón" },
    { id: "https://youtu.be/jrperNvuNVA", t: "El Pozón Vivo" },
];
---

<Layout
  title="Recorrido Museal | Casa Museo Pozón"
  description="Recorrido Museal — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-white font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/df86ca84-a306-4ad3-8228-797b99c5e109.webp" group="Experiencia" current="Recorrido museal">
      <Fragment slot="eyebrow">Experiencia de Memoria Ascendente</Fragment>
      Recorrido <span class="text-museum-gold">Museal</span>
      <Fragment slot="lead">Un viaje que nace en la profundidad de la tierra y florece en la identidad viva de nuestro territorio.</Fragment>
    </PageHero>

    <!-- 01 Introducción territorial -->
    <Section id="archivo-vivo" tone="cream" eyebrow="Territorio Islita">
        <Fragment slot="title">El Pozón como <span class="text-museum-gold">Archivo Vivo</span></Fragment>
        <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-12 lg:gap-24 items-center">
            <p class="font-display text-2xl md:text-4xl leading-snug text-museum-dark/90 text-balance">Nuestra exposición se fundamenta en los hallazgos del sector <strong class="text-museum-gold font-normal">La Islita</strong>, un laboratorio vivo donde la tierra conserva las huellas de más de cinco mil años de ocupación humana.</p>
            <ul class="grid grid-cols-2 gap-3">
                {["Concheros", "Prácticas de recolección", "Cerámica", "Fragmentos domésticos"].map((t, i) => (
                    <li class="rounded-2xl border border-museum-gold/40 bg-white p-5 md:p-6 flex flex-col justify-between min-h-[8.5rem]">
                        <span class="font-display text-museum-gold/60 text-2xl tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                        <span class="font-bold text-[11px] tracking-[0.2em] uppercase leading-snug">{t}</span>
                    </li>
                ))}
            </ul>
        </div>
    </Section>

    <!-- 02-04 Las tres salas -->
    {salas.map((sala) => (
        <section id={`sala-${sala.n}`} class:list={["ui-section relative py-20 md:py-32 px-6 md:px-16 lg:px-24", sala.tono]} data-tone={sala.oscuro ? "dark" : "light"}>
            <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-24">
                <div class="lg:sticky lg:top-28 self-start">
                    <span class="block font-bold tracking-[0.35em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">{sala.etiqueta}</span>
                    <h2 class="font-display text-4xl md:text-6xl leading-[1.05] mb-8 text-balance">{sala.titulo}</h2>
                    <div class="relative aspect-[4/3] rounded-[2rem] overflow-hidden mb-8 shadow-[0_40px_80px_-40px_rgba(0,0,0,0.5)]">
                        <img src={encodeURI(sala.foto)} alt={`Sala ${sala.n}: ${sala.titulo}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                        <span class="absolute left-5 bottom-3 font-display text-[7rem] leading-none text-transparent [-webkit-text-stroke:1.5px_rgb(245_240_232)] opacity-90" aria-hidden="true">{sala.n}</span>
                    </div>
                    <Btn href={sala.href} variant={sala.oscuro ? "gold" : "dark"}>Ver Sala Completa</Btn>
                </div>
                <div>
                    <blockquote class="font-display text-2xl md:text-4xl leading-snug mb-10 text-balance"><span class="text-museum-gold">“</span>{narrativa}<span class="text-museum-gold">”</span></blockquote>
                    <div class="rounded-3xl border border-current/15 p-6 md:p-8 mb-10 bg-current/[0.04]">
                        <span class="block text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold mb-3">Eje pedagógico</span>
                        <p class="font-light leading-relaxed opacity-85">{sala.eje}</p>
                    </div>
                    <Checklist items={sala.ejes} dark={sala.oscuro} cols={1} />
                    <ul class="mt-10 flex flex-wrap gap-2" aria-label="Recursos de la sala">
                        {sala.recursos.map((r) => <li class="text-[11px] font-bold tracking-[0.12em] rounded-full border border-current/25 px-4 py-2 opacity-80">{r}</li>)}
                    </ul>
                </div>
            </div>
        </section>
    ))}

    <!-- 05 Tour virtual -->
    <Section id="tour-virtual" tone="dark" eyebrow="Experiencia Inmersiva" align="center">
        <Fragment slot="title">Tour Virtual <span class="text-museum-gold">Casa Museo</span></Fragment>
        <div class="rounded-[2rem] overflow-hidden border border-museum-cream/10 shadow-[0_60px_100px_-50px_rgba(0,0,0,0.8)]">
            <YouTube id="https://youtu.be/M7NWv4rI_Ic?si=aqNZ63fXrznK4aX1" />
        </div>
    </Section>

    <!-- 06 Cápsulas -->
    <Section id="capsulas" tone="cream" eyebrow="Galería de vídeos">
        <Fragment slot="title">Cápsulas de <span class="text-museum-gold">Memoria</span></Fragment>
        <div class="grid md:grid-cols-2 gap-6 md:gap-8">
            {capsulas.map((c) => (
                <figure class="rounded-3xl overflow-hidden bg-museum-dark shadow-[0_30px_60px_-35px_rgba(26,26,26,0.6)]">
                    <YouTube id={c.id} title={c.t} />
                    <figcaption class="px-6 py-4 text-museum-cream text-[11px] font-bold tracking-[0.25em] uppercase">{c.t}</figcaption>
                </figure>
            ))}
        </div>
    </Section>

    <CtaBand>
        <Fragment slot="title">Dignificamos y proyectamos <span class="text-museum-gold">la memoria</span></Fragment>
        Descarga nuestra guía pedagógica completa y profundiza en la historia ascendente del Pozón.
        <Fragment slot="actions">
            <Btn href="/pdfs/GUÍA PEDAGÓGICA INTEGRAL.pdf" external>Descargar Guía PDF</Btn>
            <Btn href="/" variant="outline">Volver al Inicio</Btn>
        </Fragment>
    </CtaBand>
</Layout>
