---
import Layout from "../../layouts/Layout.astro";
import { socios, getSocioByCodigo, socioUrl } from "../../data/socios";
import { qrSvg } from "../../lib/qr";

export function getStaticPaths() {
  return socios.map((socio) => ({
    params: { codigo: socio.codigo },
    props: { socio },
  }));
}

const { socio } = Astro.props as { socio: (typeof socios)[number] };

// Guarda por si el slug cambia de casing o llega con caracteres escapados.
const socioResuelto = socio ?? getSocioByCodigo(Astro.params.codigo ?? "");
if (!socioResuelto) {
  return Astro.redirect("/socios");
}

const url = socioUrl(socioResuelto);
const qrGrande = qrSvg(url, { size: 224, margin: 4 });
const iniciales = socioResuelto.nombre
  .replace("LIC. ", "")
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0])
  .join("");
---

<Layout
  title={`${socioResuelto.nombre} | Socios | Casa Museo Pozón`}
  description={`Ficha de ${socioResuelto.nombre}, ${socioResuelto.rol} de la Fundación Casa Museo Pozón. Código ${socioResuelto.codigo}.`}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-[80vh] flex items-center justify-center bg-museum-dark pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-museum-dark/90 via-museum-dark to-museum-dark z-10"></div>
    <div class="absolute inset-0 opacity-20 bg-[url('/imagenes/creator.png')] bg-cover bg-center mix-blend-overlay"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-museum-gold/5 blur-3xl rounded-full pointer-events-none"></div>

    <div class="relative z-20 max-w-7xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div transition:animate="slide">
        <a href="/socios" class="inline-flex items-center gap-3 text-[9px] font-bold uppercase tracking-[0.3em] text-museum-gold/70 hover:text-museum-gold transition-colors mb-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Cuerpo Colegiado
        </a>

        <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs uppercase block mb-6">Socio {socioResuelto.estado}</span>

        <h1 class="text-5xl md:text-7xl font-display text-white leading-none mb-6">{socioResuelto.nombre}</h1>

        <p class="text-museum-gold/80 text-sm md:text-base font-bold uppercase tracking-[0.2em] mb-8">{socioResuelto.rol}</p>

        <div class="w-24 h-1 bg-museum-gold mb-10"></div>

        <div class="flex flex-wrap gap-x-12 gap-y-6">
          <div>
            <p class="text-[8px] uppercase tracking-[0.3em] text-white/30 mb-2">Código</p>
            <p class="font-mono text-xs text-museum-gold">{socioResuelto.codigo}</p>
          </div>
          <div>
            <p class="text-[8px] uppercase tracking-[0.3em] text-white/30 mb-2">Ingreso</p>
            <p class="text-xs text-white/70 italic">{socioResuelto.ingreso}</p>
          </div>
          <div>
            <p class="text-[8px] uppercase tracking-[0.3em] text-white/30 mb-2">Estado</p>
            <p class="text-xs text-white/70 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></span>
              {socioResuelto.estado}
            </p>
          </div>
        </div>
      </div>

      <!-- Retrato -->
      <div class="relative">
        <div class="relative aspect-[4/5] max-w-md mx-auto rounded-[2.5rem] overflow-hidden border border-museum-gold/20 shadow-2xl bg-museum-cream flex items-center justify-center">
          <div class="absolute inset-0 border border-museum-gold/20 m-4 rounded-[2rem] z-20 pointer-events-none"></div>
          {socioResuelto.image ? (
            <img src={socioResuelto.image} alt={socioResuelto.nombre} class="absolute inset-0 w-full h-full object-cover" />
          ) : (
            <span class="font-display text-7xl text-museum-gold/30">{iniciales}</span>
          )}
        </div>
        <div class="absolute -bottom-5 -left-5 w-24 h-24 border border-museum-gold/20 rounded-full bg-museum-gold/5 backdrop-blur-sm"></div>
      </div>
    </div>
  </section>

  <!-- ===================== CREDENCIAL + CONTENIDO ===================== -->
  <section class="py-24 md:py-32 px-8 md:px-16 bg-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16 lg:gap-20 items-start">
      <!-- Credencial digital con QR -->
      <aside class="lg:sticky lg:top-28">
        <div class="bg-museum-dark rounded-[2.5rem] p-10 text-center border border-museum-gold/20 relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-museum-dark via-museum-dark to-museum-gold/10"></div>
          <div class="relative">
            <span class="text-[8px] font-bold text-museum-gold tracking-[0.45em] uppercase block mb-8">Credencial Digital</span>

            <a href={url} class="block p-5 bg-white rounded-2xl shadow-2xl shadow-black/40 transition-transform duration-500 hover:scale-[1.02]" aria-label="Ver el QR de esta credencial">
              <div class="qr" set:html={qrGrande}></div>
            </a>

            <p class="text-base font-display text-white mt-8 leading-tight">{socioResuelto.nombre}</p>
            <p class="text-[8px] font-bold text-museum-gold/70 uppercase tracking-widest mt-2 mb-8">{socioResuelto.rol}</p>

            <p class="text-[8px] text-white/40 uppercase tracking-[0.2em] mb-2">Escanea para abrir esta ficha</p>
            <p class="text-[7px] font-mono text-white/25 tracking-wider break-all px-2 leading-relaxed">{url}</p>
          </div>
        </div>

        <a href="/socios" class="mt-8 group inline-flex items-center gap-4 w-full justify-center px-8 py-5 border border-museum-dark/15 rounded-full hover:bg-museum-dark hover:text-white transition-all duration-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-1 transition-transform"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          <span class="text-[10px] font-bold uppercase tracking-[0.25em]">Ver todos los socios</span>
        </a>
      </aside>

      <!-- Contenido -->
      <div class="lg:col-span-2">
        <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase block mb-6">Reconocimiento Simbólico</span>
        <h2 class="text-3xl md:text-5xl font-display text-museum-dark mb-8 leading-tight">
          "{socioResuelto.nombre.split(" ").slice(0, 2).join(" ")}, <span class="text-museum-gold italic">memoria viva</span> de El Pozón"
        </h2>
        <div class="w-20 h-1 bg-museum-gold mb-10"></div>
        <p class="text-base md:text-lg font-light text-museum-dark/70 leading-[1.9] italic">{socioResuelto.reconocimiento}</p>

        {socioResuelto.descripcion && (
          <div class="mt-16 pt-12 border-t border-museum-gold/10">
            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase block mb-6">Impacto Institucional</span>
            <p class="text-sm md:text-base font-light text-museum-dark/60 leading-[1.9]">{socioResuelto.descripcion}</p>
          </div>
        )}

        <div class="mt-16 pt-12 border-t border-museum-gold/10 grid grid-cols-1 sm:grid-cols-3 gap-8">
          <div>
            <p class="text-[8px] uppercase tracking-[0.3em] text-museum-dark/40 mb-2">Registro</p>
            <p class="font-mono text-[11px] text-museum-dark/70">{socioResuelto.codigo}</p>
          </div>
          <div>
            <p class="text-[8px] uppercase tracking-[0.3em] text-museum-dark/40 mb-2">Vínculo</p>
            <p class="text-[11px] text-museum-dark/70">{socioResuelto.ingreso}</p>
          </div>
          <div>
            <p class="text-[8px] uppercase tracking-[0.3em] text-museum-dark/40 mb-2">Legitimidad</p>
            <p class="text-[11px] text-museum-dark/70 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></span>
              {socioResuelto.estado}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
