---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import Inicio from "../views/Inicio.astro";
import QuienesSomos from "../views/QuienesSomos.astro";
import ModeloMuseal from "../views/ModeloMuseal.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Casa Museo Pozón</title>
        <ClientRouter />
	</head>
	<body>
		<Navbar />
        
        <main>
            <Inicio />

            <QuienesSomos />

            <ModeloMuseal />

            <section id="nodos-museales" class="py-32 px-10 bg-white">
                <h2 class="text-4xl font-display mb-8">Nodos Museales</h2>
            </section>

            <section id="recorrido-museal" class="py-32 px-10 bg-museum-cream">
                <h2 class="text-4xl font-display mb-8">Recorrido Museal</h2>
            </section>

            <section id="proyectos-sociales" class="py-32 px-10 bg-white">
                <h2 class="text-4xl font-display mb-8">Proyectos Sociales</h2>
            </section>

            <section id="portafolio" class="py-32 px-10 bg-museum-cream">
                <h2 class="text-4xl font-display mb-8">Portafolio Institucional</h2>
            </section>

            <section id="eventos" class="py-32 px-10 bg-white">
                <h2 class="text-4xl font-display mb-8">Eventos</h2>
            </section>

            <section id="representante" class="py-32 px-10 bg-museum-cream">
                <h2 class="text-4xl font-display mb-8">Representante Legal</h2>
            </section>

            <section id="contacto" class="py-32 px-10 bg-museum-dark text-museum-cream">
                <h2 class="text-4xl font-display mb-8">Contacto</h2>
            </section>
        </main>
	</body>
</html>
