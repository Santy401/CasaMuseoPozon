---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";
import Historia from "../views/Historia.astro";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Quiénes Somos | Casa Museo Pozón</title>
        <ClientRouter />
    </head>
    <body class="bg-museum-cream font-sans overflow-x-hidden">
        <SocialSidebar />
        <Navbar />

        <main>
            <!-- Hero Secction para Quiénes Somos -->
            <section
                class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-museum-dark pt-20"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-b from-museum-dark/80 to-museum-dark z-10"
                >
                </div>
                <!-- Abstract pattern background -->
                <div
                    class="absolute inset-0 opacity-10 bg-[url('/imagenes/fondo-seccion.png')] bg-cover bg-center mix-blend-overlay"
                >
                </div>

                <div
                    class="relative z-20 text-center px-8"
                    transition:animate="slide"
                >
                    <span
                        class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block"
                        >Conoce Nuestra Historia</span
                    >
                    <h1
                        class="text-6xl md:text-8xl font-display text-museum-cream mb-6"
                    >
                        Sala de la <br/> Memoria Ancestral
                    </h1>
                    <div class="w-24 h-1 bg-museum-gold mx-auto"></div>
                </div>
            </section>

            <!-- Contenido Principal -->
            <section class="py-24 max-w-5xl mx-auto px-8 lg:px-0">
                <!-- Misión -->
                <div
                    class="mb-32 flex flex-col md:flex-row gap-16 items-center"
                >
                    <div class="w-full md:w-1/2">
                        <div class="flex items-center gap-4 mb-6">
                            <span class="w-12 h-[2px] bg-museum-gold"></span>
                            <h2
                                class="text-3xl font-display text-museum-dark uppercase tracking-widest"
                            >
                                Nuestra Misión
                            </h2>
                        </div>
                        <div
                            class="space-y-6 text-museum-dark/80 font-light leading-relaxed text-lg"
                        >
                            <p>
                                La <strong>FUNDACIÓN CASA MUSEO POZÓN</strong> tiene
                                como misión revitalizar y preservar los entornos bioculturales,
                                arqueológicos, creativos y de saberes ancestrales
                                del barrio El Pozón, consolidándolo como un espacio
                                emblemático de encuentro histórico, cultural, social
                                y humano.
                            </p>
                            <p>
                                Con estrategias integrales, promovemos la
                                salvaguardia del patrimonio cultural, histórico
                                y natural, beneficiando generaciones presentes y
                                futuras mientras fomentamos una cultura de paz,
                                inclusión, respeto mutuo y diálogo entre
                                comunidades.
                            </p>
                            <p>
                                Mediante tecnologías accesibles y dinámicas,
                                impulsamos la divulgación de nuestra herencia
                                cultural, priorizando la autogestión
                                comunitaria, el desarrollo sostenible y la
                                convivencia pacífica con la naturaleza.
                            </p>
                        </div>
                    </div>
                    <!-- Imagen de la misión -->
                    <div
                        class="w-full md:w-1/2 h-96 relative rounded-2xl overflow-hidden shadow-2xl group"
                    >
                        <div
                            class="absolute inset-0 border-2 border-museum-gold/30 m-6 rounded-xl z-20 transition-transform duration-700 group-hover:scale-95 pointer-events-none"
                        >
                        </div>
                        <img
                            src="/imagenes/quienes-somos-1.png"
                            alt="Nuestra Misión - Casa Museo Pozón"
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                        />
                    </div>
                </div>

                <Historia />

                <!-- Visión -->
                <div
                    class="mb-32 flex flex-col md:flex-row-reverse gap-16 items-center"
                >
                    <div class="w-full md:w-1/2">
                        <div class="flex items-center gap-4 mb-6">
                            <span class="w-12 h-[2px] bg-museum-gold"></span>
                            <h2
                                class="text-3xl font-display text-museum-dark uppercase tracking-widest"
                            >
                                Visión 2028
                            </h2>
                        </div>
                        <div
                            class="space-y-6 text-museum-dark/80 font-light leading-relaxed text-lg relative z-10"
                        >
                            <p>
                                Aspiramos a consolidarnos para el año 2028 como
                                una organización líder y referente a nivel
                                local, regional, nacional e internacional en la
                                preservación y revitalización de los entornos
                                bioculturales, arqueológicos, creativos y de
                                saberes ancestrales del barrio El Pozón.
                            </p>
                            <p>
                                Buscamos fortalecer la diversidad cultural,
                                promover el diálogo intercultural y fomentar la
                                cohesión social como ejes centrales para el
                                desarrollo humano y el bienestar colectivo,
                                posicionando a la Fundación como un modelo
                                inspirador de gestión cultural.
                            </p>
                        </div>
                        <!-- Marca de agua de la visión -->
                        <span
                            class="hidden md:block absolute top-10 right-0 text-[12rem] font-display text-museum-gold/5 leading-none select-none pointer-events-none transform translate-x-10"
                            >28</span
                        >
                    </div>
                    <!-- Imagen de la visión -->
                    <div
                        class="w-full md:w-1/2 h-96 relative rounded-2xl overflow-hidden shadow-2xl group"
                    >
                        <div
                            class="absolute inset-0 border-2 border-museum-gold/30 m-6 rounded-xl z-20 transition-transform duration-700 group-hover:scale-95 pointer-events-none"
                        >
                        </div>
                        <img
                            src="/imagenes/quienes-somos-2.webp"
                            alt="Visión 2028 - Casa Museo Pozón"
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                        />
                    </div>
                </div>

                <!-- Objetivos Estratégicos -->
                <div class="mb-32">
                    <div class="flex items-center gap-4 mb-12">
                        <span class="w-12 h-[2px] bg-museum-gold"></span>
                        <h2 class="text-3xl font-display text-museum-dark uppercase tracking-widest">
                            Objetivos Estratégicos
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        {[
                            { title: "Revitalización Biocultural y Arqueológica", desc: "Salvaguardar y visibilizar el patrimonio natural e histórico, incluyendo el Conchero de La Islita, integrándolo a las dinámicas vivas del territorio." },
                            { title: "Fortalecimiento de la Memoria Colectiva", desc: "Reconstruir y difundir la historia oral y gráfica de El Pozón como herramienta para fomentar el sentido de pertenencia y una cultura de paz." },
                            { title: "Educación y Formación Comunitaria", desc: "Implementar estrategias pedagógicas accesibles que permitan a niños y jóvenes comprender y apropiarse de sus raíces afrocaribeñas y ancestrales." },
                            { title: "Articulación Institucional", desc: "Establecer alianzas estratégicas con universidades, entidades gubernamentales y redes de museos para potenciar los recursos y el alcance de la Fundación." },
                            { title: "Promoción del Turismo Cultural Sustentable", desc: "Posicionar a El Pozón como un destino de turismo comunitario enfocado en la dignidad, el conocimiento y el intercambio cultural directo." },
                            { title: "Sostenibilidad y Replicabilidad", desc: "Consolidar un modelo de gestión autónomo, generando ingresos propios mediante la comercialización de módulos pedagógicos e investigaciones." },
                            { title: "Innovación y Empoderamiento Digital", desc: "Crear repositorios y recursos tecnológicos que permitan preservar el acervo documental para que sea accesible a futuras generaciones globalmente." }
                        ].map((obj, i) => (
                            <div class="flex gap-6 group items-start border-b border-zinc-100 pb-8 last:border-0 md:last:border-b md:[&:nth-last-child(-n+2)]:border-0">
                                <span class="text-3xl font-display text-museum-gold/30 group-hover:text-museum-gold transition-colors pt-1">0{i+1}</span>
                                <div>
                                    <h3 class="text-lg font-bold text-museum-dark uppercase tracking-wide mb-3">{obj.title}</h3>
                                    <p class="text-museum-dark/60 font-light text-sm leading-relaxed">{obj.desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Valores -->
                <div class="mb-16">
                    <div class="text-center mb-16 relative">
                        <h2
                            class="text-4xl font-display text-museum-dark mb-6 relative z-10"
                        >
                            Valores Corporativos
                        </h2>
                        <div
                            class="w-24 h-1 bg-museum-gold mx-auto relative z-10"
                        >
                        </div>
                        <!-- Decorative text behind -->
                        <span
                            class="hidden md:block absolute top-0 left-1/2 -translate-x-1/2 -translate-y-8 text-[6rem] md:text-[6rem] font-display text-zinc-100 whitespace-nowrap -z-10 select-none"
                            >PRINCIPIOS</span
                        >
                    </div>

                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                    >
                        <!-- Valor 1 -->
                        <div
                            class="bg-white p-8 rounded-2xl shadow-xl border border-zinc-100 hover:border-museum-gold/50 transition-all duration-300 hover:-translate-y-2 group"
                        >
                            <div
                                class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-6 group-hover:scale-110 transition-transform shadow-inner"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-landmark"
                                    ><line x1="3" y1="22" x2="21" y2="22"
                                    ></line><line x1="6" y1="18" x2="6" y2="11"
                                    ></line><line
                                        x1="10"
                                        y1="18"
                                        x2="10"
                                        y2="11"></line><line
                                        x1="14"
                                        y1="18"
                                        x2="14"
                                        y2="11"></line><line
                                        x1="18"
                                        y1="18"
                                        x2="18"
                                        y2="11"></line><polygon
                                        points="12 2 20 7 4 7 12 2"
                                    ></polygon></svg
                                >
                            </div>
                            <h3
                                class="font-display text-xl text-museum-dark mb-4 group-hover:text-museum-gold transition-colors"
                            >
                                Preservación
                            </h3>
                            <p class="text-museum-dark/70 font-light text-sm">
                                Compromiso activo con la conservación y
                                protección del patrimonio cultural, histórico y
                                artístico de El Pozón y sus tradiciones.
                            </p>
                        </div>

                        <!-- Valor 2 -->
                        <div
                            class="bg-white p-8 rounded-2xl shadow-xl border border-zinc-100 hover:border-museum-gold/50 transition-all duration-300 hover:-translate-y-2 group"
                        >
                            <div
                                class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-6 group-hover:scale-110 transition-transform shadow-inner"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-handshake"
                                    ><path d="m11 17 2 2 6-6"></path><path
                                        d="m18 10 1-1a2 2 0 0 0-3-3l-7 7a2 2 0 0 0-.6 1.4V15a1 1 0 0 0 1 1h1.6a2 2 0 0 0 1.4-.6Z"
                                    ></path><path
                                        d="m18 10 1-1a2 2 0 0 0-3-3l-7 7a2 2 0 0 0-.6 1.4V15a1 1 0 0 0 1 1h1.6a2 2 0 0 0 1.4-.6Z"
                                    ></path><path
                                        d="M22 6a2 2 0 0 0-3-3l-2.4 2.4a2 2 0 0 0 0 2.8L18.4 10"
                                    ></path><path d="M22 10.5 18.9 7.4"
                                    ></path><path
                                        d="M10 22a2 2 0 0 0-3-3l-3.3-3.3a2.5 2.5 0 0 1 0-3.5l1.1-1.1"
                                    ></path><path d="M10.5 22 7.4 18.9"
                                    ></path><path
                                        d="M6 22a2 2 0 0 1-3-3l2.4-2.4a2.2 2.2 0 0 1 3.2 0l4.5 4.5"
                                    ></path><path d="M10.5 15.6 15.6 10.5"
                                    ></path></svg
                                >
                            </div>
                            <h3
                                class="font-display text-xl text-museum-dark mb-4 group-hover:text-museum-gold transition-colors"
                            >
                                Inclusión
                            </h3>
                            <p class="text-museum-dark/70 font-light text-sm">
                                Fomentar un entorno equitativo y de diversidad.
                                Promoviendo la interacción y el entendimiento
                                mutuo entre culturas.
                            </p>
                        </div>

                        <!-- Valor 3 -->
                        <div
                            class="bg-white p-8 rounded-2xl shadow-xl border border-zinc-100 hover:border-museum-gold/50 transition-all duration-300 hover:-translate-y-2 group"
                        >
                            <div
                                class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-6 group-hover:scale-110 transition-transform shadow-inner"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-lightbulb"
                                    ><path
                                        d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .5 2.2 1.5 3.1.7.8 1.3 1.5 1.5 2.5"
                                    ></path><path d="M9 18h6"></path><path
                                        d="M10 22h4"></path></svg
                                >
                            </div>
                            <h3
                                class="font-display text-xl text-museum-dark mb-4 group-hover:text-museum-gold transition-colors"
                            >
                                Innovación
                            </h3>
                            <p class="text-museum-dark/70 font-light text-sm">
                                Integrar herramientas tecnológicas para
                                potenciar nuevas formas accesibles de divulgar
                                el patrimonio ancestral.
                            </p>
                        </div>

                        <!-- Valor 4 -->
                        <div
                            class="bg-white p-8 rounded-2xl shadow-xl border border-zinc-100 hover:border-museum-gold/50 transition-all duration-300 hover:-translate-y-2 group"
                        >
                            <div
                                class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-6 group-hover:scale-110 transition-transform shadow-inner"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-sprout"
                                    ><path d="M7 20h10"></path><path
                                        d="M10 20c5.5-2.5 8-6.4 8-12"
                                    ></path><path d="M13 6.1s4.5 7 3 10"
                                    ></path><path d="M18 8c3.1 3 5 1 5 1"
                                    ></path><path d="M10 20c-5.5-2.5-8-6.4-8-12"
                                    ></path><path d="M7 6.1s-4.5 7-3 10"
                                    ></path><path d="M6 8c-3.1 3-5 1-5 1"
                                    ></path><path d="M12 10v10"></path></svg
                                >
                            </div>
                            <h3
                                class="font-display text-xl text-museum-dark mb-4 group-hover:text-museum-gold transition-colors"
                            >
                                Sostenibilidad
                            </h3>
                            <p class="text-museum-dark/70 font-light text-sm">
                                Prácticas responsables que equilibren el
                                desarrollo con la protección del entorno natural
                                y el legado cultural.
                            </p>
                        </div>

                        <!-- Valor 5 -->
                        <div
                            class="bg-white p-8 rounded-2xl shadow-xl border border-zinc-100 hover:border-museum-gold/50 transition-all duration-300 hover:-translate-y-2 group"
                        >
                            <div
                                class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-6 group-hover:scale-110 transition-transform shadow-inner"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-shield-check"
                                    ><path
                                        d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"
                                    ></path><path d="m9 12 2 2 4-4"></path></svg
                                >
                            </div>
                            <h3
                                class="font-display text-xl text-museum-dark mb-4 group-hover:text-museum-gold transition-colors"
                            >
                                Empoderamiento
                            </h3>
                            <p class="text-museum-dark/70 font-light text-sm">
                                Involucrar activamente a la comunidad en el
                                diseño y ejecución de todos los proyectos
                                institucionales.
                            </p>
                        </div>

                        <!-- Valor 6 -->
                        <div
                            class="bg-white p-8 rounded-2xl shadow-xl border border-zinc-100 hover:border-museum-gold/50 transition-all duration-300 hover:-translate-y-2 group"
