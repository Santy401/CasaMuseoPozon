                            <div
                                class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-6 group-hover:scale-110 transition-transform shadow-inner"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="lucide lucide-scale"
                                    ><path
                                        d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"
                                    ></path><path
                                        d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"
                                    ></path><path d="M7 21h10"></path><path
                                        d="M12 3v18"></path><path d="M3 7h18"
                                    ></path></svg
                                >
                            </div>
                            <h3
                                class="font-display text-xl text-museum-dark mb-4 group-hover:text-museum-gold transition-colors"
                            >
                                Transparencia
                            </h3>
                            <p class="text-museum-dark/70 font-light text-sm">
                                Gestión ética, abierta, confiable y responsable,
                                asegurando así el impacto positivo a largo
                                plazo.
                            </p>
                        </div>
                    </div>
                </div>

                <div
                    class="text-center mt-20 mb-10 border-t border-museum-gold/20 pt-16 flex flex-col md:flex-row justify-center gap-6"
                >
                    <a
                        href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf"
                        target="_blank"
                        class="inline-block bg-museum-gold text-museum-dark px-10 py-5 rounded-sm text-xs font-bold tracking-[0.2em] uppercase hover:bg-white transition-all duration-500 shadow-xl"
                    >
                        Descargar Portafolio Institucional
                    </a>
                    <a
                        href="/pdfs/PLAN ESTRATÉGICO 2026-2028.pdf"
                        target="_blank"
                        class="inline-block bg-museum-dark text-white px-10 py-5 rounded-sm text-xs font-bold tracking-[0.2em] uppercase hover:bg-museum-gold transition-all duration-500 shadow-xl"
                    >
                        Transparencia / Gestión
                    </a>
                    <a
                        href="/"
                        class="inline-block border border-museum-dark/30 text-museum-dark bg-transparent px-10 py-5 rounded-sm text-xs font-bold tracking-[0.2em] uppercase hover:bg-museum-dark hover:text-white transition-all duration-500 shadow-sm hover:shadow-xl hover:shadow-museum-dark/10 ring-1 ring-transparent hover:ring-museum-dark"
