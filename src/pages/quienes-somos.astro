---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Linea from "../views/Linea.astro";
import Section from "../components/ui/Section.astro";
import Pillars from "../components/ui/Pillars.astro";
import Checklist from "../components/ui/Checklist.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";

const objetivos = [
    { title: "Revitalización Biocultural y Arqueológica", text: "Salvaguardar y visibilizar el patrimonio natural e histórico, incluyendo el Conchero de La Islita, integrándolo a las dinámicas vivas del territorio." },
    { title: "Fortalecimiento de la Memoria Colectiva", text: "Reconstruir y difundir la historia oral y gráfica de El Pozón como herramienta para fomentar el sentido de pertenencia y una cultura de paz." },
    { title: "Educación y Formación Comunitaria", text: "Implementar estrategias pedagógicas accesibles que permitan a niños y jóvenes comprender y apropiarse de sus raíces afrocaribeñas y ancestrales." },
    { title: "Articulación Institucional", text: "Establecer alianzas estratégicas con universidades, entidades gubernamentales y redes de museos para potenciar los recursos y el alcance de la Fundación." },
    { title: "Promoción del Turismo Cultural Sustentable", text: "Posicionar a El Pozón como un destino de turismo comunitario enfocado en la dignidad, el conocimiento y el intercambio cultural directo." },
    { title: "Sostenibilidad y Replicabilidad", text: "Consolidar un modelo de gestión autónomo, generando ingresos propios mediante la comercialización de módulos pedagógicos e investigaciones." },
    { title: "Innovación y Empoderamiento Digital", text: "Crear repositorios y recursos tecnológicos que permitan preservar el acervo documental para que sea accesible a futuras generaciones globalmente." },
];
const valores = [
    { title: "Preservación", text: "Compromiso activo con la conservación y protección del patrimonio cultural, histórico y artístico de El Pozón y sus tradiciones.", icon: '<line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7 12 2"/>' },
    { title: "Inclusión", text: "Fomentar un entorno equitativo y de diversidad. Promoviendo la interacción y el entendimiento mutuo entre culturas.", icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
    { title: "Innovación", text: "Integrar herramientas tecnológicas para potenciar nuevas formas accesibles de divulgar el patrimonio ancestral.", icon: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>' },
    { title: "Sostenibilidad", text: "Prácticas responsables que equilibren el desarrollo con la protección del entorno natural y el legado cultural.", icon: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>' },
    { title: "Empoderamiento", text: "Involucrar activamente a la comunidad en el diseño y ejecución de todos los proyectos institucionales.", icon: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>' },
    { title: "Transparencia", text: "Gestión ética, abierta, confiable y responsable, asegurando así el impacto positivo a largo plazo.", icon: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>' },
];
---

<Layout
  title="Quiénes Somos | Casa Museo Pozón"
  description="Misión, visión 2028, historia, objetivos estratégicos y valores de la Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-museum-cream font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/SALA MUSEO.webp" group="Institucional" current="Quiénes somos">
        <Fragment slot="eyebrow">Conoce Nuestra Historia</Fragment>
        Sala de la Memoria Ancestral
    </PageHero>

    <!-- 01 Misión -->
    <Section id="mision" tone="cream" eyebrow="Quiénes somos">
        <Fragment slot="title">Nuestra <span class="text-museum-gold">Misión</span></Fragment>
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-24 items-center">
            <div class="space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-dark/80">
                <p>La <strong class="font-bold text-museum-dark">FUNDACIÓN CASA MUSEO POZÓN</strong> tiene como misión revitalizar y preservar los entornos bioculturales, arqueológicos, creativos y de saberes ancestrales del barrio El Pozón, consolidándolo como un espacio emblemático de encuentro histórico, cultural, social y humano.</p>
                <p class="text-base md:text-lg text-museum-dark/70">Con estrategias integrales, promovemos la salvaguardia del patrimonio cultural, histórico y natural, beneficiando generaciones presentes y futuras mientras fomentamos una cultura de paz, inclusión, respeto mutuo y diálogo entre comunidades.</p>
                <p class="text-base md:text-lg text-museum-dark/70">Mediante tecnologías accesibles y dinámicas, impulsamos la divulgación de nuestra herencia cultural, priorizando la autogestión comunitaria, el desarrollo sostenible y la convivencia pacífica con la naturaleza.</p>
            </div>
            <div class="relative aspect-[4/5] rounded-[2rem] overflow-hidden shadow-[0_50px_90px_-45px_rgba(26,26,26,0.55)]">
                <img src="/imagenes/quienes-somos-1.png" alt="Nuestra Misión - Casa Museo Pozón" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute inset-4 rounded-[1.5rem] border border-museum-gold/40 pointer-events-none"></div>
            </div>
        </div>
    </Section>

    <!-- 02 Historia -->
    <Linea />

    <!-- 03 Visión -->
    <Section id="vision" tone="dark" eyebrow="Hacia dónde vamos">
        <Fragment slot="title">Visión <span class="text-museum-gold">2028</span></Fragment>
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 items-center">
            <div class="relative aspect-[4/5] rounded-[2rem] overflow-hidden order-2 lg:order-1">
                <img src="/imagenes/quienes-somos-2.webp" alt="Visión 2028 - Casa Museo Pozón" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-museum-dark/60 to-transparent"></div>
                <span class="absolute left-6 bottom-2 font-display text-[clamp(7rem,18vw,13rem)] leading-none text-transparent [-webkit-text-stroke:1.5px_rgb(196_160_82)]" aria-hidden="true">28</span>
            </div>
            <div class="order-1 lg:order-2 space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-cream/85">
                <p>Aspiramos a consolidarnos para el año 2028 como una organización líder y referente a nivel local, regional, nacional e internacional en la preservación y revitalización de los entornos bioculturales, arqueológicos, creativos y de saberes ancestrales del barrio El Pozón.</p>
                <p class="text-base md:text-lg text-museum-cream/70">Buscamos fortalecer la diversidad cultural, promover el diálogo intercultural y fomentar la cohesión social como ejes centrales para el desarrollo humano y el bienestar colectivo, posicionando a la Fundación como un modelo inspirador de gestión cultural.</p>
            </div>
        </div>
    </Section>

    <!-- 04 Objetivos -->
    <Section id="objetivos" tone="white" eyebrow="Nuestra hoja de ruta">
        <Fragment slot="title">Objetivos <span class="text-museum-gold">Estratégicos</span></Fragment>
        <Checklist items={objetivos} />
    </Section>

    <!-- 05 Valores -->
    <Section id="valores" tone="cream" eyebrow="Principios" align="center">
        <Fragment slot="title">Valores <span class="text-museum-gold">Corporativos</span></Fragment>
        <Pillars items={valores} cols={3} />
    </Section>

    <CtaBand>
        <Fragment slot="title">Transparencia y gestión <span class="text-museum-gold">abierta</span></Fragment>
        Conoce el portafolio institucional de la Fundación.
        <Fragment slot="actions">
            <Btn href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" external>Descargar Portafolio Institucional</Btn>
            <Btn href="/" variant="outline">Volver a Inicio</Btn>
        </Fragment>
    </CtaBand>
</Layout>
