---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Btn from "../components/ui/Btn.astro";
const documents = [
  {
    title: "CERTIFICADO SIMCO 2026",
    subtitle: "Registro Nacional de Museos - SIMCO",
    date: "08.05.2026",
    slug: "2026 Cert SIMCO Reg Casa Museo Pozon.pdf",
    category: "Legal",
  },
  {
    title: "MODELO DE APRENDIZAJE COMUNITARIO ORGANICO A.C.O.",
    subtitle: "Pedagogía Decolonial como Arte Vivo",
    date: "11.09.2025",
    slug: "MODELO DE APRENDIZAJE COMUNITARIO ORGÁNICO.pdf",
    category: "Pedagogía",
  },
  {
    title: "PORTAFOLIO INSTITUCIONAL",
    subtitle: "Resumen de Gestión y Proyección Museal",
    date: "2026",
    slug: "PORTAFOLIO INSTITUCIONAL.pdf",
    category: "Institucional",
  },
  {
    title: "HIMNO DEL BARRIO EL POZÓN",
    subtitle: "Tierra de esperanza y sueños",
    date: "10.08.2025",
    slug: "HIMNO DEL POZÓN.pdf",
    category: "Símbolos",
  },
  {
    title: "POLITICA PATRIMONIAL",
    subtitle: "La historia detrás de la Fundación",
    date: "10.08.2025",
    slug: "POLITICA PATRIMONIAL.pdf",
    category: "Identidad",
  },
  {
    title: "MUSEO COMUNITARIO QUE ASCIENDE",
    subtitle: "Pedagogía Comunitaria y Cátedra de Identidad",
    date: "10.08.2025",
    slug: "MUSEO COMUNITARIO QUE ASCIENDE.pdf",
    category: "Educación",
  },
];
const destacados = [
  { k: "Portafolio Pozón", href: "/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" },
  { k: "Plan Operativo", href: "/pdfs/PLAN ESTRATÉGICO 2026-2028.pdf" },
  { k: "Certificado SIMCO", href: "/pdfs/2026 Cert SIMCO Reg Casa Museo Pozon.pdf" },
];
const categorias = Array.from(new Set(documents.map((d) => d.category)));
---

<Layout
  title="Portafolio Institucional | Casa Museo Pozón"
  description="Portafolio Institucional — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-zinc-50 font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/PRESENTACION METODOLOGIA MUSEAL-0.webp" group="Institucional" current="Portafolio">
      <Fragment slot="eyebrow">Documentación Estratégica</Fragment>
      Portafolio <span class="text-museum-gold italic">Digital</span>
    </PageHero>

    <section id="destacados" class="ui-section relative bg-museum-dark text-museum-cream px-6 md:px-16 lg:px-24 py-20 md:py-28">
        <div class="max-w-7xl mx-auto">
            <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Los tres imprescindibles</span>
            <h2 class="font-display text-4xl md:text-6xl leading-[1.05] mb-12 md:mb-16">Descargas <span class="text-museum-gold">destacadas</span></h2>
            <ul class="grid md:grid-cols-3 gap-5 md:gap-6">
                {destacados.map((d, i) => (
                    <li class="flex [&>*]:flex-1 [&>*]:min-w-0">
                        <a href={d.href} target="_blank" rel="noopener noreferrer" data-spotlight class="pillar group relative overflow-hidden rounded-[2rem] border border-museum-cream/15 bg-museum-cream/5 p-8 md:p-10 min-h-[15rem] flex flex-col justify-between text-museum-cream">
                            <span class="pillar-glow" aria-hidden="true"></span>
                            <span class="relative font-display text-5xl text-museum-gold/60 group-hover:text-museum-gold transition-colors tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                            <span class="relative">
                                <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-museum-gold mb-3">Descargar</span>
                                <span class="flex items-end justify-between gap-4"><span class="font-display text-2xl md:text-3xl leading-tight">{d.k}</span><span class="w-11 h-11 shrink-0 rounded-full bg-museum-gold text-museum-dark flex items-center justify-center group-hover:translate-y-1 transition-transform" aria-hidden="true">↓</span></span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section id="archivo" class="ui-section relative bg-museum-cream px-6 md:px-16 lg:px-24 py-20 md:py-32">
        <div class="max-w-7xl mx-auto">
            <header class="mb-10 md:mb-14 flex flex-wrap items-end justify-between gap-8">
                <div>
                    <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Archivos y Publicaciones</span>
                    <h2 class="font-display text-4xl md:text-6xl leading-[1.05]">Explorar <span class="text-museum-gold">Contenidos</span></h2>
                </div>
                <div class="flex gap-2 overflow-x-auto pb-2 -mx-6 px-6 md:mx-0 md:px-0 md:flex-wrap" role="group" aria-label="Filtrar por categoría">
                    <button type="button" data-filter="all" aria-pressed="true" class="doc-chip shrink-0 rounded-full border border-museum-dark bg-museum-dark text-museum-cream px-5 py-2.5 text-[10px] font-bold tracking-[0.2em] uppercase transition-colors">Todos</button>
                    {categorias.map((c) => <button type="button" data-filter={c} aria-pressed="false" class="doc-chip shrink-0 rounded-full border border-museum-dark/20 text-museum-dark/70 px-5 py-2.5 text-[10px] font-bold tracking-[0.2em] uppercase hover:border-museum-gold transition-colors">{c}</button>)}
                </div>
            </header>

            <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
                {documents.map((doc) => (
                    <li class="doc-card flex [&>*]:flex-1 [&>*]:min-w-0" data-cat={doc.category}>
                        <a href={`/pdfs/${doc.slug}`} target="_blank" rel="noopener noreferrer" data-spotlight class="pillar group relative overflow-hidden rounded-[1.75rem] bg-white border border-museum-dark/10 p-7 md:p-8 flex flex-col h-full shadow-[0_25px_50px_-35px_rgba(26,26,26,0.4)]">
                            <span class="pillar-glow" aria-hidden="true"></span>
                            <div class="relative flex items-center justify-between gap-4 mb-8">
                                <span class="rounded-full bg-museum-dark text-museum-gold px-3.5 py-1.5 text-[9px] font-bold tracking-[0.25em] uppercase">{doc.category}</span>
                                <time class="text-[10px] tracking-[0.2em] uppercase text-museum-dark/45">{doc.date}</time>
                            </div>
                            <h3 class="relative font-display text-xl md:text-2xl leading-snug mb-3 group-hover:text-museum-gold transition-colors">{doc.title}</h3>
                            <p class="relative text-sm font-light text-museum-dark/65 leading-relaxed mb-8">{doc.subtitle}</p>
                            <span class="relative mt-auto inline-flex items-center gap-3 text-[10px] font-bold tracking-[0.25em] uppercase text-museum-dark group-hover:text-museum-gold transition-colors">Descargar PDF <span class="group-hover:translate-y-1 transition-transform" aria-hidden="true">↓</span></span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section id="blog" class="ui-section relative bg-white px-6 md:px-16 lg:px-24 py-20 md:py-28">
        <div class="max-w-5xl mx-auto text-center">
            <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Lectura Destacada</span>
            <h2 class="font-display text-3xl md:text-5xl leading-tight mb-6 text-balance">Pedagogía Decolonial como Arte Vivo y Memoria Encarnada</h2>
            <p class="font-light text-museum-dark/70 max-w-2xl mx-auto mb-10 leading-relaxed">Un análisis profundo desde los Saberes Afrocaribeños y Afroindígenas del barrio El Pozón. Últimas publicaciones en nuestro blog corporativo.</p>
            <div class="flex flex-wrap justify-center gap-3"><Btn href="/revista" variant="dark">Continuar Leyendo</Btn><Btn href="/" variant="outline">Volver al Inicio</Btn></div>
        </div>
    </section>

    <script>
        function initDocFilters() {
            const chips = document.querySelectorAll<HTMLButtonElement>('.doc-chip');
            const cards = document.querySelectorAll<HTMLElement>('.doc-card');
            chips.forEach((chip) => chip.addEventListener('click', () => {
                const f = chip.dataset.filter;
                chips.forEach((c) => {
                    const on = c === chip;
                    c.setAttribute('aria-pressed', String(on));
                    c.classList.toggle('bg-museum-dark', on);
                    c.classList.toggle('text-museum-cream', on);
                    c.classList.toggle('border-museum-dark', on);
                });
                cards.forEach((card) => { card.style.display = f === 'all' || card.dataset.cat === f ? 'flex' : 'none'; });
            }));
        }
        initDocFilters();
        document.addEventListener('astro:after-swap', initDocFilters);
    </script>
</Layout>
