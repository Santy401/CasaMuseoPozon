---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/navbar.astro";
import SocialSidebar from "../components/SocialSidebar.astro";
import { ClientRouter } from "astro:transitions";

const piezas = [
    { name: "Máscara Antropomorfa", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Máscara con rasgos humanos de 3.5 cm de alto × 5.5 cm de largo × 3 cm de espesor. Registrada en agosto de 2013 por Rigoberto Castro Pérez.", fig: "Fig. 05", img: "/coleccion-arqueologica/mascara-antropomorfa.png" },
    { name: "Fragmento de Máscara Antropomorfa", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Fragmento parcial de máscara con rasgos humanos. Dimensiones: 4 cm de alto × 5.5 cm de largo × 2.5 cm de espesor.", fig: "Fig. 06", img: "/coleccion-arqueologica/fragmento-mascara.png" },
    { name: "Fragmento de Recipiente — Líneas Curvas", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Alfarería tallada con motivos curvos decorativos. Dimensiones: 2 cm de alto × 3.5 cm de largo × 1.5 cm de espesor.", fig: "Fig. 07", img: "/coleccion-arqueologica/recipiente-alfareria.png" },
    { name: "Fragmento de Recipiente — Líneas Geométricas", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Alfarería con patrones geométricos de líneas verticales y horizontales. Dimensiones: 5.5 cm de alto × 8 cm de largo × 8 mm de espesor.", fig: "Fig. 08", img: "/coleccion-arqueologica/fragmento-recipiente-lineas-geometricas.png" },
    { name: "Fragmento de Recipiente — Líneas Verticales", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Fragmento de alfarería tallada con líneas verticales. Dimensiones: 5.5 cm de alto × 5.5 cm de largo × 7 mm de espesor.", fig: "Fig. 09", img: "/coleccion-arqueologica/fragmento-recipiente-lineas-verticales.png" },
    { name: "Bala de Piedra Pulida", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Esfera de piedra pulida de 8.5 cm de alto × 8 cm de largo × 7 cm de espesor. Posible proyectil o instrumento ceremonial.", fig: "Fig. 12", img: "/coleccion-arqueologica/bala-piedra-pulida.png" },
    { name: "Piedra con Hendiduras — Mortero", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Piedra con cavidades, posiblemente usada para triturar alimentos o pigmentos. Diversas dimensiones registradas.", fig: "Fig. 13-15", img: "/coleccion-arqueologica/piedra-hendiduras-mortero.png" },
    { name: "Piedra Alargada Pulida", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Herramienta lítica alargada y pulida de 13 cm de alto × 6.5 cm de largo × 2.5 cm de espesor.", fig: "Fig. 16", img: "/coleccion-arqueologica/piedra-alargada-pulida.png" },
    { name: "Fragmento de Alfarería con Imagen", origin: "Calle Los Caracoles, El Pozón", date: "Precolombino", desc: "Pieza decorada con representación figurativa. Dimensiones: 6 cm de alto × 4 cm de largo × 7 mm de espesor.", fig: "Fig. 17", img: "/coleccion-arqueologica/fragmento-alfareria-imagen.png" },
];
---

<Layout title="Colección Arqueológica | Casa Museo Pozón" description="Explora el catálogo digital de la colección arqueológica encontrada en el sector de La Islita, El Pozón. Hallazgos certificados por el ICANH.">
            <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden bg-museum-dark pt-20">
                <div class="absolute inset-0 bg-gradient-to-b from-museum-dark/80 to-museum-dark z-10"></div>
                <div class="relative z-20 text-center px-8">
                    <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Catálogo Digital — Conchero Pozonero</span>
                    <h1 class="text-5xl md:text-7xl font-display text-museum-cream mb-6">Colección Arqueológica</h1>
                    <p class="text-white/60 font-light max-w-2xl mx-auto">Vestigios del Conchero de La Islita — Calle Los Caracoles, El Pozón. Hallazgos validados por el ICANH.</p>
                    <div class="w-24 h-1 bg-museum-gold mx-auto mt-8"></div>
                </div>
            </section>

            <section class="py-24 max-w-7xl mx-auto px-8 lg:px-0">
                <div class="text-center mb-16">
                    <p class="text-museum-dark/40 text-[10px] uppercase tracking-widest font-bold mb-4 font-display">Registro Fotográfico — Agosto 2013</p>
                    <h2 class="text-3xl font-display text-museum-dark">Piezas Documentadas</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {piezas.map(p => (
                        <div class="bg-white p-8 rounded-3xl shadow-xl border border-zinc-100 group hover:shadow-2xl hover:-translate-y-1 transition-all duration-500">
                            <div class="aspect-square bg-gradient-to-br from-museum-cream to-zinc-100 rounded-2xl mb-6 flex items-center justify-center relative overflow-hidden">
                                <img src={p.img} alt={p.name} class="w-full h-full object-contain p-4" loading="lazy" />
                                <span class="absolute top-3 right-3 bg-museum-dark/80 text-museum-gold text-[9px] font-bold uppercase tracking-widest px-3 py-1 rounded-full backdrop-blur-sm">{p.fig}</span>
                            </div>
                            <h3 class="text-lg font-display text-museum-dark mb-2 group-hover:text-museum-gold transition-colors leading-tight">{p.name}</h3>
                            <div class="flex flex-wrap items-center gap-2 mb-4">
                                <span class="text-[8px] bg-museum-cream text-museum-dark px-2 py-1 uppercase tracking-widest font-bold rounded-sm">{p.origin}</span>
                                <span class="text-[8px] border border-museum-gold text-museum-gold px-2 py-1 uppercase tracking-widest font-bold rounded-sm">{p.date}</span>
                            </div>
                            <p class="text-sm font-light text-museum-dark/60 leading-relaxed">{p.desc}</p>
                        </div>
                    ))}
                </div>
                
                <div class="mt-24 flex flex-col sm:flex-row items-center justify-center gap-6">
                    <!-- <a href="/pdfs/SALA DE ORÍGENES ARQUEOLÓGICOS.pdf" target="_blank" class="inline-block bg-museum-dark text-white px-10 py-5 rounded-sm text-xs font-bold tracking-[0.2em] uppercase hover:bg-museum-gold transition-all duration-500 shadow-xl">
                        Descargar Ficha Técnica
                    </a> -->
                    <a href="/pdfs/Coleciones Arqueologicas.pdf" target="_blank" class="inline-block bg-museum-gold text-white px-10 py-5 rounded-sm text-xs font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 shadow-xl">
                        Descargar Colecciones Arqueológicas
                    </a>
                </div>
            </section>
</Layout>
