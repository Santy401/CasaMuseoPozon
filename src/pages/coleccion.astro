---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ColeccionSticky from "../views/ColeccionSticky.astro";
import Section from "../components/ui/Section.astro";
import Btn from "../components/ui/Btn.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import { piezas } from "../data/piezas";
---

<Layout title="Colección Arqueológica | Casa Museo Pozón" description="Explora el catálogo digital de la colección arqueológica encontrada en el sector de La Islita, El Pozón. Hallazgos certificados por el ICANH.">
    <PageHero image="/galeria/61a7a181-6ce8-473f-ae36-51c755821812.webp" group="Experiencia" current="Colección">
      <Fragment slot="eyebrow">Catálogo Digital — Conchero Pozonero</Fragment>
      Colección Arqueológica
      <Fragment slot="lead">Vestigios del Conchero de La Islita — Calle Los Caracoles, El Pozón. Hallazgos validados por el ICANH.</Fragment>
    </PageHero>

    <ColeccionSticky />

    <Section id="catalogo" tone="white" eyebrow="Registro Fotográfico — Agosto 2013">
        <Fragment slot="title">Piezas <span class="text-museum-gold">Documentadas</span></Fragment>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 snap-row">
            {piezas.map((p) => (
                <li class="flex [&>*]:flex-1 [&>*]:min-w-0">
                    <article data-spotlight class="pillar group relative overflow-hidden rounded-[1.75rem] bg-museum-cream border border-museum-dark/10 p-6 md:p-7 flex flex-col h-full">
                        <span class="pillar-glow" aria-hidden="true"></span>
                        <div class="relative aspect-square rounded-2xl bg-white mb-6 flex items-center justify-center overflow-hidden">
                            <img src={p.img} alt={p.name} loading="lazy" class="max-w-[72%] max-h-[72%] object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-700" />
                            <span class="absolute top-3 right-3 bg-museum-dark text-museum-gold text-[9px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">{p.fig}</span>
                        </div>
                        <h3 class="relative font-display text-xl leading-tight mb-3 group-hover:text-museum-gold transition-colors">{p.name}</h3>
                        <div class="relative flex flex-wrap items-center gap-2 mb-4">
                            <span class="text-[8px] bg-museum-dark text-museum-cream px-2.5 py-1 uppercase tracking-widest font-bold rounded-full">{p.origin}</span>
                            <span class="text-[8px] border border-museum-gold text-museum-gold px-2.5 py-1 uppercase tracking-widest font-bold rounded-full">{p.date}</span>
                        </div>
                        <p class="relative text-sm font-light text-museum-dark/65 leading-relaxed">{p.desc}</p>
                    </article>
                </li>
            ))}
        </ul>
    </Section>

    <CtaBand>
        <Fragment slot="title">Hallazgos validados por el <span class="text-museum-gold">ICANH</span></Fragment>
        Vestigios del Conchero de La Islita — Calle Los Caracoles, El Pozón.
        <Fragment slot="actions"><Btn href="/pdfs/Coleciones Arqueologicas.pdf" external>Descargar Colecciones Arqueológicas</Btn></Fragment>
    </CtaBand>
</Layout>
