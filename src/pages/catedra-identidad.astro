  <!-- JavaScript to handle interactive tabs switching -->
  <script is:inline>
    function switchModule(moduleNum) {
      // Hide all content divs
      for (let i = 1; i <= 4; i++) {
        const contentDiv = document.getElementById('content-mod' + i);
        const btn = document.getElementById('btn-mod' + i);
        
        if (contentDiv) {
          if (i === moduleNum) {
            contentDiv.classList.remove('hidden', 'opacity-0', 'translate-y-4');
            contentDiv.classList.add('block', 'opacity-100', 'translate-y-0');
          } else {
            contentDiv.classList.remove('block', 'opacity-100', 'translate-y-0');
            contentDiv.classList.add('hidden', 'opacity-0', 'translate-y-4');
          }
        }
        
        if (btn) {
          if (i === moduleNum) {
            btn.classList.remove('text-museum-dark/60', 'hover:text-museum-gold');
            btn.classList.add('bg-museum-gold', 'text-white', 'shadow-md');
          } else {
            btn.classList.remove('bg-museum-gold', 'text-white', 'shadow-md');
            btn.classList.add('text-museum-dark/60', 'hover:text-museum-gold');
          }
        }
      }
    }
  </script>
