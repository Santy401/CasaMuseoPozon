---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import ModuleBlock from "../components/ui/ModuleBlock.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";
import { modulos } from "../data/catedra";

const intro = {"h2": "La Arqueología de la Autoestima", "p": "La Cátedra activa la memoria milenaria y el ecosistema de saberes colectivos de El Pozón para cimentar una ciudadanía orgánica en las juventudes. Su objetivo es transformar radicalmente la percepción del entorno: pasar del estigma de habitar un \"barrio de invasión marginal\" al orgullo profundo de reconocerse herederos y guardianes de un territorio biocultural milenario.", "steps": [["1", "Obtener", "Excavar información del territorio"], ["2", "Opinar", "Círculos de palabra y debates"], ["3", "Proponer", "Talleres de ideación y codiseño"], ["4", "Gestionar", "Acción comunitaria en Minga"], ["5", "Evaluar", "Cosecha e indexación de memorias"]]};
const acoSteps = [{"n": "1", "t": "Obtener", "x": "Excavar información del territorio"}, {"n": "2", "t": "Opinar", "x": "Círculos de palabra y debates"}, {"n": "3", "t": "Proponer", "x": "Talleres de ideación y codiseño"}, {"n": "4", "t": "Gestionar", "x": "Acción comunitaria en Minga"}, {"n": "5", "t": "Evaluar", "x": "Cosecha e indexación de memorias"}];
const tabs = ["Arqueología", "Cartografía", "Gobernanza", "Futuros"];
const tones = ["dark", "cream", "dark", "white"];
---

<Layout 
  title="Cátedra de la Identidad Barrial Pozonera | Casa Museo El Pozón"
  description="Programa de formación ciudadana decolonial y saberes bioculturales basado en el territorio y el humedal de El Pozón."
>
    <PageHero image="/galeria/1. ENCUENTRO DE INICIATIVAS DE TURISMO CULTURAL.webp" group="Saberes" current="Cátedra de identidad">
      <Fragment slot="eyebrow">Formación Ciudadana y Decolonial</Fragment>
      Cátedra de la <span class="text-museum-gold italic">Identidad Barrial Pozonera</span>
      <Fragment slot="lead">"El territorio como aula viva y la memoria como la principal herramienta de aprendizaje y formación ciudadana."</Fragment>
    </PageHero>

    <!-- 01 Propósito -->
    <Section id="proposito" tone="cream" eyebrow="Propósito Central">
        <Fragment slot="title">{intro.h2}</Fragment>
        <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-20 items-start mb-16 md:mb-24">
            <p class="font-display text-xl md:text-3xl leading-snug text-museum-dark/90 text-balance">{intro.p}</p>
            <div class="rounded-[2rem] bg-museum-dark text-museum-cream p-7 md:p-9">
                <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-museum-gold mb-4">Modelo ACO</span>
                <p class="font-display text-2xl md:text-3xl leading-snug">Obtener · Opinar · Proponer · Gestionar · Evaluar</p>
                <p class="mt-4 text-sm font-light text-museum-cream/70 leading-relaxed">La misma ruta de cinco pasos guía cada uno de los cuatro componentes.</p>
            </div>
        </div>

        <h3 class="flex items-center gap-4 text-[11px] font-bold tracking-[0.35em] uppercase text-museum-gold mb-10"><span class="w-10 h-px bg-museum-gold"></span>Línea Metodológica Común (Modelo ACO)</h3>
        <ol class="aco-steps relative grid sm:grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-10">
            <span class="hidden md:block absolute left-0 right-0 top-6 h-px bg-museum-gold/30" aria-hidden="true"></span>
            {acoSteps.map((s) => (
                <li class="relative">
                    <span class="relative z-10 flex w-12 h-12 rounded-full bg-museum-gold text-museum-dark items-center justify-center font-display text-xl mb-5 shadow-[0_0_0_8px_#f5f0e8]">{s.n}</span>
                    <h4 class="font-display text-2xl mb-2">{s.t}</h4>
                    <p class="text-sm font-light leading-relaxed text-museum-dark/70">{s.x}</p>
                </li>
            ))}
        </ol>
    </Section>

    <!-- 02 Índice del ecosistema -->
    <Section id="ecosistema" tone="white" eyebrow="Estructura Curricular">
        <Fragment slot="title">Sólida Formación por <span class="text-museum-gold">Módulos</span></Fragment>
        <Fragment slot="lead">Explora la síntesis detallada de los contenidos curriculares creados para consolidar la memoria y el liderazgo biocultural.</Fragment>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 snap-row">
            {tabs.map((t, i) => (
                <li class="flex [&>*]:flex-1 [&>*]:min-w-0">
                    <a href={`#modulo-${i + 1}`} data-spotlight class="pillar group relative overflow-hidden rounded-3xl border border-museum-dark/10 bg-museum-cream p-7 min-h-[11rem] flex flex-col justify-between">
                        <span class="pillar-glow" aria-hidden="true"></span>
                        <span class="relative font-display text-5xl text-museum-gold/50 group-hover:text-museum-gold transition-colors tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                        <span class="relative">
                            <span class="block font-display text-xl leading-snug mb-2">{t}</span>
                            <span class="inline-flex items-center gap-2 text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold">Ver síntesis <span class="group-hover:translate-y-1 transition-transform duration-500">↓</span></span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </Section>

    <!-- 03-06 Módulos -->
    {modulos.map((mod, i) => <ModuleBlock mod={mod} n={i + 1} id={`modulo-${i + 1}`} tone={tones[i]} />)}

    <CtaBand>
        <Fragment slot="title"><span class="block font-sans text-[11px] font-bold tracking-[0.4em] uppercase text-museum-gold mb-5">Inscripciones Abiertas</span>Forma Parte del Ecosistema de <span class="text-museum-gold">Saberes</span></Fragment>
        ¿Eres docente, estudiante, líder barrial o institución interesada en implementar o cursar la Cátedra de la Identidad Barrial? Escríbenos para articular esfuerzos en red.
        <Fragment slot="actions"><Btn href="/#contacto">Contactar y Articular</Btn></Fragment>
    </CtaBand>
</Layout>
