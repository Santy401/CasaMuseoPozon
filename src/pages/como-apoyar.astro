---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Btn from "../components/ui/Btn.astro";

const formas = [
    { n: "01", titulo: "Aporte Económico", icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
      texto: "Tus donaciones permiten el sostenimiento de nuestras exposiciones, la preservación del conchero y la creación de material pedagógico para niños y jóvenes.", cuenta: true, href: "/#contacto", cta: "Notificar Donación" },
    { n: "02", titulo: "Voluntariado", icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
      texto: "Buscamos estudiantes, investigadores y profesionales en historia, pedagogía, arte y comunicación que deseen donar su tiempo y talento al museo.", href: "https://wa.me/573126153148", cta: "Postularse", external: true },
    { n: "03", titulo: "Alianzas y Convenios", icon: '<path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>',
      texto: "Invitamos a fundaciones, empresas, universidades y redes culturales a formar lazos estratégicos para la ejecución conjunta de proyectos sociales y académicos.", href: "/pdfs/PORTAFOLIO INSTITUCIONAL.pdf", cta: "Descargar Portafolio", external: true },
];
---

<Layout title="Cómo Apoyar y Aliarse | Casa Museo Pozón" description="Descubre cómo puedes apoyar la misión de la Casa Museo El Pozón a través de donaciones, voluntariado o alianzas institucionales.">
    <PageHero image="/imagenes/mural-como-puente.webp" group="Institucional" current="Cómo apoyar">
      <Fragment slot="eyebrow">Únete al Propósito</Fragment>
      Cómo Apoyar
      <Fragment slot="lead">Transforma el territorio y fortalece el tejido social convirtiéndote en aliado o donante de la Fundación Casa Museo El Pozón.</Fragment>
    </PageHero>

    <Section id="formas" tone="cream" eyebrow="Tres maneras de sumar" align="center">
        <Fragment slot="title">Tu aporte <span class="text-museum-gold">florece</span> aquí</Fragment>
        <div class="grid lg:grid-cols-3 gap-6 md:gap-8 snap-row">
            {formas.map((f) => (
                <article data-spotlight class="pillar relative overflow-hidden rounded-[2rem] bg-white border border-museum-dark/10 p-8 md:p-10 flex flex-col text-left shadow-[0_30px_60px_-40px_rgba(26,26,26,0.4)]">
                    <span class="pillar-glow" aria-hidden="true"></span>
                    <div class="relative flex items-start justify-between mb-10">
                        <span class="w-14 h-14 rounded-2xl bg-museum-gold/15 text-museum-gold flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} /></span>
                        <span class="font-display text-5xl text-museum-gold/40 tabular-nums">{f.n}</span>
                    </div>
                    <h3 class="relative font-display text-3xl mb-4">{f.titulo}</h3>
                    <p class="relative font-light leading-relaxed text-museum-dark/75 mb-8">{f.texto}</p>
                    {f.cuenta && (
                        <div class="relative rounded-2xl bg-museum-dark text-museum-cream p-6 mb-8">
                            <p class="text-[10px] text-museum-gold uppercase tracking-[0.2em] mb-2 font-bold">Cuenta de Ahorros Banco Caja Social</p>
                            <p class="font-display text-3xl tracking-widest mb-1 tabular-nums">24154765394</p>
                            <p class="text-[10px] text-museum-cream/50 uppercase tracking-widest">Fundación Casa Museo Pozón</p>
                        </div>
                    )}
                    <div class="relative mt-auto"><Btn href={f.href} variant="dark" external={f.external}>{f.cta}</Btn></div>
                </article>
            ))}
        </div>
    </Section>
</Layout>
