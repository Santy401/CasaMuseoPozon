---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/navbar.astro";
import SocialSidebar from "../components/SocialSidebar.astro";
import { ClientRouter } from "astro:transitions";
---

<Layout title="Cómo Apoyar y Aliarse | Casa Museo Pozón" description="Descubre cómo puedes apoyar la misión de la Casa Museo El Pozón a través de donaciones, voluntariado o alianzas institucionales.">
            <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden bg-museum-dark pt-20">
                <div class="absolute inset-0 bg-gradient-to-b from-museum-dark/80 to-museum-dark z-10"></div>
                <div class="absolute inset-0 opacity-20 bg-[url('/MuralComoPuente.webp')] bg-cover bg-center mix-blend-overlay"></div>

                <div class="relative z-20 text-center px-8" transition:animate="slide">
                    <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Únete al Propósito</span>
                    <h1 class="text-5xl md:text-7xl font-display text-museum-cream mb-6">
                        Cómo Apoyar
                    </h1>
                    <p class="text-white/60 font-light max-w-2xl mx-auto">Transforma el territorio y fortalece el tejido social convirtiéndote en aliado o donante de la Fundación Casa Museo El Pozón.</p>
                </div>
            </section>

            <section class="py-24 max-w-6xl mx-auto px-8 lg:px-0">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Donaciones -->
                    <div class="bg-white p-12 rounded-3xl shadow-xl border border-zinc-100 flex flex-col items-center text-center group hover:-translate-y-2 transition-transform duration-500">
                        <div class="w-16 h-16 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-8">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                        </div>
                        <h3 class="text-2xl font-display text-museum-dark mb-4">Aporte Económico</h3>
                        <p class="text-sm font-light text-museum-dark/60 mb-8 leading-relaxed">
                            Tus donaciones permiten el sostenimiento de nuestras exposiciones, la preservación del conchero y la creación de material pedagógico para niños y jóvenes.
                        </p>
                        <div class="bg-museum-dark w-full p-6 rounded-2xl mb-8">
                             <p class="text-[10px] text-museum-gold uppercase tracking-[0.2em] mb-2 font-bold">Cuenta de Ahorros Banco Caja Social</p>
                             <p class="text-xl text-white font-display tracking-widest mb-1">24154765394</p>
                             <p class="text-[9px] text-white/40 uppercase">Fundación Casa Museo Pozón</p>
                        </div>
                        <a href="/#contacto" class="mt-auto text-[10px] font-bold uppercase tracking-widest border-b border-museum-gold pb-1 hover:text-museum-gold transition-colors">Notificar Donación</a>
                    </div>

                    <!-- Voluntariado -->
                    <div class="bg-white p-12 rounded-3xl shadow-xl border border-zinc-100 flex flex-col items-center text-center group hover:-translate-y-2 transition-transform duration-500">
                        <div class="w-16 h-16 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-8">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <h3 class="text-2xl font-display text-museum-dark mb-4">Voluntariado</h3>
                        <p class="text-sm font-light text-museum-dark/60 mb-8 leading-relaxed">
                            Buscamos estudiantes, investigadores y profesionales en historia, pedagogía, arte y comunicación que deseen donar su tiempo y talento al museo.
                        </p>
                        <a href="https://wa.me/573126153148" target="_blank" class="mt-auto bg-museum-gold text-white px-8 py-4 rounded-full text-[10px] font-bold tracking-widest uppercase hover:bg-museum-dark transition-colors">Postularse</a>
                    </div>

                    <!-- Alianzas Institucionales -->
                    <div class="bg-white p-12 rounded-3xl shadow-xl border border-zinc-100 flex flex-col items-center text-center group hover:-translate-y-2 transition-transform duration-500">
                        <div class="w-16 h-16 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold mb-8">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                        </div>
                        <h3 class="text-2xl font-display text-museum-dark mb-4">Alianzas y Convenios</h3>
                        <p class="text-sm font-light text-museum-dark/60 mb-8 leading-relaxed">
                            Invitamos a fundaciones, empresas, universidades y redes culturales a formar lazos estratégicos para la ejecución conjunta de proyectos sociales y académicos.
                        </p>
                        <a href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" target="_blank" class="mt-auto text-[10px] font-bold uppercase tracking-widest border-b border-museum-gold pb-1 hover:text-museum-gold transition-colors">Descargar Portafolio</a>
                    </div>
                </div>
            </section>
</Layout>
