---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";

const newsItems = [
    {
        title: "Día Internacional de los Museos: La Memoria Viva que Late en El Pozón",
        tag: "Comunidad",
        date: "17 Mayo 2026",
        text: "En el Día Internacional de los Museos, la Casa Museo Pozón se consolida como un espacio vivo de memoria y patrimonio comunitario, invitando a detener el tiempo para encontrarse con la historia profunda del territorio.",
        url: "/revista/dia-internacional-de-los-museos-memoria-viva",
        image: "https://i.ytimg.com/vi/7Yo_je8ZTPk/hqdefault.jpg"
    },
    {
        title: "Dos nuevos espacios se integran a la Red de Museos de Cartagena y Bolívar",
        tag: "Institucional",
        date: "03 Septiembre 2025",
        text: "La Fundación Casa Museo Pozón y Un Momento de Fantasía son los nuevos integrantes de la Red de Museos, fortaleciendo el ecosistema patrimonial de Cartagena y Bolívar con el respaldo del IPCC.",
        url: "https://ipcc.gov.co/dos-nuevos-espacios-se-integran-a-la-red-de-museos-de-cartagena-y-bolivar/",
        image: "https://ipcc.gov.co/wp-content/uploads/2025/09/5d93e020-3458-45df-bf27-93fe9af87197.jpeg.webp"
    },
    {
        title: "Alcaldía de Cartagena reconoce integración a la Red de Museos",
        tag: "Institucional",
        date: "03 Septiembre 2025",
        text: "La Alcaldía de Cartagena confirma oficialmente la integración de dos nuevos espacios a la Red de Museos de Cartagena y Bolívar, entre ellos la Fundación Casa Museo Pozón, consolidando el patrimonio cultural del territorio.",
        url: "https://www.cartagena.gov.co/noticias/dos-nuevos-espacios-integran-red-museos-cartagena-bolivar",
        image: "https://www.cartagena.gov.co/sites/default/files/styles/imagen_full_noticias/public/2025-08/c0ec2792-0e90-463c-97f4-6bb151ccbfab.jpeg.webp?itok=setT_nd9"
    },
    {
        title: "Educación, deporte y cultura: avances y compromisos del Distrito en El Pozón",
        tag: "Comunidad",
        date: "27 Septiembre 2025",
        text: "El alcalde Dumek Turbay presentó avances en educación, deporte, seguridad y cultura durante encuentro comunitario en El Pozón, destacando el reconocimiento a la Casa Museo como espacio de construcción de memoria histórica.",
        url: "https://www.eluniversal.com.co/cartagena/2025/09/27/educacion-deporte-y-cultura-avances-y-compromisos-del-distrito-en-el-pozon/#goog_rewarded",
        image: "https://www.eluniversal.com.co/resizer/v2/dumek-turbay-NMZAXUTG4ZAFXP3R6VEEKVM42I.jpeg?auth=af812eebc5a767d182e28ebb8a6748ce03190284ceb3456315cfd0b9bd41e301&smart=true&width=1200&height=800&quality=70"
    },
    {
        title: "Casa Museo Pozón en Instagram — Reel Destacado",
        tag: "Redes Sociales",
        date: "2025",
        text: "Descubre la vida y el trabajo de la Fundación Casa Museo Pozón a través de este reel destacado en Instagram, mostrando las actividades culturales y comunitarias del territorio pozonero.",
        url: "https://www.instagram.com/reel/DYDYO5oRX4z/?igsh=MXd6N2xuNXFvcXFrZw==",
        image: "/logos/casa-museo-pozon.png"
    },
    {
        title: "LOS ANCESTROS: Un Museo Vivo",
        tag: "Video",
        date: "2026",
        text: "Recorrido por la muestra 'Los Ancestros' en el Museo de Arte de Cartagena, un encuentro con las raíces culturales que conectan el patrimonio ancestral con las comunidades del territorio.",
        url: "https://youtu.be/TK_QyLDYoHI?si=pPMB2Pvng7ws74GC",
        image: "https://i.ytimg.com/vi/TK_QyLDYoHI/hqdefault.jpg"
    },
    {
        title: "Laboratorio Creativo Pozonero: Nodo Expresivo de Imaginarios Comunitarios",
        tag: "Video",
        date: "2026",
        text: "El Laboratorio Creativo Pozonero se presenta como nodo expresivo dentro de La Ruta del Caracol, un espacio donde los imaginarios comunitarios toman forma a través del arte y la memoria colectiva.",
        url: "https://youtu.be/EBSXKI_Ss4g?si=Von-zCO98b4DnB_D",
        image: "https://i.ytimg.com/vi/EBSXKI_Ss4g/hqdefault.jpg"
    }
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Noticias | Casa Museo Pozón</title>
        <ClientRouter />
	</head>
	<body class="bg-zinc-50 font-sans overflow-x-hidden">
        <SocialSidebar />
		<Navbar />
        
        <main>
            <!-- Hero Header -->
            <section class="relative min-h-[40vh] flex items-center justify-center bg-museum-dark pt-20">
                <div class="relative z-20 text-center px-8" transition:animate="fade">
                    <span class="text-museum-gold font-bold tracking-[0.5em] text-[10px] md:text-xs mb-8 uppercase block">Actualidad y Novedades</span>
                    <h1 class="text-6xl md:text-8xl font-display text-white mb-10 leading-none">
                        Noticias <br/> <span class="text-museum-gold italic">& Destacados</span>
                    </h1>
                </div>
            </section>

            <div class="max-w-4xl mx-auto px-8 py-20">
                <div class="space-y-32">
                        {newsItems.map(news => (
                            <article class="group event-card" data-tag={news.tag}>
                                <div class="flex flex-col md:flex-row gap-12 items-start">
                                    <div class="w-full md:w-1/2 aspect-video bg-zinc-200 rounded-[2rem] overflow-hidden shadow-2xl relative group">
                                        <img src={news.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000" />
                                    </div>
                                    <div class="w-full md:w-1/2">
                                        <div class="flex items-center gap-6 mb-6">
                                            <span class="text-museum-gold font-bold text-[10px] uppercase tracking-widest">{news.tag}</span>
                                            <span class="text-zinc-400 text-[10px] uppercase tracking-widest">{news.date}</span>
                                        </div>
                                        <h2 class="text-3xl font-display text-museum-dark mb-6 group-hover:text-museum-gold transition-colors">{news.title}</h2>
                                        <p class="text-sm font-light text-museum-dark/60 leading-relaxed mb-8">{news.text}</p>
                                        <a href={news.url} target="_blank" rel="noopener noreferrer" class="text-[10px] font-bold uppercase tracking-widest border-b border-museum-gold pb-1 hover:border-museum-dark transition-all">Leer Noticia Completa</a>
                                    </div>
                                </div>
                            </article>
                        ))}
                </div>
            </div>
        </main>
        
        <!-- Descriptive Footer Links Section -->
        <section class="py-32 px-8 bg-zinc-50 border-t border-zinc-200">
            <div class="max-w-5xl mx-auto">
                <div class="pt-20 text-center">
                     <a href="/" class="group inline-flex items-center gap-6 px-12 py-6 border border-museum-dark/20 rounded-full hover:bg-museum-dark hover:text-white transition-all duration-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-2 transition-transform"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"/></svg>
                        <span class="text-xs font-bold uppercase tracking-[0.3em]">Volver al Inicio</span>
                    </a>
                </div>
            </div>
        </section>
	</body>
</html>
