---
import PageHero from "../components/PageHero.astro";
import Layout from "../layouts/Layout.astro";
import Btn from "../components/ui/Btn.astro";
interface NewsItem {
    title: string;
    tag: string;
    date: string;
    text: string;
    url: string;
    urlAlterna?: string;
    image: string;
}

const newsItems: NewsItem[] = [
    {
        title: "Casa Museo Pozón se une a los Ángeles Somos",
        tag: "Comunidad",
        date: "02 Noviembre 2026",
        text: "La Casa Museo Pozón vivió la fiesta de Ángeles Somos junto a niños, niñas y familias del barrio. Una jornada de cantos, disfraces y comida compartida que reafirma una tradición donde la solidaridad y la memoria del territorio se encuentran.",
        url: "https://vt.tiktok.com/ZSgEYjNHE/",
        urlAlterna: "https://youtube.com/shorts/BN_WSws7OQI?si=J8HkXVQWZY0Xkzq5",
        image: "https://i.ytimg.com/vi/BN_WSws7OQI/maxresdefault.jpg"
    },
    {
        title: "Día Internacional de los Museos: La Memoria Viva que Late en El Pozón",
        tag: "Comunidad",
        date: "17 Mayo 2026",
        text: "En el Día Internacional de los Museos, la Casa Museo Pozón se consolida como un espacio vivo de memoria y patrimonio comunitario, invitando a detener el tiempo para encontrarse con la historia profunda del territorio.",
        url: "/revista/dia-internacional-de-los-museos-memoria-viva",
        image: "https://i.ytimg.com/vi/7Yo_je8ZTPk/hqdefault.jpg"
    },
    {
        title: "Dos nuevos espacios se integran a la Red de Museos de Cartagena y Bolívar",
        tag: "Institucional",
        date: "03 Septiembre 2025",
        text: "La Fundación Casa Museo Pozón y Un Momento de Fantasía son los nuevos integrantes de la Red de Museos, fortaleciendo el ecosistema patrimonial de Cartagena y Bolívar con el respaldo del IPCC.",
        url: "https://ipcc.gov.co/dos-nuevos-espacios-se-integran-a-la-red-de-museos-de-cartagena-y-bolivar/",
        image: "https://ipcc.gov.co/wp-content/uploads/2025/09/5d93e020-3458-45df-bf27-93fe9af87197.jpeg.webp"
    },
    {
        title: "Alcaldía de Cartagena reconoce integración a la Red de Museos",
        tag: "Institucional",
        date: "03 Septiembre 2025",
        text: "La Alcaldía de Cartagena confirma oficialmente la integración de dos nuevos espacios a la Red de Museos de Cartagena y Bolívar, entre ellos la Fundación Casa Museo Pozón, consolidando el patrimonio cultural del territorio.",
        url: "https://www.cartagena.gov.co/noticias/dos-nuevos-espacios-integran-red-museos-cartagena-bolivar",
        image: "https://www.cartagena.gov.co/sites/default/files/styles/imagen_full_noticias/public/2025-08/c0ec2792-0e90-463c-97f4-6bb151ccbfab.jpeg.webp?itok=setT_nd9"
    },
    {
        title: "Educación, deporte y cultura: avances y compromisos del Distrito en El Pozón",
        tag: "Comunidad",
        date: "27 Septiembre 2025",
        text: "El alcalde Dumek Turbay presentó avances en educación, deporte, seguridad y cultura durante encuentro comunitario en El Pozón, destacando el reconocimiento a la Casa Museo como espacio de construcción de memoria histórica.",
        url: "https://www.eluniversal.com.co/cartagena/2025/09/27/educacion-deporte-y-cultura-avances-y-compromisos-del-distrito-en-el-pozon/#goog_rewarded",
        image: "https://www.eluniversal.com.co/resizer/v2/dumek-turbay-NMZAXUTG4ZAFXP3R6VEEKVM42I.jpeg?auth=af812eebc5a767d182e28ebb8a6748ce03190284ceb3456315cfd0b9bd41e301&smart=true&width=1200&height=800&quality=70"
    },
    {
        title: "Casa Museo Pozón en Instagram — Reel Destacado",
        tag: "Redes Sociales",
        date: "2025",
        text: "Descubre la vida y el trabajo de la Fundación Casa Museo Pozón a través de este reel destacado en Instagram, mostrando las actividades culturales y comunitarias del territorio pozonero.",
        url: "https://www.instagram.com/reel/DYDYO5oRX4z/?igsh=MXd6N2xuNXFvcXFrZw==",
        image: "/logos/casa-museo-pozon.webp"
    },
    {
        title: "LOS ANCESTROS: Un Museo Vivo",
        tag: "Video",
        date: "2026",
        text: "Recorrido por la muestra 'Los Ancestros' en el Museo de Arte de Cartagena, un encuentro con las raíces culturales que conectan el patrimonio ancestral con las comunidades del territorio.",
        url: "https://youtu.be/TK_QyLDYoHI?si=pPMB2Pvng7ws74GC",
        image: "https://i.ytimg.com/vi/TK_QyLDYoHI/hqdefault.jpg"
    },
    {
        title: "Laboratorio Creativo Pozonero: Nodo Expresivo de Imaginarios Comunitarios",
        tag: "Video",
        date: "2026",
        text: "El Laboratorio Creativo Pozonero se presenta como nodo expresivo dentro de La Ruta del Caracol, un espacio donde los imaginarios comunitarios toman forma a través del arte y la memoria colectiva.",
        url: "https://youtu.be/EBSXKI_Ss4g?si=Von-zCO98b4DnB_D",
        image: "https://i.ytimg.com/vi/EBSXKI_Ss4g/hqdefault.jpg"
    },
    {
        title: "Arqueología y Botánica: Huellas del Poblamiento Temprano en Cartagena de Indias",
        tag: "Video",
        date: "2026",
        text: "Exploración arqueológica y botánica que revela las huellas del poblamiento temprano en Cartagena de Indias, conectando el patrimonio ancestral con la memoria del territorio.",
        url: "https://youtu.be/fzs5KQxecVk?si=KeFuhnOr848FuibC",
        image: "https://i.ytimg.com/vi/fzs5KQxecVk/hqdefault.jpg"
    }
];

const etiquetas = ["Todas", ...Array.from(new Set(newsItems.map((n) => n.tag)))];
const [destacada, ...resto] = newsItems;
const esExterno = (u: string) => /^https?:/.test(u);
---

<Layout
  title="Noticias | Casa Museo Pozón"
  description="Noticias — Fundación Casa Museo El Pozón, memoria viva y cultura comunitaria en Cartagena de Indias."
  bodyClass="bg-zinc-50 font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/IPCC Y ALCALDIA.webp" group="Comunidad" current="Noticias">
      <Fragment slot="eyebrow">Actualidad y Novedades</Fragment>
      Noticias <span class="text-museum-gold italic">& Destacados</span>
    </PageHero>

    <section id="destacada" class="ui-section relative bg-museum-cream px-6 md:px-16 lg:px-24 pt-20 md:pt-28 pb-10">
        <div class="max-w-7xl mx-auto">
            <span class="block font-bold tracking-[0.4em] text-[10px] md:text-xs uppercase mb-5 text-museum-gold">Lo más reciente</span>
            <h2 class="font-display text-4xl md:text-6xl leading-[1.05] mb-10 md:mb-14">Noticia <span class="text-museum-gold">destacada</span></h2>
            <article class="group relative overflow-hidden rounded-[2rem] md:rounded-[2.5rem] bg-museum-dark text-museum-cream min-h-[28rem] md:min-h-[34rem] flex items-end shadow-[0_50px_100px_-50px_rgba(26,26,26,0.7)]">
                <img src={destacada.image} alt={destacada.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:scale-105 transition-transform duration-[1500ms]" />
                <div class="absolute inset-0 bg-gradient-to-t from-museum-dark via-museum-dark/60 to-transparent"></div>
                <div class="relative p-7 md:p-14 max-w-3xl">
                    <div class="flex items-center gap-5 mb-5">
                        <span class="rounded-full bg-museum-gold text-museum-dark px-4 py-1.5 text-[10px] font-bold tracking-[0.25em] uppercase">{destacada.tag}</span>
                        <span class="text-[10px] tracking-[0.25em] uppercase text-museum-cream/70">{destacada.date}</span>
                    </div>
                    <h3 class="font-display text-3xl md:text-6xl leading-[1.05] mb-5 text-balance">{destacada.title}</h3>
                    <p class="font-light leading-relaxed text-museum-cream/80 mb-8 max-w-2xl">{destacada.text}</p>
                    <div class="flex flex-wrap gap-3">
                        <Btn href={destacada.url} external={esExterno(destacada.url)}>Ver noticia</Btn>
                        {destacada.urlAlterna && <Btn href={destacada.urlAlterna} external variant="outline">Ver en YouTube</Btn>}
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section id="archivo-noticias" class="ui-section relative bg-museum-cream px-6 md:px-16 lg:px-24 pt-10 pb-24 md:pb-32">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-wrap items-end justify-between gap-6 border-b border-museum-dark/10 pb-6 mb-10">
                <h2 class="font-display text-3xl md:text-5xl">Más <span class="text-museum-gold">novedades</span></h2>
                <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
                    {etiquetas.map((t, i) => (
                        <button type="button" data-filter={t} aria-pressed={i === 0} class:list={["news-chip rounded-full border px-5 py-2.5 text-[10px] font-bold tracking-[0.2em] uppercase transition-colors", i === 0 ? "bg-museum-dark text-museum-cream border-museum-dark" : "border-museum-dark/20 text-museum-dark/70 hover:border-museum-gold"]}>{t}</button>
                    ))}
                </div>
            </div>

            <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {resto.map((news) => (
                    <li class="news-card flex [&>*]:flex-1 [&>*]:min-w-0" data-tag={news.tag}>
                        <article data-spotlight class="pillar group relative flex flex-col overflow-hidden rounded-[1.75rem] bg-white border border-museum-dark/10 shadow-[0_25px_50px_-35px_rgba(26,26,26,0.4)] h-full">
                            <span class="pillar-glow" aria-hidden="true"></span>
                            <div class="relative aspect-video overflow-hidden bg-zinc-200">
                                <img src={news.image} alt={news.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover grayscale-[60%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-[1200ms]" />
                            </div>
                            <div class="relative p-6 md:p-7 flex flex-col flex-1">
                                <div class="flex items-center gap-4 mb-4">
                                    <span class="text-museum-gold font-bold text-[10px] uppercase tracking-[0.25em]">{news.tag}</span>
                                    <span class="text-museum-dark/40 text-[10px] uppercase tracking-[0.2em]">{news.date}</span>
                                </div>
                                <h3 class="font-display text-xl md:text-2xl leading-snug mb-3">{news.title}</h3>
                                <p class="text-sm font-light text-museum-dark/65 leading-relaxed mb-6 line-clamp-4">{news.text}</p>
                                <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-2">
                                    <a href={news.url} {...(esExterno(news.url) ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="text-[10px] font-bold uppercase tracking-[0.25em] text-museum-dark border-b border-museum-gold pb-1 hover:text-museum-gold transition-colors">Ver noticia →</a>
                                </div>
                            </div>
                        </article>
                    </li>
                ))}
            </ul>
            <p id="news-empty" hidden class="text-center py-16 text-museum-dark/50">No hay noticias en esta categoría.</p>
            <div class="mt-16 text-center"><Btn href="/" variant="outline">Volver al Inicio</Btn></div>
        </div>
    </section>

    <script>
        function initNewsFilter() {
            const chips = document.querySelectorAll<HTMLButtonElement>('.news-chip');
            const cards = document.querySelectorAll<HTMLElement>('.news-card');
            const empty = document.getElementById('news-empty');
            chips.forEach((chip) => chip.addEventListener('click', () => {
                const tag = chip.dataset.filter;
                chips.forEach((c) => {
                    const on = c === chip;
                    c.setAttribute('aria-pressed', String(on));
                    c.classList.toggle('bg-museum-dark', on);
                    c.classList.toggle('text-museum-cream', on);
                    c.classList.toggle('border-museum-dark', on);
                });
                let visible = 0;
                cards.forEach((card) => {
                    const show = tag === 'Todas' || card.dataset.tag === tag;
                    card.style.display = show ? 'flex' : 'none';
                    if (show) visible++;
                });
                if (empty) empty.hidden = visible > 0;
            }));
        }
        initNewsFilter();
        document.addEventListener('astro:after-swap', initNewsFilter);
    </script>
</Layout>
