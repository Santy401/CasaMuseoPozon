---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import SocialSidebar from "../components/SocialSidebar.astro";
import Navbar from "../components/navbar.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Propuesta de Valor | Casa Museo Pozón</title>
		<meta name="description" content="Conoce la propuesta de valor y el pitch deck de la Fundación Casa Museo Pozón — un modelo de justicia cognitiva, educación comunitaria y preservación patrimonial desde El Pozón, Cartagena." />
        <ClientRouter />
	</head>
	<body class="bg-museum-cream font-sans overflow-x-hidden">
        <SocialSidebar />
		<Navbar />

        <main>
            <!-- ═══════════════════════════════════════════ -->
            <!-- HERO DRAMÁTICO -->
            <!-- ═══════════════════════════════════════════ -->
            <section class="relative min-h-screen flex items-center justify-center bg-museum-dark pt-20 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-museum-dark/40 via-museum-dark/80 to-museum-dark z-10"></div>
                <div class="absolute inset-0 opacity-15 bg-[url('/imagenes/fondo-seccion.png')] bg-cover bg-center mix-blend-luminosity scale-110"></div>
                <!-- Línea decorativa vertical -->
                <div class="absolute left-1/2 top-0 w-px h-full bg-gradient-to-b from-transparent via-museum-gold/20 to-transparent z-10 hidden lg:block"></div>

                <div class="relative z-20 text-center px-8 max-w-6xl" transition:animate="fade">
                    <span class="text-museum-gold font-bold tracking-[0.5em] text-[9px] md:text-[11px] mb-10 uppercase block">Fundación Casa Museo Pozón — Código 13001-15</span>
                    <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] font-display text-white mb-8 leading-[1.05]">
                        Propuesta <br/> <span class="text-museum-gold">de Valor</span>
                    </h1>
                    <div class="w-32 h-[2px] bg-museum-gold mx-auto mb-10"></div>
                    <p class="max-w-3xl mx-auto text-museum-cream/60 text-lg md:text-xl font-light leading-relaxed mb-14">
                        Donde la tierra guarda memoria y la comunidad diseña su propio conocimiento.
                    </p>
                    <a href="#epigrafe" class="inline-flex items-center gap-3 border border-museum-gold/30 text-museum-gold px-8 py-4 rounded-full text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-gold hover:text-museum-dark transition-all duration-500">
                        Conoce Nuestra Historia
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
                    </a>
                </div>

                <!-- Scroll indicator -->
                <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 text-white/20 animate-bounce">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!-- EPÍGRAFE / CITA DE APERTURA -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="epigrafe" class="py-28 md:py-40 px-8 bg-museum-cream relative overflow-hidden">
                <!-- Decoración de fondo -->
                <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[18rem] md:text-[28rem] font-display text-museum-gold/[0.03] whitespace-nowrap select-none pointer-events-none leading-none">PITCH</span>
                
                <div class="max-w-4xl mx-auto text-center relative z-10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold/30 mx-auto mb-10"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3z"/></svg>
                    <blockquote class="text-2xl md:text-3xl lg:text-4xl font-display text-museum-dark leading-relaxed mb-10 italic">
                        "Imagina despertar un día y descubrir que en el patio de tu casa existe un tesoro arqueológico —un conchero prehispánico de gran valor patrimonial— capaz de reescribir la narrativa y la historia de tu ciudad."
                    </blockquote>
                    <div class="w-16 h-[2px] bg-museum-gold mx-auto mb-8"></div>
                    <p class="text-museum-dark/50 text-sm font-light tracking-wide">
                        Rigoberto Castro Pérez — Fundador
                    </p>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!-- EL DESCUBRIMIENTO — Storytelling visual -->
            <!-- ═══════════════════════════════════════════ -->
            <section class="py-28 md:py-36 px-8 md:px-16 lg:px-24 bg-white relative">
                <div class="max-w-7xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                        <!-- Texto -->
                        <div>
                            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">El Origen</span>
                            <div class="flex items-center gap-4 mb-8">
                                <span class="w-12 h-[2px] bg-museum-gold"></span>
                                <h2 class="text-3xl md:text-4xl font-display text-museum-dark uppercase tracking-widest">El Hallazgo</h2>
                            </div>
                            <div class="space-y-6 text-museum-dark/75 font-light leading-relaxed text-lg">
                                <p>
                                    Eso no es ficción; lo viví hace más de dos décadas. Siendo estudiante de historia, descubrí que los patrios vecinos guardaban las claves de nuestro pasado.
                                </p>
                                <p>
                                    Pero en medio de ese hallazgo, atrapado en un entorno de <strong class="text-museum-dark font-medium">abandono, silencio y exclusión</strong>, encontré algo aún más poderoso: una comunidad con una riqueza cultural inmensa, pero invisibilizada.
                                </p>
                                <p class="text-museum-dark font-medium italic border-l-2 border-museum-gold pl-6">
                                    Ahí comprendí que el verdadero patrimonio no se limita a los restos en la tierra; reside también en la memoria, los saberes, la vida cotidiana y la inmensa capacidad de una comunidad para construir su propio camino.
                                </p>
                            </div>
                        </div>
                        <!-- Imagen -->
                        <div class="relative">
                            <div class="h-[500px] relative rounded-2xl overflow-hidden shadow-2xl group">
                                <div class="absolute inset-0 border-2 border-museum-gold/20 m-5 rounded-xl z-20 transition-transform duration-700 group-hover:scale-95 pointer-events-none"></div>
                                <img src="/imagenes/quienes-somos-1.png" alt="El Hallazgo - Conchero prehispánico" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                            </div>
                            <!-- Tarjeta decorativa flotante -->
                            <div class="absolute -bottom-6 -left-6 bg-museum-dark text-white p-6 rounded-xl shadow-2xl z-30 hidden md:block">
                                <p class="text-[10px] text-museum-gold uppercase tracking-[0.2em] mb-1 font-bold">Valor Patrimonial</p>
                                <p class="text-sm font-light text-white/70">Conchero prehispánico<br/>de gran significado</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!-- LÍNEA DE TIEMPO — Cronología visual -->
            <!-- ═══════════════════════════════════════════ -->
            <section class="py-28 md:py-36 bg-museum-cream px-8 md:px-16 lg:px-24 relative overflow-hidden">
                <div class="max-w-6xl mx-auto">
                    <div class="text-center mb-20 relative">
                        <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-4 uppercase block">Nuestro Camino</span>
                        <h2 class="text-4xl md:text-5xl font-display text-museum-dark mb-6">De la Tierra a la Transformación</h2>
                        <div class="w-24 h-1 bg-museum-gold mx-auto mb-8"></div>
                        <span class="hidden md:block absolute top-0 left-1/2 -translate-x-1/2 -translate-y-12 text-[7rem] font-display text-museum-gold/[0.04] whitespace-nowrap select-none pointer-events-none">CRONOLOGÍA</span>
                    </div>

                    <!-- Timeline -->
                    <div class="relative">
                        <!-- Línea vertical central -->
                        <div class="absolute left-4 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 bg-museum-gold/20"></div>

                        <!-- Hitos -->
                        <div class="space-y-16">
                            <!-- 1. El Descubrimiento -->
                            <div class="relative flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-16">
                                <div class="md:w-1/2 md:text-right pl-12 md:pl-0">
                                    <span class="text-museum-gold font-bold tracking-[0.3em] text-[10px] uppercase">Hace más de 20 años</span>
                                    <h3 class="text-2xl font-display text-museum-dark mt-3 mb-3">El Descubrimiento</h3>
                                    <p class="text-museum-dark/60 font-light text-sm leading-relaxed">Un estudiante de historia encuentra un conchero prehispánico en los patios de El Pozón, reescribiendo la narrativa de la ciudad.</p>
                                </div>
                                <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-museum-gold flex items-center justify-center z-10 shadow-lg shadow-museum-gold/30">
                                    <div class="w-3 h-3 rounded-full bg-white"></div>
                                </div>
                                <div class="md:w-1/2 pl-12 md:pl-0"></div>
                            </div>

                            <!-- 2. La Toma de Conciencia -->
                            <div class="relative flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-16">
                                <div class="md:w-1/2 md:text-right pl-12 md:pl-0 hidden md:block"></div>
                                <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-museum-dark flex items-center justify-center z-10 shadow-lg">
                                    <div class="w-3 h-3 rounded-full bg-museum-gold"></div>
                                </div>
                                <div class="md:w-1/2 pl-12 md:pl-0">
                                    <span class="text-museum-gold font-bold tracking-[0.3em] text-[10px] uppercase">El Proceso</span>
                                    <h3 class="text-2xl font-display text-museum-dark mt-3 mb-3">La Toma de Conciencia</h3>
                                    <p class="text-museum-dark/60 font-light text-sm leading-relaxed">En medio del hallazgo, se revela una comunidad con riqueza cultural inmensa pero invisibilizada — abandono, silencio y exclusión.</p>
                                </div>
                            </div>

                            <!-- 3. La Comprensión -->
                            <div class="relative flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-16">
                                <div class="md:w-1/2 md:text-right pl-12 md:pl-0">
                                    <span class="text-museum-gold font-bold tracking-[0.3em] text-[10px] uppercase">La Visión</span>
                                    <h3 class="text-2xl font-display text-museum-dark mt-3 mb-3">La Comprensión</h3>
                                    <p class="text-museum-dark/60 font-light text-sm leading-relaxed">El verdadero patrimonio no está solo en la tierra: reside en la memoria, los saberes, la vida cotidiana y la capacidad de la comunidad.</p>
                                </div>
                                <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-museum-gold flex items-center justify-center z-10 shadow-lg shadow-museum-gold/30">
                                    <div class="w-3 h-3 rounded-full bg-white"></div>
                                </div>
                                <div class="md:w-1/2 pl-12 md:pl-0 hidden md:block"></div>
                            </div>

                            <!-- 4. El Nacimiento -->
                            <div class="relative flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-16">
                                <div class="md:w-1/2 md:text-right pl-12 md:pl-0 hidden md:block"></div>
                                <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-museum-dark flex items-center justify-center z-10 shadow-lg">
                                    <div class="w-3 h-3 rounded-full bg-museum-gold"></div>
                                </div>
                                <div class="md:w-1/2 pl-12 md:pl-0">
                                    <span class="text-museum-gold font-bold tracking-[0.3em] text-[10px] uppercase">La Fundación</span>
                                    <h3 class="text-2xl font-display text-museum-dark mt-3 mb-3">Nace la Casa Museo</h3>
                                    <p class="text-museum-dark/60 font-light text-sm leading-relaxed">Así nace la Fundación Casa Museo Pozón (código 13001-15) — la Casa Museo de la Memoria del Pozón — desde las entrañas de El Pozón.</p>
                                </div>
                            </div>

                            <!-- 5. Hoy -->
                            <div class="relative flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-16">
                                <div class="md:w-1/2 md:text-right pl-12 md:pl-0">
                                    <span class="text-museum-gold font-bold tracking-[0.3em] text-[10px] uppercase">Actualidad</span>
                                    <h3 class="text-2xl font-display text-museum-dark mt-3 mb-3">Vanguardia desde la Periferia</h3>
                                    <p class="text-museum-dark/60 font-light text-sm leading-relaxed">Personería jurídica consolidada, tecnología de punta operada, y un modelo que demuestra que la periferia es un epicentro de vanguardia pedagógica.</p>
                                </div>
                                <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-museum-gold flex items-center justify-center z-10 shadow-lg shadow-museum-gold/30 ring-4 ring-museum-gold/20">
                                    <div class="w-3 h-3 rounded-full bg-white"></div>
                                </div>
                                <div class="md:w-1/2 pl-12 md:pl-0 hidden md:block"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PROBLEMA vs SOLUCIÓN — Contraste visual -->
            <!-- ═══════════════════════════════════════════ -->
            <section class="py-28 md:py-36 px-8 md:px-16 lg:px-24 bg-white relative">
                <div class="max-w-7xl mx-auto">
                    <div class="text-center mb-20">
                        <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-4 uppercase block">El Contexto</span>
                        <h2 class="text-4xl md:text-5xl font-display text-museum-dark mb-6">Lo Que Encontramos</h2>
                        <div class="w-24 h-1 bg-museum-gold mx-auto"></div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 rounded-3xl overflow-hidden shadow-2xl">
                        <!-- Columna: El Problema -->
                        <div class="bg-museum-dark text-white p-12 md:p-16 relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-40 h-40 bg-red-500/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                            <span class="text-[10px] font-bold tracking-[0.4em] uppercase text-white/40 mb-6 block">El Problema</span>
                            <h3 class="text-2xl md:text-3xl font-display mb-10">Un Territorio <span class="text-red-400">Invisible</span></h3>
                            <ul class="space-y-6">
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400 flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                    <p class="text-white/60 font-light text-sm leading-relaxed">Abandono institucional y social persistente</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400 flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                    <p class="text-white/60 font-light text-sm leading-relaxed">Silencio sobre el patrimonio cultural local</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400 flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                    <p class="text-white/60 font-light text-sm leading-relaxed">Exclusión de las comunidades de su propia historia</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400 flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                    <p class="text-white/60 font-light text-sm leading-relaxed">Racismo epistémico: saberes comunitarios ignorados</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400 flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                    <p class="text-white/60 font-light text-sm leading-relaxed">Periferia tratada como problema social a asistir</p>
                                </li>
                            </ul>
                        </div>

                        <!-- Columna: La Solución -->
                        <div class="bg-museum-cream text-museum-dark p-12 md:p-16 relative overflow-hidden">
                            <div class="absolute bottom-0 left-0 w-40 h-40 bg-museum-gold/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
                            <span class="text-[10px] font-bold tracking-[0.4em] uppercase text-museum-gold mb-6 block">La Solución</span>
                            <h3 class="text-2xl md:text-3xl font-display mb-10">Un Modelo de <span class="text-museum-gold">Vanguardia</span></h3>
                            <ul class="space-y-6">
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold flex-shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                    <p class="text-museum-dark/70 font-light text-sm leading-relaxed">Museo vivo que conecta historia, arqueología y memoria</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold flex-shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                    <p class="text-museum-dark/70 font-light text-sm leading-relaxed">Modelo A.C.O. de aprendizaje comunitario orgánico</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold flex-shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                    <p class="text-museum-dark/70 font-light text-sm leading-relaxed">Laboratorios transmedia de vanguardia tecnológica</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold flex-shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                    <p class="text-museum-dark/70 font-light text-sm leading-relaxed">Justicia cognitiva: soberanía del conocimiento propio</p>
                                </li>
                                <li class="flex gap-4 items-start">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-museum-gold flex-shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                    <p class="text-museum-dark/70 font-light text-sm leading-relaxed">La periferia como epicentro, no como problema</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!-- QUÉ SOMOS — Presentación institucional -->
            <!-- ═══════════════════════════════════════════ -->
            <section class="py-28 md:py-36 bg-museum-cream px-8 md:px-16 lg:px-24 relative overflow-hidden">
                <div class="max-w-7xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                        <!-- Imagen -->
                        <div class="relative order-2 lg:order-1">
                            <div class="h-[450px] md:h-[550px] relative rounded-2xl overflow-hidden shadow-2xl group">
                                <div class="absolute inset-0 border-2 border-museum-gold/20 m-5 rounded-xl z-20 transition-transform duration-700 group-hover:scale-95 pointer-events-none"></div>
                                <img src="/imagenes/quienes-somos-2.webp" alt="Casa Museo Pozón" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                            </div>
                            <!-- Badge flotante -->
                            <div class="absolute -top-4 -right-4 bg-white p-5 rounded-xl shadow-2xl z-30 hidden md:block">
                                <p class="text-[9px] text-museum-gold uppercase tracking-[0.2em] font-bold mb-1">Código</p>
                                <p class="text-xl font-display text-museum-dark">13001-15</p>
                            </div>
                        </div>

                        <!-- Texto -->
                        <div class="order-1 lg:order-2">
                            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Quiénes Somos</span>
