---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Pillars from "../components/ui/Pillars.astro";
import StickySplit from "../components/ui/StickySplit.astro";
import Stats from "../components/ui/Stats.astro";
import Quote from "../components/ui/Quote.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Btn from "../components/ui/Btn.astro";

const camino = [
    { tag: "Hace +20 años", kicker: "El Descubrimiento", title: "El Descubrimiento", text: "Un estudiante de historia encuentra un conchero prehispánico en los patios de El Pozón, reescribiendo la narrativa de la ciudad." },
    { tag: "El Proceso", kicker: "La Toma de Conciencia", title: "La Toma de Conciencia", text: "En medio del hallazgo, se revela una comunidad con riqueza cultural inmensa pero invisibilizada — abandono, silencio y exclusión." },
    { tag: "La Visión", kicker: "La Comprensión", title: "La Comprensión", text: "El verdadero patrimonio no está solo en la tierra: reside en la memoria, los saberes, la vida cotidiana y la capacidad de la comunidad." },
    { tag: "La Fundación", kicker: "Nace la Casa Museo", title: "Nace la Casa Museo", text: "Así nace la Fundación Casa Museo Pozón (código 13001-15) — la Casa Museo de la Memoria del Pozón — desde las entrañas de El Pozón." },
    { tag: "Actualidad", kicker: "Vanguardia desde la Periferia", title: "Vanguardia desde la Periferia", text: "Personería jurídica consolidada, tecnología de punta operada, y un modelo que demuestra que la periferia es un epicentro de vanguardia pedagógica." },
];
const problema = ["Abandono institucional y social persistente", "Silencio sobre el patrimonio cultural local", "Exclusión de las comunidades de su propia historia", "Racismo epistémico: saberes comunitarios ignorados", "Periferia tratada como problema social a asistir"];
const solucion = ["Museo vivo que conecta historia, arqueología y memoria", "Modelo A.C.O. de aprendizaje comunitario orgánico", "Laboratorios transmedia de vanguardia tecnológica", "Justicia cognitiva: soberanía del conocimiento propio", "La periferia como epicentro, no como problema"];
const modelo = [
    { title: "A.C.O.", tag: "Aprendizaje Comunitario Orgánico", text: "Metodología pedagógica propia que nace del territorio y valida a los sabedores como los verdaderos científicos de su historia." },
    { title: "Laboratorios Transmedia", tag: "Vanguardia Tecnológica", text: "Tecnología de punta aplicada a la preservación patrimonial y la educación comunitaria." },
    { title: "Justicia Cognitiva", tag: "Ingeniería Educativa Propia", text: "Reemplazando el racismo epistémico por la soberanía de una comunidad que diseña su propio conocimiento." },
    { title: "Sabedores y Matronas", tag: "Los Científicos de su Historia", text: "Validamos a nuestros sabedores y matronas como los verdaderos científicos de su historia y memoria." },
];
const stats = [
    { value: 150, suffix: "+", label: "Relatos Sistematizados" },
    { value: 800, suffix: "+", label: "Beneficiarios Directos" },
    { value: 250, suffix: "K+", label: "Impacto Digital Alcanzado" },
    { value: 15, label: "Instituciones Vinculadas" },
];
const salto = [
    { title: "Integración Educativa", tag: "Impacto: Educación Regional", text: "Llevar la experiencia a mayor nivel integrándola formalmente en los Proyectos Educativos Institucionales (PEI) de la región." },
    { title: "Alianzas Estratégicas", tag: "Impacto: Red Nacional e Internacional", text: "Articular con organizaciones culturales y aliados nacionales e internacionales para ampliar el alcance del modelo." },
    { title: "Escalabilidad", tag: "Impacto: Modelo Replicable", text: "Escalar el modelo a territorios populares de Colombia y América Latina, demostrando que dignidad y soberanía se construyen desde la memoria." },
];
---

<Layout
  title="Propuesta de Valor | Casa Museo Pozón"
  description="Conoce la propuesta de valor y el pitch deck de la Fundación Casa Museo Pozón — un modelo de justicia cognitiva, educación comunitaria y preservación patrimonial desde El Pozón, Cartagena."
  bodyClass="bg-museum-cream font-sans overflow-x-hidden"
>
    <PageHero image="/galeria/GOBERNANZA CULTURAL.webp" group="Institucional" current="Propuesta de valor">
      <Fragment slot="eyebrow">Fundación Casa Museo Pozón — Código 13001-15</Fragment>
      Propuesta <span class="text-museum-gold">de Valor</span>
      <Fragment slot="lead">Donde la tierra guarda memoria y la comunidad diseña su propio conocimiento.</Fragment>
      <Fragment slot="actions">
        <a href="#epigrafe" class="inline-flex items-center gap-3 border border-museum-gold/30 text-museum-gold px-8 py-4 rounded-full text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-gold hover:text-museum-dark transition-all duration-500"> Conoce Nuestra Historia <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg> </a>
      </Fragment>
    </PageHero>

    <!-- Epígrafe -->
    <Section id="epigrafe" tone="dark" eyebrow="Pitch" align="center" narrow>
        <Quote author="Rigoberto Castro Pérez" role="Fundador">Imagina despertar un día y descubrir que en el patio de tu casa existe un tesoro arqueológico —un conchero prehispánico de gran valor patrimonial— capaz de reescribir la narrativa y la historia de tu ciudad.</Quote>
    </Section>

    <!-- El hallazgo -->
    <Section id="hallazgo" tone="cream" eyebrow="El Origen">
        <Fragment slot="title">El <span class="text-museum-gold">Hallazgo</span></Fragment>
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-24 items-center">
            <div class="space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-dark/80">
                <p>Eso no es ficción; lo viví hace más de dos décadas. Siendo estudiante de historia, descubrí que los patios vecinos guardaban las claves de nuestro pasado.</p>
                <p class="text-base md:text-lg text-museum-dark/70">Pero en medio de ese hallazgo, atrapado en un entorno de <strong class="font-bold text-museum-dark">abandono, silencio y exclusión</strong>, encontré algo aún más poderoso: una comunidad con una riqueza cultural inmensa, pero invisibilizada.</p>
                <p class="text-base md:text-lg text-museum-dark/70">Ahí comprendí que el verdadero patrimonio no se limita a los restos en la tierra; reside también en la memoria, los saberes, la vida cotidiana y la inmensa capacidad de una comunidad para construir su propio camino.</p>
            </div>
            <div class="relative aspect-[4/5] rounded-[2rem] overflow-hidden shadow-[0_50px_90px_-45px_rgba(26,26,26,0.55)]">
                <img src="/imagenes/quienes-somos-1.png" alt="Hallazgo en El Pozón" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute left-5 bottom-5 right-5 rounded-2xl bg-museum-dark/85 backdrop-blur text-museum-cream p-5">
                    <span class="block text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold mb-1">Valor Patrimonial</span>
                    <span class="font-display text-lg leading-snug">Conchero prehispánico de gran significado</span>
                </div>
            </div>
        </div>
    </Section>

    <!-- Cronología -->
    <Section id="camino" tone="white" eyebrow="Nuestro Camino">
        <Fragment slot="title">De la Tierra a la <span class="text-museum-gold">Transformación</span></Fragment>
        <StickySplit steps={camino}>
            <p class="font-light text-museum-dark/70 leading-relaxed max-w-sm">Cronología: de un hallazgo en un patio a un modelo de vanguardia pedagógica desde la periferia.</p>
        </StickySplit>
    </Section>

    <!-- Problema vs solución -->
    <Section id="contexto" tone="cream" eyebrow="El Contexto">
        <Fragment slot="title">Lo Que <span class="text-museum-gold">Encontramos</span></Fragment>
        <div class="grid lg:grid-cols-2 gap-6 md:gap-8">
            <article class="rounded-[2rem] border border-museum-dark/15 bg-white p-8 md:p-12">
                <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-museum-dark/50 mb-4">El Problema</span>
                <h3 class="font-display text-3xl md:text-4xl mb-8 leading-tight">Un Territorio Invisible</h3>
                <ul class="space-y-4">{problema.map((x) => <li class="flex gap-4 font-light leading-relaxed text-museum-dark/75"><span class="mt-1 w-6 h-6 shrink-0 rounded-full border border-museum-dark/30 flex items-center justify-center text-[11px]" aria-hidden="true">✕</span>{x}</li>)}</ul>
            </article>
            <article class="rounded-[2rem] bg-museum-dark text-museum-cream p-8 md:p-12">
                <span class="block text-[10px] font-bold tracking-[0.35em] uppercase text-museum-gold mb-4">La Solución</span>
                <h3 class="font-display text-3xl md:text-4xl mb-8 leading-tight">Un Modelo de Vanguardia</h3>
                <ul class="space-y-4">{solucion.map((x) => <li class="flex gap-4 font-light leading-relaxed text-museum-cream/85"><span class="mt-1 w-6 h-6 shrink-0 rounded-full bg-museum-gold text-museum-dark flex items-center justify-center text-[11px]" aria-hidden="true">✓</span>{x}</li>)}</ul>
            </article>
        </div>
    </Section>

    <!-- La fundación -->
    <Section id="fundacion" tone="white" eyebrow="Quiénes Somos">
        <Fragment slot="title">La <span class="text-museum-gold">Fundación</span></Fragment>
        <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-24 items-center">
            <div class="relative aspect-[4/5] rounded-[2rem] overflow-hidden">
                <img src="/imagenes/quienes-somos-2.webp" alt="Fundación Casa Museo Pozón" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute top-5 left-5 rounded-2xl bg-museum-gold text-museum-dark px-5 py-3"><span class="block text-[10px] font-bold tracking-[0.3em] uppercase">Código</span><span class="font-display text-2xl">13001-15</span></div>
            </div>
            <div class="space-y-6 text-lg md:text-xl font-light leading-relaxed text-museum-dark/80">
                <p>Así nace la <strong class="font-bold text-museum-dark">Fundación Casa Museo Pozón</strong> —también concebida como la Casa Museo de la Memoria del Pozón— desde las entrañas de El Pozón, una tierra de cultura vibrante donde <strong class="font-bold text-museum-dark">su gente es nuestro activo más valioso y subestimado</strong>.</p>
                <p class="text-base md:text-lg text-museum-dark/70">Somos esa Cartagena popular y museológica que opera como un puente vivo entre la historia, la arqueología, la memoria y la educación.</p>
                <div class="rounded-2xl bg-museum-cream border border-museum-gold/30 p-6">
                    <span class="block text-[10px] font-bold tracking-[0.3em] uppercase text-museum-gold mb-2">Lema Institucional</span>
                    <p class="font-display text-lg md:text-xl leading-snug text-museum-dark">“Revitalizando y preservando los entornos bioculturales, arqueológicos, creativos y de saberes ancestrales para el desarrollo sostenible del territorio pozonero hacia una cultura de paz”</p>
                </div>
            </div>
        </div>
    </Section>

    <!-- Modelo -->
    <Section id="modelo" tone="dark" eyebrow="Nuestra Metodología">
        <Fragment slot="title">Modelo <span class="text-museum-gold">Transformador</span></Fragment>
        <Fragment slot="lead">Creemos firmemente que el conocimiento no pertenece únicamente a las aulas universitarias tradicionales; también nace en los barrios, en la experiencia de nuestros adultos mayores y en la memoria de quienes han construido este territorio.</Fragment>
        <Pillars items={modelo} cols={4} dark />
    </Section>

    <!-- Logros -->
    <Section id="logros" tone="cream" eyebrow="Hechos Que Respaldan" align="center">
        <Fragment slot="title">Lo Que Ya <span class="text-museum-gold">Logramos</span></Fragment>
        <Stats stats={stats} />
    </Section>

    <Section id="cita" tone="dark" align="center" narrow>
        <Quote dark>No nos limitamos a exhibir el pasado. Transformamos la oralidad y la arqueología local en una ingeniería de justicia cognitiva y educación propia.</Quote>
    </Section>

    <!-- Próximo salto -->
    <Section id="proximo-salto" tone="white" eyebrow="Estrategia">
        <Fragment slot="title">El Próximo <span class="text-museum-gold">Salto</span></Fragment>
        <Fragment slot="lead">Hemos construido el andamiaje técnico y comunitario. Nuestro siguiente paso estratégico es claro y escalable.</Fragment>
        <Pillars items={salto} cols={3} />
    </Section>

    <!-- Invitación -->
    <CtaBand>
        <Fragment slot="title"><span class="block font-sans text-[11px] font-bold tracking-[0.4em] uppercase text-museum-gold mb-5">Invitación</span>Sé Parte del <span class="text-museum-gold">Cambio</span></Fragment>
        No buscamos simple asistencia filantrópica; te invitamos a ser nuestro aliado estratégico e inversor en un modelo de alto impacto. Tu inversión no solo preservará el pasado: dará un sentido transformador al presente de la infancia, abrirá oportunidades reales para las juventudes, fortalecerá nuestra identidad y demostrará que el desarrollo, la dignidad y la soberanía también se construyen desde la memoria y la educación.
        <Fragment slot="actions">
            <Btn href="https://wa.me/573126153148" external>Ser Aliado Estratégico</Btn>
            <Btn href="mailto:fundacioncasamuseopozon@gmail.com" variant="outline">Contáctanos</Btn>
            <Btn href="/como-apoyar" variant="outline">Ver Formas de Apoyar</Btn>
        </Fragment>
    </CtaBand>

    <section class="bg-museum-dark text-museum-cream px-6 md:px-16 lg:px-24 pb-16 pt-4" data-no-anim>
        <div class="max-w-5xl mx-auto border-t border-museum-cream/15 pt-12 text-center">
            <p class="font-display text-xl text-museum-gold mb-1">Con fe en este camino,</p>
            <p class="font-display text-3xl">Rigoberto Castro Pérez</p>
            <p class="text-[10px] tracking-[0.35em] uppercase text-museum-cream/60 mt-2 mb-12">Fundador — Casa Museo Pozón</p>
            <p class="text-xs tracking-[0.15em] uppercase text-museum-cream/50 mb-5">Fundación Casa Museo Pozón · El Pozón, Cartagena de Indias, Bolívar</p>
            <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm mb-8">
                <a href="tel:3126153148" class="footer-link text-museum-cream/85">312-6153148</a>
                <a href="mailto:fundacioncasamuseopozon@gmail.com" class="footer-link text-museum-cream/85">fundacioncasamuseopozon@gmail.com</a>
                <a href="https://www.casamuseopozon.org" target="_blank" rel="noopener noreferrer" class="footer-link text-museum-cream/85">www.casamuseopozon.org</a>
            </div>
            <div class="flex flex-wrap justify-center gap-3">
                <Btn href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" external variant="outline">Descargar Portafolio</Btn>
                <Btn href="/pdfs/PLAN ESTRATÉGICO 2026-2028.pdf" external variant="outline">Plan Estratégico 2026-2028</Btn>
                <Btn href="/" variant="outline">Volver a Inicio</Btn>
            </div>
        </div>
    </section>
</Layout>
