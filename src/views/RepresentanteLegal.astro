---
import RepresentanteCredencial from "../components/RepresentanteCredencial.astro";
import { representante } from "../data/representante";
---

<!--
  Sección del inicio. Fondo oscuro a propósito: el representante legal es la
  firma que respalda a la Fundación y necesita leerse de un vistazo, con su
  credencial y QR siempre visibles (nunca hay que voltear nada para verlos).
-->
<section id="representante" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-museum-dark relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('/imagenes/creator.png')] bg-cover bg-center grayscale mix-blend-overlay pointer-events-none"></div>
    <div class="absolute -top-20 right-0 w-96 h-96 bg-museum-gold/5 blur-3xl rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 -left-20 w-80 h-80 bg-museum-gold/5 blur-3xl rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <!-- Encabezado -->
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-16 md:mb-20">
            <div>
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Representante Legal</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-display text-white mb-6 leading-none">
                    {representante.nombrePartes.primera} <br/>
                    <span class="text-museum-gold italic">{representante.nombrePartes.apellidos}</span>
                </h2>
                <div class="w-20 h-1 bg-museum-gold"></div>
            </div>
            <p class="text-museum-gold/80 text-xs font-bold uppercase tracking-[0.2em] lg:text-right max-w-sm">
                {representante.cargo}
            </p>
        </div>

        <!-- Credencial + texto -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
            <div class="max-w-md w-full">
                <RepresentanteCredencial variant="sm" />

                <p class="text-[9px] text-white/35 uppercase tracking-[0.2em] mt-6 text-center leading-relaxed">
                    Credencial digital verificable · código {representante.codigo}
                </p>
            </div>

            <div>
                <p class="text-white/60 text-lg font-light leading-relaxed mb-10">
                    Historiador y gestor cultural con más de 25 años de experiencia. {representante.nombrePartes.primera} ha liderado la creación de un modelo museal pionero que convierte al barrio El Pozón en un laboratorio de innovación comunitaria.
                </p>

                <!-- Indicadores -->
                <div class="grid grid-cols-3 gap-6 mb-12">
                    {representante.indicadores.map((ind) => (
                        <div class="border-l border-museum-gold/25 pl-5">
                            <p class="text-museum-gold font-display text-3xl md:text-4xl mb-2 leading-none">{ind.valor}</p>
                            <p class="text-[8px] uppercase tracking-[0.2em] text-white/35 mt-2">{ind.etiqueta}</p>
                        </div>
                    ))}
                </div>

                <!-- Sentencia -->
                <blockquote class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-[2rem] p-8 md:p-10 mb-12">
                    <p class="text-white/85 text-base md:text-lg font-display italic leading-relaxed">"{representante.sentencia}"</p>
                </blockquote>

                <!-- Acciones -->
                <div class="flex flex-wrap gap-4">
                    <a href="/representante-legal" class="inline-flex items-center gap-4 bg-museum-gold text-museum-dark px-10 py-5 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-white transition-all duration-500 shadow-xl shadow-museum-gold/10">
                        Ver perfil completo
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                    <a href="/socios" class="inline-flex items-center gap-4 border border-white/20 text-white/80 px-10 py-5 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:border-museum-gold hover:text-museum-gold transition-all duration-500">
                        Cuerpo colegiado
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>