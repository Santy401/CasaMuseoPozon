---
---
<section id="contacto" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-museum-dark text-white relative overflow-hidden">
    <!-- Branding Background -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-museum-gold/5 blur-3xl rounded-full"></div>
    
    <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
            
            <!-- Info & Map -->
            <div>
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase mb-6 block">Encuéntranos</span>
                <h2 class="text-4xl md:text-6xl font-display mb-12">¿Cómo llegar?</h2>
                
                <div class="space-y-12 mb-16">
                    <div class="flex gap-6">
                        <div class="w-10 h-10 rounded-full border border-museum-gold/30 flex items-center justify-center text-museum-gold flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div>
                            <p class="text-sm font-light text-white/70 leading-relaxed uppercase tracking-wider">
                                Sector La Islita, Calle Las Palmas, trasversal 57 <br/>
                                81-12 con Mz 50 Lote 02 <br/>
                                Barrio El Pozón - Cartagena, Colombia
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-6">
                        <div class="w-10 h-10 rounded-full border border-museum-gold/30 flex items-center justify-center text-museum-gold flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <p class="text-[10px] font-bold text-museum-gold uppercase mb-2">Lunes a Viernes</p>
                                <p class="text-xs text-white/50">2:00 pm – 6:00 pm</p>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-museum-gold uppercase mb-2">Fines de Semana</p>
                                <p class="text-xs text-white/50">9:00 am – 3:00 pm</p>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-museum-gold uppercase mb-2">Feriados</p>
                                <p class="text-xs text-white/50">9:00 am – 12:00 pm</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-6">
                        <div class="w-10 h-10 rounded-full border border-museum-gold/30 flex items-center justify-center text-museum-gold flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold mb-1">(+57) 312 615 3148</p>
                            <p class="text-xs text-white/40 mb-4">Fijo oficina: 605 692 1750</p>
                            <p class="text-xs font-bold text-museum-gold underline underline-offset-4">fundacioncasamuseopozon@gmail.com</p>
                        </div>
                    </div>
                </div>

                <!-- Google Maps Iframe Placeholder (with real link) -->
                <div class="aspect-video bg-white/5 rounded-[2.5rem] overflow-hidden border border-white/10 group relative shadow-2xl">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3924.3670304323607!2d-75.45906232439166!3d10.4053641891157!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8ef625387151d087%3A0x9e9c7168bdfa88bc!2sFUNDACI%C3%93N+CASA+MUSEO+POZ%C3%93N!5e0!3m2!1ses!2sco!4v1714139828231" 
                        class="w-full h-full grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000"
                        style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    <a href="https://www.google.com/maps/place/FUNDACI%C3%93N+CASA+MUSEO+POZ%C3%93N/@10.4047289,-75.4588276,16.93z" target="_blank" class="absolute bottom-6 left-6 bg-museum-gold text-museum-dark px-6 py-3 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-white transition-colors">Abrir en Google Maps</a>
                </div>
            </div>

            <!-- Form & Donations -->
            <div class="flex flex-col justify-between">
                <div>
                    <h3 class="text-2xl font-display mb-10 border-b border-white/10 pb-6 uppercase tracking-widest">Escríbenos</h3>
                    <form class="space-y-8">
                        <div>
                            <input type="text" placeholder="NOMBRE COMPLETO" class="w-full bg-transparent border-b border-white/20 py-4 text-xs tracking-widest focus:border-museum-gold outline-none transition-colors uppercase font-bold" />
                        </div>
                        <div>
                            <input type="email" placeholder="CORREO ELECTRÓNICO" class="w-full bg-transparent border-b border-white/20 py-4 text-xs tracking-widest focus:border-museum-gold outline-none transition-colors uppercase font-bold" />
                        </div>
                        <div>
                            <textarea rows="4" placeholder="MENSAJE" class="w-full bg-transparent border-b border-white/20 py-4 text-xs tracking-widest focus:border-museum-gold outline-none transition-colors uppercase font-bold"></textarea>
                        </div>
                        <button type="submit" class="bg-white text-museum-dark px-12 py-5 rounded-sm text-[10px] font-bold tracking-[0.3em] uppercase hover:bg-museum-gold transition-all duration-500">Enviar Mensaje</button>
                    </form>
                </div>

                <!-- Donations Area -->
                <div class="mt-24 p-12 bg-white/5 rounded-[3rem] border border-museum-gold/20 relative overflow-hidden group">
                    <div class="absolute -bottom-6 -right-6 text-museum-gold opacity-10 group-hover:rotate-12 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sprout"><path d="M7 20h10"/><path d="M10 20c5.5-2.5 8-6.4 8-12"/><path d="M13 6.1s4.5 7 3 10"/><path d="M18 8c3.1 3 5 1 5 1"/><path d="M10 20c-5.5-2.5-8-6.4-8-12"/><path d="M7 6.1s-4.5 7-3 10"/><path d="M6 8c-3.1 3-5 1-5 1"/><path d="M12 10v10"/></svg>
                    </div>
                    <h4 class="text-xl font-display text-museum-gold mb-6">Tu apoyo florece</h4>
                    <p class="text-xs font-light text-white/50 leading-relaxed mb-6">
                        Cada aporte fortalece procesos culturales que mantienen vivo el corazón de El Pozón.
                    </p>
                    <div class="p-6 bg-museum-dark border border-museum-gold/30 rounded-2xl">
                         <p class="text-[10px] text-museum-gold uppercase tracking-[0.2em] mb-2 font-bold">Cuenta de Ahorros</p>
                         <p class="text-lg font-display tracking-widest mb-1">24154765394</p>
                         <p class="text-[9px] uppercase opacity-40">Fundación Casa Museo Pozón</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
