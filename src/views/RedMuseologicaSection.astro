---
---
<section id="red-museologica" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-white relative overflow-hidden">
    <!-- Decorative element -->
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-museum-gold/5 rounded-full -translate-x-1/2 translate-y-1/2 blur-3xl"></div>

    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row-reverse gap-16 items-center">
            <div class="w-full lg:w-1/2">
                <div class="relative group">
                    <div class="absolute -inset-4 bg-museum-gold/10 rounded-[2rem] blur-xl group-hover:bg-museum-gold/20 transition-all duration-700"></div>
                    <img 
                        src="/RedMuseologicaLogo.png" 
                        alt="Logo Red Académica Museológica" 
                        class="relative rounded-[2rem] shadow-2xl w-full object-cover transform group-hover:scale-[1.02] transition-transform duration-700"
                    />
                    <div class="absolute bottom-8 right-8 bg-white/90 backdrop-blur px-6 py-4 rounded-xl shadow-lg border border-museum-gold/20">
                        <p class="text-museum-gold font-bold text-sm tracking-widest uppercase">Ecosistema de Activación</p>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-1/2">
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Alianza Estratégica</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-display text-museum-dark mb-8 leading-tight">
                    Red Académica <span class="text-museum-gold">Museológica</span> <br/>
                    <span class="text-2xl md:text-3xl opacity-80">Centro de Investigación y Memoria</span>
                </h2>
                <div class="w-20 h-1 bg-museum-gold mb-10"></div>
                
                <p class="text-museum-dark/80 text-lg leading-relaxed mb-8 font-light">
                    Consolidamos un <strong class="font-bold">Ecosistema de Activación Patrimonial</strong> donde la investigación científica, la memoria histórica y la educación convergen para fortalecer el tejido social.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        </div>
                        <span class="text-museum-dark/70 font-medium">Modelo A.C.O.</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-museum-cream flex items-center justify-center text-museum-gold">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                        </div>
                        <span class="text-museum-dark/70 font-medium">Investigación-Acción</span>
                    </div>
                </div>

                <a href="/red-museologica" class="group relative inline-flex items-center gap-6 text-museum-dark font-bold tracking-[0.2em] text-xs uppercase hover:text-museum-gold transition-colors">
                    <div class="w-14 h-14 rounded-full border border-museum-dark/20 flex items-center justify-center group-hover:border-museum-gold transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                    Explorar la Red Académica
                </a>
            </div>
        </div>
    </div>
</section>
