---
const aliados = [
    { name: "Red de Museos de Cartagena y Bolívar", type: "Red" },
    { name: "Red de Museos de Colombia", type: "Red" },
    { name: "Museo Nacional de Colombia", type: "Institución" },
    { name: "Museo del Oro Zenú", type: "Institución" },
    { name: "Cámara de Comercio de Cartagena", type: "Institución" },
    { name: "CLUSTER Experiencias Culturales", type: "Institución" },
    { name: "Ministerio de las Culturas, las Artes y los Saberes", type: "Ministerio" },
    { name: "Trenzando Territorio", type: "Aliado Educativo" },
    { name: "JUFESPO", type: "Comunidad" },
    { name: "CORMODAFRO", type: "Aliado Estratégico" },
    { name: "Miradas Caribe: Semillero de Creación", type: "Aliado Estratégico" },
    { name: "Movimiento Tejidos", type: "Aliado Estratégico" }
];
---
<section id="aliados" class="py-24 md:py-32 bg-museum-dark text-museum-cream overflow-hidden relative" data-no-anim>
    <div class="px-8 md:px-16 lg:px-24 max-w-7xl mx-auto text-center mb-14 md:mb-20">
        <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase mb-4 block">Nuestra Red</span>
        <h2 class="text-4xl md:text-6xl font-display mb-6">Aliados y Redes</h2>
        <p class="text-museum-cream/60 font-light text-sm md:text-base max-w-2xl mx-auto">
            El trabajo comunitario y museal se fortalece gracias a la articulación con instituciones y organizaciones locales, regionales y nacionales.
        </p>
    </div>

    {[aliados.slice(0, 6), aliados.slice(6)].map((fila, i) => (
        <div class="marquee group/marquee relative py-3" aria-hidden={i === 1 ? 'true' : undefined}>
            <ul class={`marquee-track flex w-max gap-4 ${i === 1 ? 'marquee-reverse' : ''}`}>
                {[...fila, ...fila, ...fila, ...fila].map((aliado) => (
                    <li class="shrink-0 flex items-center gap-4 rounded-full border border-museum-cream/15 bg-museum-cream/5 px-8 py-5 hover:border-museum-gold/60 hover:bg-museum-gold/10 transition-colors duration-500">
                        <span class="w-2 h-2 rounded-full bg-museum-gold" aria-hidden="true"></span>
                        <span class="text-sm md:text-base font-display whitespace-nowrap">{aliado.name}</span>
                        <span class="text-[9px] font-bold uppercase tracking-[0.25em] text-museum-gold/80 whitespace-nowrap">{aliado.type}</span>
                    </li>
                ))}
            </ul>
        </div>
    ))}
    <div class="absolute inset-y-0 left-0 w-24 md:w-48 bg-gradient-to-r from-museum-dark to-transparent pointer-events-none z-10" aria-hidden="true"></div>
    <div class="absolute inset-y-0 right-0 w-24 md:w-48 bg-gradient-to-l from-museum-dark to-transparent pointer-events-none z-10" aria-hidden="true"></div>
</section>
