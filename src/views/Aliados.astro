---
const aliados = [
    { name: "Red de Museos de Cartagena y Bolívar", type: "Red" },
    { name: "Red de Museos de Colombia", type: "Red" },
    { name: "Museo Nacional de Colombia", type: "Institución" },
    { name: "Museo del Oro Zenú", type: "Institución" },
    { name: "Cámara de Comercio de Cartagena", type: "Institución" },
    { name: "CLUSTER Experiencias Culturales", type: "Institución" },
    { name: "Ministerio de las Culturas, las Artes y los Saberes", type: "Ministerio" },
    { name: "Trenzando Territorio", type: "Aliado Educativo" },
    { name: "JUFESPO", type: "Comunidad" },
    { name: "CORMODAFRO", type: "Aliado Estratégico" },
    { name: "Miradas Caribe: Semillero de Creación", type: "Aliado Estratégico" },
    { name: "Movimiento Tejidos", type: "Aliado Estratégico" }
];
---
<section id="aliados" class="py-24 px-8 md:px-16 lg:px-24 bg-white border-b border-zinc-100">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase mb-4 block">Nuestra Red</span>
            <h2 class="text-3xl md:text-5xl font-display text-museum-dark mb-6">Aliados y Redes</h2>
            <p class="text-museum-dark/60 font-light text-sm md:text-base max-w-2xl mx-auto">
                El trabajo comunitario y museal se fortalece gracias a la articulación con instituciones y organizaciones locales, regionales y nacionales.
            </p>
        </div>

        <!-- ══ Publicación destacada: Nuevos Aliados Estratégicos ══ -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center mb-16">
            <!-- Poster -->
            <div class="relative max-w-md mx-auto lg:max-w-none lg:mx-0">
                <div class="aspect-[3/4] max-h-[560px] rounded-[2rem] overflow-hidden relative shadow-2xl group border border-museum-gold/20 bg-white">
                    <img
                        src="/imagenes/poster-miradas-caribe-tejidos.jpg"
                        alt="Poster de alianza estratégica entre Miradas Caribe y Movimiento Tejidos"
                        class="w-full h-full object-contain transition-transform duration-1000 group-hover:scale-[1.02]"
                        loading="lazy"
                    />
                </div>
                <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 w-max max-w-[90%] bg-museum-dark text-white px-6 py-3 rounded-full shadow-xl flex items-center gap-3">
                    <span class="w-2 h-2 bg-museum-gold rounded-full animate-pulse"></span>
                    <span class="text-[9px] font-bold uppercase tracking-[0.25em] whitespace-nowrap">Nueva Alianza</span>
                </div>
            </div>

            <!-- Texto + aliados -->
            <div class="flex flex-col gap-6 md:gap-8">
                <div>
                    <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-5 uppercase block">Aliados Estratégicos</span>
                    <h3 class="text-3xl md:text-4xl font-display text-museum-dark leading-tight mb-5">
                        Se suman a nuestra <span class="text-museum-gold italic">red de tejido social</span>
                    </h3>
                    <div class="w-20 h-1 bg-museum-gold mb-8"></div>
                    <p class="text-museum-dark/60 font-light text-sm md:text-base leading-relaxed max-w-lg">
                        A través del arte y la memoria, nuevas organizaciones del territorio se encuentran con la Casa Museo para sembrar futuro y tejer comunidad.
                    </p>
                </div>

                <div class="space-y-4">
                    <!-- Miradas Caribe -->
                    <div class="flex items-center gap-6 bg-white p-6 md:p-7 rounded-2xl border border-zinc-100 hover:border-museum-gold/30 hover:-translate-y-1 transition-all duration-500 shadow-xl shadow-museum-dark/5">
                        <div class="w-14 h-14 rounded-2xl bg-museum-gold/10 text-museum-gold flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </div>
                        <div>
                            <h4 class="font-display text-lg md:text-xl text-museum-dark group-hover:text-museum-gold transition-colors">Miradas Caribe</h4>
                            <p class="text-xs text-museum-dark/50 font-light mt-1">Semillero de Creación · Aliado Estratégico</p>
                        </div>
                    </div>

                    <!-- Movimiento Tejidos -->
                    <div class="flex items-center gap-6 bg-white p-6 md:p-7 rounded-2xl border border-zinc-100 hover:border-museum-gold/30 hover:-translate-y-1 transition-all duration-500 shadow-xl shadow-museum-dark/5">
                        <div class="w-14 h-14 rounded-2xl bg-museum-gold/10 text-museum-gold flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                        </div>
                        <div>
                            <h4 class="font-display text-lg md:text-xl text-museum-dark group-hover:text-museum-gold transition-colors">Movimiento Tejidos</h4>
                            <p class="text-xs text-museum-dark/50 font-light mt-1">Aliado Estratégico</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 md:gap-8">
            {aliados.map(aliado => (
                <div class="flex flex-col items-center justify-center p-6 text-center bg-zinc-50 border border-zinc-100 hover:border-museum-gold/30 hover:bg-white hover:shadow-xl transition-all duration-500 rounded-2xl group min-h-[140px]">
                    <span class="text-[8px] font-bold uppercase tracking-widest text-museum-gold mb-3 opacity-50 group-hover:opacity-100 transition-opacity">{aliado.type}</span>
                    <h3 class="text-xs font-bold text-museum-dark/70 group-hover:text-museum-dark transition-colors uppercase tracking-widest leading-relaxed">
                        {aliado.name}
                    </h3>
                </div>
            ))}
        </div>
    </div>
</section>
