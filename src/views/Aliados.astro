---
const aliados = [
    { name: "Red de Museos de Cartagena y Bolívar", type: "Red" },
    { name: "Red de Museos de Colombia", type: "Red" },
    { name: "Museo Nacional de Colombia", type: "Institución" },
    { name: "Museo del Oro Zenú", type: "Institución" },
    { name: "Cámara de Comercio de Cartagena", type: "Institución" },
    { name: "CLUSTER Experiencias Culturales", type: "Institución" },
    { name: "Ministerio de las Culturas, las Artes y los Saberes", type: "Ministerio" },
    { name: "Programa Escuela Popular Sociopolítica Trensanfo Territorio", type: "Aliado Educativo" },
    { name: "JUFESPO", type: "Comunidad" },
    { name: "CORMODAFRO", type: "Aliado Estratégico" }
];
---
<section id="aliados" class="py-24 px-8 md:px-16 lg:px-24 bg-white border-b border-zinc-100">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase mb-4 block">Nuestra Red</span>
            <h2 class="text-3xl md:text-5xl font-display text-museum-dark mb-6">Aliados y Redes</h2>
            <p class="text-museum-dark/60 font-light text-sm md:text-base max-w-2xl mx-auto">
                El trabajo comunitario y museal se fortalece gracias a la articulación con instituciones y organizaciones locales, regionales y nacionales.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 md:gap-8">
            {aliados.map(aliado => (
                <div class="flex flex-col items-center justify-center p-6 text-center bg-zinc-50 border border-zinc-100 hover:border-museum-gold/30 hover:bg-white hover:shadow-xl transition-all duration-500 rounded-2xl group min-h-[140px]">
                    <span class="text-[8px] font-bold uppercase tracking-widest text-museum-gold mb-3 opacity-50 group-hover:opacity-100 transition-opacity">{aliado.type}</span>
                    <h3 class="text-xs font-bold text-museum-dark/70 group-hover:text-museum-dark transition-colors uppercase tracking-widest leading-relaxed">
                        {aliado.name}
                    </h3>
                </div>
            ))}
        </div>
    </div>
</section>
