---
import { categoriasDocumentos, totalDocumentos } from "../data/documentos";

// ── Iconos Lucide (inline SVG, estética del sitio) ──
const ICONOS_CATEGORIA: Record<string, string> = {
  landmark: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>`,
  target: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  compass: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  map: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>`,
  book: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  flask: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><line x1="7" y1="16" x2="17" y2="16"/></svg>`,
  building: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>`,
  graduation: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  music: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="18" r="4"/><path d="M12 18V2l7 4"/></svg>`
};

const ICONOS_TIPO: Record<string, string> = {
  PDF: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
  DOCX: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="14" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
  PPTX: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>`
};

const ICONO_DOWNLOAD = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;

const urlDoc = (archivo: string) => `/pdfs/${encodeURIComponent(archivo)}`;
---

<section id="documentos" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-museum-dark text-white relative overflow-hidden">
    <!-- Ambiente decorativo -->
    <div class="absolute -top-24 -right-24 w-[500px] h-[500px] bg-museum-gold/5 blur-3xl rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 -left-24 w-96 h-96 bg-museum-gold/[0.03] blur-3xl rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <!-- ══ Cabecera ══ -->
        <div class="max-w-3xl mb-20">
            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">
                Archivo y Documentación
            </span>
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-display text-white mb-8 leading-tight">
                Documentos por <span class="text-museum-gold italic">Categoría</span>
            </h2>
            <div class="w-20 h-1 bg-museum-gold mb-10"></div>
            <p class="text-white/50 font-light leading-relaxed text-base md:text-lg max-w-xl">
                Compendio completo del archivo institucional: identidad legal, planes, modelo museal, nodos, salas, investigación y pedagogía. Todo lo que fundamenta nuestra labor en el territorio, organizado y descargable.
            </p>
        </div>

        <!-- ══ Índice rápido (sticky, desktop) ══ -->
        <div class="sticky top-20 z-30 bg-museum-dark/85 backdrop-blur-md border-y border-white/5 py-3 -mx-8 px-8 md:-mx-16 md:px-16 lg:-mx-24 lg:px-24 hidden md:block">
            <div class="max-w-7xl mx-auto flex items-center gap-8 overflow-x-auto">
                <span class="text-[10px] font-bold uppercase tracking-widest text-museum-gold/60 shrink-0">Índice</span>
                {categoriasDocumentos.map(cat => (
                    <a href={`#doc-${cat.id}`} class="text-[10px] font-bold uppercase tracking-widest text-white/40 hover:text-museum-gold transition-colors shrink-0 whitespace-nowrap">
                        {cat.numero} · {cat.nombre}
                    </a>
                ))}
            </div>
        </div>

        <!-- ══ Bloques por categoría ══ -->
        <div class="mt-20 space-y-24">
            {categoriasDocumentos.map(cat => (
                <div id={`doc-${cat.id}`} class="scroll-mt-36">
                    <!-- Encabezado de categoría -->
                    <div class="flex items-start gap-6 md:gap-10 mb-10">
                        <span class="font-display text-5xl md:text-7xl leading-none text-museum-gold/20 italic select-none">{cat.numero}</span>
                        <div class="pt-1">
                            <div class="flex items-center gap-3 mb-3">
                                <span class="w-10 h-10 bg-museum-gold/10 rounded-xl flex items-center justify-center text-museum-gold shrink-0" set:html={ICONOS_CATEGORIA[cat.icono]}></span>
                                <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-museum-gold/60 border border-museum-gold/20 rounded-full px-3 py-1">
                                    {cat.documentos.length} documento{cat.documentos.length !== 1 ? "s" : ""}
                                </span>
                            </div>
                            <h3 class="font-display text-2xl md:text-4xl text-white mb-2">{cat.nombre}</h3>
                            <p class="text-white/40 font-light text-sm leading-relaxed">{cat.descripcion}</p>
                        </div>
                    </div>

                    <!-- Grid de documentos -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        {cat.documentos.map(doc => (
                            <a
                                href={urlDoc(doc.archivo)}
                                download
                                target="_blank"
                                class="group bg-white/5 backdrop-blur-sm border border-white/10 hover:border-museum-gold/40 hover:bg-white/10 rounded-2xl p-6 flex flex-col gap-5 transition-all duration-500 hover:-translate-y-1.5"
                            >
                                <div class="flex items-start justify-between gap-4">
                                    <span class="w-11 h-11 rounded-xl bg-museum-gold/10 text-museum-gold flex items-center justify-center shrink-0 transition-transform duration-500 group-hover:scale-110" set:html={ICONOS_TIPO[doc.tipo]}></span>
                                    <span class="text-[8px] font-bold tracking-widest uppercase text-white/30 border border-white/10 rounded-full px-2.5 py-1 bg-white/5">{doc.tipo}</span>
                                </div>
                                <div>
                                    <h4 class="font-display text-base md:text-lg text-white leading-snug group-hover:text-museum-gold transition-colors">
                                        {doc.titulo}
                                    </h4>
                                    <p class="text-white/35 text-xs font-light mt-1.5 leading-relaxed line-clamp-2">
                                        {doc.descripcion}
                                    </p>
                                </div>
                                <div class="flex items-center justify-between pt-4 mt-auto border-t border-white/5">
                                    <span class="text-[9px] uppercase tracking-widest text-white/25">{doc.tamano}</span>
                                    <span class="text-museum-gold text-[9px] font-bold tracking-[0.2em] uppercase inline-flex items-center gap-2 transition-all duration-500 group-hover:gap-3">
                                        Descargar
                                        <span set:html={ICONO_DOWNLOAD}></span>
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </div>

        <!-- ══ Pie del archivo ══ -->
        <div class="mt-24 pt-10 border-t border-white/5 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div>
                <p class="font-display text-2xl text-white mb-1">{totalDocumentos} <span class="text-museum-gold italic">documentos</span></p>
                <p class="text-white/30 text-xs font-light">Catálogo digital del Archivo Casa Museo del Pozón · El Pozón, Cartagena de Indias</p>
            </div>
            <a href="/#contacto" class="group flex items-center gap-4 text-museum-gold font-bold tracking-[0.2em] text-xs uppercase hover:text-white transition-colors w-max">
                <span class="w-12 h-[1px] bg-museum-gold group-hover:bg-white transition-colors"></span>
                Solicita una copia física
            </a>
        </div>
    </div>
</section>