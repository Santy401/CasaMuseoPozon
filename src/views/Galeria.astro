---
const previewImages = [
    { src: "/galeria/1. ENCUENTRO DE INICIATIVAS DE TURISMO CULTURAL.webp", title: "Turismo Cultural" },
    { src: "/galeria/SALA MUSEO.webp", title: "Sala Museo" },
    { src: "/galeria/PIEZAS 1.webp", title: "Arqueología" },
    { src: "/galeria/VISITA DEL ORO DOS.webp", title: "Museo del Oro" },
    { src: "/galeria/GOBERNANZA CULTURAL.webp", title: "Gobernanza" },
    { src: "/galeria/RECORRIDO TURISTICO DEL BARRIO EL POZÓN.webp", title: "Recorrido" }
];
---

<section id="galeria-preview" class="py-32 px-8 md:px-16 lg:px-24 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-20 gap-8">
            <div class="max-w-2xl">
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-4 uppercase block">Archivo Gráfico</span>
                <h2 class="text-4xl md:text-5xl font-display text-museum-dark mb-6">Galería de Memoria</h2>
                <p class="text-museum-dark/60 font-light leading-relaxed">
                    Momentos capturados que narran nuestra historia, desde hallazgos arqueológicos hasta encuentros comunitarios transformadores.
                </p>
            </div>
            <a href="/galeria" class="group/btn text-xs font-bold tracking-widest uppercase border-b-2 border-museum-gold pb-2 hover:text-museum-gold transition-colors inline-flex items-center gap-2">
                Explorar galería completa
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover/btn:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            {previewImages.map((image, index) => (
                <div class={`aspect-square overflow-hidden rounded-2xl group relative cursor-pointer ${index % 2 === 0 ? 'md:translate-y-4' : 'md:-translate-y-4'} transition-transform duration-1000`}>
                    <img 
                        src={image.src} 
                        alt={image.title} 
                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-museum-dark/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-4">
                        <span class="text-[8px] font-bold text-white uppercase tracking-[0.2em] text-center">{image.title}</span>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
