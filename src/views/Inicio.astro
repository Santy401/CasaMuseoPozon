---
---
<section id="inicio" class="relative min-h-screen flex items-stretch overflow-hidden bg-museum-cream">
    <!-- Mini Logo -->
    <div class="absolute bottom-8 right-8 lg:bottom-12 lg:right-12 z-40 bg-white p-3 md:p-4 rounded-2xl shadow-2xl border border-museum-gold/10">
        <img 
            src="/CLogo3.webp" 
            alt="Casa Museo Pozón Mini Logo" 
            class="w-24 md:w-32 lg:w-36 h-auto object-contain"
        />
    </div>
    
    <!-- Left Content -->
    <div class="relative z-20 w-full lg:w-1/2 flex flex-col justify-center px-8 md:px-16 lg:px-24 py-32">
        <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase">Est. 2024</span>
        <h1 class="text-7xl md:text-8xl lg:text-[10rem] font-display text-museum-dark leading-[0.85] mb-12">
            Casa Museo <br/> Pozón
        </h1>
        
        <div class="border-l border-museum-gold/60 pl-8 mb-14 max-w-lg">
            <h2 class="text-museum-dark font-display text-2xl md:text-3xl mb-3">
                Casa Museo de la Memoria Del Pozón
            </h2>
            <p class="text-museum-dark/70 italic mb-4 font-light text-lg">
                Revitalizamos, preservamos y promovemos el patrimonio cultural, histórico y biocultural del territorio pozonero.
            </p>
            <p class="text-museum-dark/60 font-light leading-relaxed text-sm md:text-base">
                Fomentando la participación comunitaria, la sostenibilidad ambiental y la fortaleza de nuestro tejido social.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-5">
            <a href="#portafolio" class="bg-museum-gold text-museum-cream px-10 py-5 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark transition-all duration-500 text-center shadow-xl shadow-museum-gold/10">
                Explorar Colección
            </a>
            <a href="#contacto" class="border border-museum-dark/30 text-museum-dark px-10 py-5 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark hover:text-white transition-all duration-500 text-center">
                Ver Horarios
            </a>
        </div>
    </div>

    <!-- Right Image Side -->
    <div class="absolute inset-y-0 right-0 w-full lg:w-1/2 h-full overflow-hidden">
        <img 
            src="/Secsion1.png" 
            alt="Interior del Museo Pozón" 
            class="w-full h-full object-cover object-center opacity-40 lg:opacity-100"
        />
        <!-- Subtle gradient to blend with the cream background -->
        <div class="absolute inset-0 bg-gradient-to-r from-museum-cream via-museum-cream/60 lg:from-museum-cream lg:via-transparent to-transparent"></div>
    </div>
</section>
