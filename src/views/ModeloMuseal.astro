---
---
<section id="modelo-museal" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-museum-cream relative overflow-hidden">
    <!-- Fondo decorativo sutil -->
    <div class="absolute top-0 right-0 w-1/3 h-full bg-museum-gold/5 -skew-x-12 transform translate-x-1/2"></div>

    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-16 items-start">
            <div class="w-full lg:w-2/5 sticky top-32">
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Estrategia Integral</span>
                <h2 class="text-4xl md:text-5xl lg:text-5xl font-display text-museum-dark mb-8 leading-tight">
                    Modelo Museal <br/> <span class="text-museum-gold">Turístico Territorial</span>
                </h2>
                <div class="w-20 h-1 bg-museum-gold mb-10"></div>
                
                <p class="text-museum-dark/80 text-lg leading-relaxed mb-8 font-light">
                    Posicionamos al barrio El Pozón como un ecosistema de <strong class="font-bold">memoria viva</strong>, aprendizaje territorial y turismo cultural comunitario.
                </p>

                <a href="/modelo-museal" class="group relative inline-flex items-center gap-6 text-museum-dark font-bold tracking-[0.2em] text-xs uppercase hover:text-museum-gold transition-colors">
                    <div class="w-14 h-14 rounded-full border border-museum-dark/20 flex items-center justify-center group-hover:border-museum-gold transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                    Ver Modelo y Operación
                </a>
            </div>

            <div class="w-full lg:w-3/5 grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Memoria Viva -->
                <div class="bg-white p-10 rounded-2xl shadow-xl shadow-museum-dark/5 hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-museum-gold/20">
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-museum-gold block">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-history"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </span>
                        <span class="text-[10px] font-bold text-museum-gold/40 tracking-widest uppercase">Pilar 01</span>
                    </div>
                    <h3 class="font-display text-2xl text-museum-dark mb-4">Memoria Viva</h3>
                    <p class="text-museum-dark/60 text-sm font-light leading-relaxed">
                        Sistematización de relatos, archivos comunitarios y dispositivos de resignificación territorial.
                    </p>
                </div>

                <!-- Educación Territorial -->
                <div class="bg-white p-10 rounded-2xl shadow-xl shadow-museum-dark/5 hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-museum-gold/20 md:mt-12">
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-museum-gold block">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.599 9.084a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.661 0l8.59-3.902Z"/><path d="M6 13v6"/><path d="M18 13v6"/><path d="M12 14v7"/></svg>
                        </span>
                        <span class="text-[10px] font-bold text-museum-gold/40 tracking-widest uppercase">Pilar 02</span>
                    </div>
                    <h3 class="font-display text-2xl text-museum-dark mb-4">Educación</h3>
                    <p class="text-museum-dark/60 text-sm font-light leading-relaxed">
                        Cátedra de Identidad Barrial y metodologías sentipensantes en nuestras aulas vivas.
                    </p>
                </div>

                <!-- Turismo Cultural -->
                <div class="bg-white p-10 rounded-2xl shadow-xl shadow-museum-dark/5 hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-museum-gold/20">
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-museum-gold block">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.617a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0l4.212 2.106Z"/><path d="M15 7.398v12.764"/><path d="M9 3.838v12.764"/></svg>
                        </span>
                        <span class="text-[10px] font-bold text-museum-gold/40 tracking-widest uppercase">Pilar 03</span>
                    </div>
                    <h3 class="font-display text-2xl text-museum-dark mb-4">Turismo Popular</h3>
                    <p class="text-museum-dark/60 text-sm font-light leading-relaxed">
                        Rutas simbólicas y mediadores comunitarios con enfoque ético y dignidad territorial.
                    </p>
                </div>

                <!-- Economía creativa Comunitaria -->
                <div class="bg-white p-10 rounded-2xl shadow-xl shadow-museum-dark/5 hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-museum-gold/20 md:mt-12">
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-museum-gold block">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scale"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                        </span>
                        <span class="text-[10px] font-bold text-museum-gold/40 tracking-widest uppercase">Pilar 04</span>
                    </div>
                    <h3 class="font-display text-2xl text-museum-dark mb-4">Economía</h3>
                    <p class="text-museum-dark/60 text-sm font-light leading-relaxed">
                        Impulso a emprendimientos creativos y productos identitarios del barrio El Pozón.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
