---
---
<section id="nodos-museales" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-4 uppercase block">Ecosistema de Memoria</span>
            <h2 class="text-4xl md:text-5xl font-display text-museum-dark mb-6">Nodos Museales</h2>
            <div class="w-24 h-1 bg-museum-gold mx-auto mb-8"></div>
            <p class="max-w-2xl mx-auto text-museum-dark/60 font-light leading-relaxed">
                Nuestros centros de activación patrimonial donde se preserva, procesa y proyecta la identidad viva de El Pozón.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Nodo 1: Cartográfico -->
            <a href="/nodos-museales#cartografico" class="group bg-museum-cream/30 p-8 rounded-3xl border border-transparent hover:border-museum-gold/30 hover:bg-white hover:shadow-2xl transition-all duration-500">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-8 shadow-sm group-hover:scale-110 transition-transform">🗺️</div>
                <h3 class="text-xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Nodo Cartográfico</h3>
                <p class="text-xs text-museum-dark/50 leading-relaxed font-light mb-6">Archivo vivo de memorias barriales, históricas y audiovisuales.</p>
                <span class="text-[10px] font-bold tracking-widest uppercase text-museum-gold opacity-0 group-hover:opacity-100 transition-opacity">Ver Más →</span>
            </a>

            <!-- Nodo 2: Memoteca -->
            <a href="/nodos-museales#memoteca" class="group bg-museum-cream/30 p-8 rounded-3xl border border-transparent hover:border-museum-gold/30 hover:bg-white hover:shadow-2xl transition-all duration-500">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-8 shadow-sm group-hover:scale-110 transition-transform">💻</div>
                <h3 class="text-xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Memoteca Digital</h3>
                <p class="text-xs text-museum-dark/50 leading-relaxed font-light mb-6">Plataforma multimedia para la democratización del conocimiento.</p>
                <span class="text-[10px] font-bold tracking-widest uppercase text-museum-gold opacity-0 group-hover:opacity-100 transition-opacity">Ver Más →</span>
            </a>

            <!-- Nodo 3: Laboratorio -->
            <a href="/nodos-museales#laboratorio" class="group bg-museum-cream/30 p-8 rounded-3xl border border-transparent hover:border-museum-gold/30 hover:bg-white hover:shadow-2xl transition-all duration-500">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-8 shadow-sm group-hover:scale-110 transition-transform">🎨</div>
                <h3 class="text-xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Laboratorio Creativo</h3>
                <p class="text-xs text-museum-dark/50 leading-relaxed font-light mb-6">Gestión patrimonial participativa a través del arte y el cuerpo.</p>
                <span class="text-[10px] font-bold tracking-widest uppercase text-museum-gold opacity-0 group-hover:opacity-100 transition-opacity">Ver Más →</span>
            </a>

            <!-- Nodo 4: Huerta -->
            <a href="/nodos-museales#huerta" class="group bg-museum-cream/30 p-8 rounded-3xl border border-transparent hover:border-museum-gold/30 hover:bg-white hover:shadow-2xl transition-all duration-500">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-8 shadow-sm group-hover:scale-110 transition-transform">🌿</div>
                <h3 class="text-xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Huerta de Memoria</h3>
                <p class="text-xs text-museum-dark/50 leading-relaxed font-light mb-6">Nodo sensorial de sanación colectiva y saberes ancestrales.</p>
                <span class="text-[10px] font-bold tracking-widest uppercase text-museum-gold opacity-0 group-hover:opacity-100 transition-opacity">Ver Más →</span>
            </a>
        </div>

        <div class="mt-20 text-center">
            <a href="/nodos-museales" class="inline-block border border-museum-dark/20 text-museum-dark px-10 py-5 rounded-full text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark hover:text-white transition-all duration-500">
                Explorar Todos los Nodos
            </a>
        </div>
    </div>
</section>
