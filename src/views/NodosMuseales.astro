---
const nodos = [
    {
        n: "01", id: "cartografico", name: "Nodo Cartográfico", href: "/nodos-museales#cartografico",
        desc: "Archivo vivo de memorias barriales, históricas y audiovisuales.",
        tone: "bg-white text-museum-dark",
        icon: '<path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>',
    },
    {
        n: "02", id: "memoteca", name: "Memoteca Digital", href: "/nodos-museales#memoteca",
        desc: "Plataforma multimedia para la democratización del conocimiento.",
        tone: "bg-museum-dark text-museum-cream",
        icon: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="m10 8 5 3-5 3z"/>',
    },
    {
        n: "03", id: "laboratorio", name: "Laboratorio Creativo", href: "/nodos-museales#laboratorio",
        desc: "Gestión patrimonial participativa a través del arte y el cuerpo.",
        tone: "bg-museum-gold text-museum-dark",
        icon: '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>',
    },
    {
        n: "04", id: "huerta", name: "Huerta de Memoria", href: "/nodos-museales#huerta",
        desc: "Nodo sensorial de sanación colectiva y saberes ancestrales.",
        tone: "bg-museum-cream text-museum-dark border border-museum-gold/30",
        icon: '<path d="M7 20h10"/><path d="M10 20c5.5-2.5 8-6.4 8-12"/><path d="M13 6.1s4.5 7 3 10"/><path d="M18 8c3.1 3 5 1 5 1"/><path d="M10 20c-5.5-2.5-8-6.4-8-12"/><path d="M7 6.1s-4.5 7-3 10"/><path d="M6 8c-3.1 3-5 1-5 1"/><path d="M12 10v10"/>',
    },
];
---
<section id="nodos-museales" class="relative bg-museum-cream px-6 md:px-16 lg:px-24 pt-24 md:pt-36 pb-24">
    <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-[5fr_7fr] gap-10 mb-14 md:mb-24 items-end">
            <div>
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-4 uppercase block">Ecosistema de Memoria</span>
                <h2 class="text-4xl md:text-6xl font-display text-museum-dark">Nodos <span class="text-museum-gold">Museales</span></h2>
            </div>
            <p class="text-museum-dark/70 font-light leading-relaxed max-w-xl">
                Nuestros centros de activación patrimonial donde se preserva, procesa y proyecta la identidad viva de El Pozón.
            </p>
        </div>

        <!-- Tarjetas apiladas: cada nodo se queda fijo y el siguiente lo cubre al hacer scroll -->
        <div data-stack class="relative">
            {nodos.map((nodo, i) => (
                <a href={nodo.href} data-stack-card class={`stack-card group sticky block rounded-[2rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_70px_-35px_rgba(26,26,26,0.5)] mb-6 md:mb-10 ${nodo.tone}`} style={`top: calc(6rem + ${i * 1.25}rem)`} aria-label={`${nodo.name}: ${nodo.desc}`}>
                    <div class="grid md:grid-cols-[1.1fr_0.9fr] min-h-[22rem] md:min-h-[26rem]">
                        <div class="p-8 md:p-14 flex flex-col justify-between gap-10">
                            <span class="font-display text-6xl md:text-8xl leading-none opacity-30 tabular-nums">{nodo.n}</span>
                            <div>
                                <h3 class="font-display text-3xl md:text-5xl mb-4 leading-tight">{nodo.name}</h3>
                                <p class="font-light leading-relaxed max-w-md opacity-80 mb-8">{nodo.desc}</p>
                                <span class="inline-flex items-center gap-3 text-[10px] font-bold tracking-[0.3em] uppercase">
                                    Ver nodo
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-2 transition-transform duration-500"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                </span>
                            </div>
                        </div>
                        <div class="relative hidden md:flex items-center justify-center overflow-hidden">
                            <div class="absolute w-[26rem] h-[26rem] rounded-full border border-current opacity-10 group-hover:scale-110 transition-transform duration-1000" aria-hidden="true"></div>
                            <div class="absolute w-[17rem] h-[17rem] rounded-full border border-current opacity-15 group-hover:scale-105 transition-transform duration-1000" aria-hidden="true"></div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" class="relative opacity-80 group-hover:scale-110 transition-transform duration-700" set:html={nodo.icon} />
                        </div>
                    </div>
                </a>
            ))}
        </div>

        <div class="mt-14 text-center">
            <a href="/nodos-museales" class="btn-magnetic inline-block border border-museum-dark/25 text-museum-dark px-10 py-5 rounded-full text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-museum-dark hover:text-museum-cream transition-colors duration-500">
                Explorar todos los nodos
            </a>
        </div>
    </div>
</section>
