---
const noticias = [
    {
        media: "Revista El Pozón",
        title: "Día Internacional de los Museos: La Memoria Viva que Late en El Pozón",
        date: "17 Mayo 2026",
        link: "/revista/dia-internacional-de-los-museos-memoria-viva",
        type: "Especial"
    },
    {
        media: "El Universal",
        title: "El Pozón inaugura su propio museo comunitario",
        date: "Julio 2024",
        link: "#",
        type: "Prensa"
    },
    {
        media: "Ministerio de Culturas",
        title: "Reconocimiento a Iniciativas de Memoria Viva",
        date: "Diciembre 2024",
        link: "#",
        type: "Galardón"
    },
    {
        media: "Caracol Radio",
        title: "La historia ancestral oculta en el barrio El Pozón",
        date: "Marzo 2025",
        link: "#",
        type: "Prensa"
    }
];
---
<section class="py-24 px-8 md:px-16 lg:px-24 bg-museum-cream border-y border-zinc-200">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-16">
        <div class="w-full lg:w-1/3">
            <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] uppercase mb-4 block">Impacto Público</span>
            <h2 class="text-3xl md:text-5xl font-display text-museum-dark mb-6">Prensa y<br/>Reconocimientos</h2>
            <p class="text-museum-dark/60 font-light text-sm mb-8">El proceso organizativo y pedagógico de la Fundación ha sido destacado en medios de comunicación y entidades gubernamentales como un modelo de gestión a seguir.</p>
            <a href="/pdfs/PORTAFOLIO INSTITUCIONAL.pdf" target="_blank" class="text-[10px] font-bold uppercase tracking-widest border-b border-museum-gold pb-1 hover:text-museum-dark transition-colors inline-block">Ver Dossier de Prensa</a>
        </div>
        
        <div class="w-full lg:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-6">
            {noticias.map(n => (
                <a href={n.link} class="bg-white p-8 rounded-2xl shadow-lg border border-zinc-100 hover:border-museum-gold/40 hover:-translate-y-1 transition-all duration-300 group">
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-[9px] text-museum-gold font-bold uppercase tracking-widest">{n.type}</span>
                        <span class="text-[9px] text-zinc-400 font-bold uppercase tracking-widest">{n.date}</span>
                    </div>
                    <h3 class="text-lg font-bold text-museum-dark mb-3 leading-snug group-hover:text-museum-gold transition-colors">{n.title}</h3>
                    <p class="text-xs text-museum-dark/50 uppercase tracking-widest">— {n.media}</p>
                </a>
            ))}
        </div>
    </div>
</section>
