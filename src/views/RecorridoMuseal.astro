---
---
<section id="recorrido-museal" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-museum-dark text-white relative overflow-hidden">
    <!-- Fondo decorativo ascendente -->
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/natural-paper.png')] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-museum-gold/10 to-transparent"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-20 items-center">
            <div class="w-full lg:w-1/2" transition:animate="slide">
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-6 uppercase block">Narrativa del Territorio</span>
                <h2 class="text-4xl md:text-6xl font-display mb-8 leading-tight">
                    Un Territorio que <br/> <span class="text-museum-gold italic">Asciende</span>
                </h2>
                <div class="w-20 h-1 bg-museum-gold mb-10"></div>
                
                <p class="text-white/60 text-lg font-light leading-relaxed mb-10 italic">
                    "Desde las huellas más antiguas inscritas en la tierra hasta la memoria viva que sostiene nuestra identidad actual."
                </p>

                <div class="flex flex-col gap-6 mb-12">
                    <div class="flex items-center gap-6 group">
                        <div class="w-10 h-10 rounded-full border border-museum-gold/30 flex items-center justify-center font-display text-museum-gold group-hover:bg-museum-gold group-hover:text-museum-dark transition-all">1</div>
                        <span class="text-xs uppercase tracking-widest font-bold opacity-70">Sala de Orígenes Arqueológicos</span>
                    </div>
                    <div class="flex items-center gap-6 group">
                        <div class="w-10 h-10 rounded-full border border-museum-gold/30 flex items-center justify-center font-display text-museum-gold group-hover:bg-museum-gold group-hover:text-museum-dark transition-all">2</div>
                        <span class="text-xs uppercase tracking-widest font-bold opacity-70">Sala de la Memoria Ancestral</span>
                    </div>
                    <div class="flex items-center gap-6 group">
                        <div class="w-10 h-10 rounded-full border border-museum-gold/30 flex items-center justify-center font-display text-museum-gold group-hover:bg-museum-gold group-hover:text-museum-dark transition-all">3</div>
                        <span class="text-xs uppercase tracking-widest font-bold opacity-70">Sala de la Vida Cotidiana</span>
                    </div>
                </div>

                <a href="/recorrido-museal" class="inline-flex items-center gap-6 bg-museum-gold text-museum-dark px-10 py-5 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase hover:bg-white transition-all duration-500 shadow-xl shadow-museum-gold/10">
                    Iniciar Recorrido Virtual
                </a>
            </div>

            <div class="w-full lg:w-1/2 relative">
                <div class="aspect-[3/4] rounded-3xl overflow-hidden shadow-2xl relative">
                    <img src="/Secsion1.png" alt="Recorrido Museal" class="w-full h-full object-cover grayscale opacity-50" />
                    <div class="absolute inset-0 bg-gradient-to-t from-museum-dark via-transparent flex flex-col justify-end p-12">
                        <p class="text-museum-gold font-display text-3xl mb-2">Sala de la Memoria Ancestral</p>
                        <p class="text-white/40 text-xs uppercase tracking-widest">Fragmento de Memoria Ancestral</p>
                    </div>
                </div>
                <!-- Elemento decorativo flotante -->
                <div class="absolute -top-10 -right-10 w-40 h-40 border border-museum-gold/20 rounded-full animate-pulse"></div>
            </div>
        </div>
    </div>
</section>
