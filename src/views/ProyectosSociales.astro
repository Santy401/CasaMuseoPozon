---
---
<section id="proyectos-sociales" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 bg-white">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-20 gap-8">
            <div class="max-w-2xl">
                <span class="text-museum-gold font-bold tracking-[0.4em] text-[10px] md:text-xs mb-4 uppercase block">Misión en Acción</span>
                <h2 class="text-4xl md:text-5xl font-display text-museum-dark mb-6">Proyectos Sociales</h2>
                <p class="text-museum-dark/60 font-light leading-relaxed">
                    Estrategias integrales que transforman el territorio a través de la educación, la comunicación, el turismo responsable y la sanación colectiva.
                </p>
            </div>
            <a href="/proyectos-sociales" class="group/btn text-xs font-bold tracking-widest uppercase border-b-2 border-museum-gold pb-2 hover:text-museum-gold transition-colors inline-flex items-center gap-2">
                Ver Impacto Social 
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover/btn:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            <!-- Proyecto 1: Semanario -->
            <div class="group relative bg-museum-cream/20 p-10 rounded-[2.5rem] overflow-hidden hover:bg-museum-dark transition-all duration-700">
                <div class="relative z-10">
                    <span class="text-museum-gold font-display text-xs tracking-widest uppercase mb-4 block group-hover:text-white/50 transition-colors">01. Comunicación</span>
                    <h3 class="text-2xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Semanario El Pozonero</h3>
                    <p class="text-sm font-light text-museum-dark/60 leading-relaxed group-hover:text-white/40 transition-colors">
                        Plataforma de difusión e identidad que dinamiza la participación ciudadana y visibiliza talentos locales.
                    </p>
                </div>
                <div class="absolute -bottom-6 -right-6 text-museum-gold opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-all duration-700">
                    <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-newspaper"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
                </div>
            </div>

            <!-- Proyecto 2: Cátedra -->
            <div class="group relative bg-museum-cream/20 p-10 rounded-[2.5rem] overflow-hidden hover:bg-museum-dark transition-all duration-700">
                <div class="relative z-10">
                    <span class="text-museum-gold font-display text-xs tracking-widest uppercase mb-4 block group-hover:text-white/50 transition-colors">02. Educación</span>
                    <h3 class="text-2xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Cátedra de Identidad</h3>
                    <p class="text-sm font-light text-museum-dark/60 leading-relaxed group-hover:text-white/40 transition-colors">
                        Programa educativo integral para la memoria viva, la paz y el fortalecimiento de las competencias ciudadanas.
                    </p>
                </div>
                <div class="absolute -bottom-6 -right-6 text-museum-gold opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-all duration-700">
                    <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.599 9.084a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.661 0l8.59-3.902Z"/><path d="M6 13v6"/><path d="M18 13v6"/><path d="M12 14v7"/></svg>
                </div>
            </div>

            <!-- Proyecto 3: Ruta Turística -->
            <div class="group relative bg-museum-cream/20 p-10 rounded-[2.5rem] overflow-hidden hover:bg-museum-dark transition-all duration-700">
                <div class="relative z-10">
                    <span class="text-museum-gold font-display text-xs tracking-widest uppercase mb-4 block group-hover:text-white/50 transition-colors">03. Turismo</span>
                    <h3 class="text-2xl font-display text-museum-dark mb-4 group-hover:text-museum-gold transition-colors">Ruta El Pozón</h3>
                    <p class="text-sm font-light text-museum-dark/60 leading-relaxed group-hover:text-white/40 transition-colors">
                        Experiencia que dignifica el patrimonio arqueológico y ancestral mediante la inclusión y el desarrollo sostenible.
                    </p>
                </div>
                <div class="absolute -bottom-6 -right-6 text-museum-gold opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-all duration-700">
                    <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.617a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0l4.212 2.106Z"/><path d="M15 7.398v12.764"/><path d="M9 3.838v12.764"/></svg>
                </div>
            </div>
        </div>
    </div>
</section>
